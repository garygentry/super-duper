# Normalize text to LF in the repository regardless of each machine's core.autocrlf.
* text=auto

# Windows tooling that must keep CRLF in the working tree.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sln text eol=crlf

# Explicit binaries, so no end-of-line conversion is ever attempted.
*.png binary
*.ico binary
*.lnk binary
*.db binary
