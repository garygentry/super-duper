# Normalize text to LF in the repository regardless of each machine's core.autocrlf.
* text=auto

# Windows tooling that must keep CRLF in the working tree.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sln text eol=crlf

# Generated by cbindgen with LF endings on every build; checking it out as CRLF (core.autocrlf)
# would make each build rewrite it and leave the tree looking dirty.
crates/super-duper-ffi/super_duper.h text eol=lf

# Explicit binaries, so no end-of-line conversion is ever attempted.
*.png binary
*.ico binary
*.lnk binary
*.db binary
