<Window x:Class="SuperDuper.Windows.MainWindow"
        x:Name="ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SuperDuper.Windows.Views"
        xmlns:vm="clr-namespace:SuperDuper.Windows.Core.ViewModels;assembly=SuperDuper.Windows.Core"
        mc:Ignorable="d"
        Title="Super Duper"
        FontSize="{DynamicResource ShellBodyFontSize}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Icon="Assets/AppIcon/SuperDuper.ico"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="WorkspaceTabs" TargetType="TabControl" BasedOn="{StaticResource DefaultTabControlStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TabPanel IsItemsHost="True" Margin="16,0,16,0" KeyboardNavigation.TabIndex="1" />
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent"
                                              Margin="0" KeyboardNavigation.TabIndex="2" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl" BasedOn="{StaticResource WorkspaceTabs}" />
        <Style x:Key="ShellNavigationItem" TargetType="TabItem" BasedOn="{StaticResource DefaultTabItemStyle}">
            <Setter Property="FontSize" Value="{DynamicResource ShellBodyFontSize}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Selection" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                Background="Transparent">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Selection" Property="BorderThickness" Value="1" />
                                <Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSetupDeparture}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Width="220" Visibility="{Binding IsSavedScanPaneOpen, ElementName=ShellWindow, Converter={StaticResource BooleanToVisibilityConverter}}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <views:SessionListView DataContext="{Binding Sessions}" />
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="{StaticResource ShellContentInset}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton Margin="0,0,16,0" MinHeight="32" VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="SavedScanSelectorToggle"
                                      AutomationProperties.Name="Show saved scans" ToolTip="Show or hide saved scans"
                                      IsChecked="{Binding IsSavedScanPaneOpen, ElementName=ShellWindow, Mode=TwoWay}"
                                      Content="Saved scans" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding WorkspaceSessionName}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding WorkspaceSessionName}" />
                            <TextBlock AutomationProperties.AutomationId="SelectedScanContext"
                                       Margin="0,4,12,0" Style="{StaticResource ShellBody}" Text="{Binding SelectedScanContext}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedScanContext}" />
                            <TextBlock Style="{StaticResource ShellBody}" Text="Loading saved scan…"
                                       Visibility="{Binding IsLoadingSession, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button
                                    x:Name="StartScanButton"
                                    AutomationProperties.AutomationId="StartScanButton"
                                    MinWidth="112"
                                    Style="{StaticResource ShellPrimaryAction}"
                                    Command="{Binding StartRunCommand}"
                                    ToolTip="{Binding StartRunLabel}"
                                    ToolTipService.ShowOnDisabled="True"
                                    AutomationProperties.Name="{Binding StartRunLabel}"
                                    VerticalAlignment="Center"
                                    MaxWidth="200">
                                <TextBlock Text="{Binding PrimaryScanActionText}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                    <Border Style="{StaticResource ShellStatusBanner}" Margin="12,4"
                            Visibility="{Binding ShowActiveScanBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="12,0,0,0" Style="{StaticResource ShellAction}"
                                    AutomationProperties.AutomationId="ViewActiveProgress"
                                    AutomationProperties.Name="View active scan progress"
                                    Content="View progress" Command="{Binding ViewProgressCommand}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource ShellBody}" TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ActiveScanName}">
                                    <Run Text="Active scan: " /><Run Text="{Binding ActiveScanName, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource ShellBody}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                                    <Run Text="{Binding Progress.Phase, Mode=OneWay}" />
                                    <Run Text=" · " /><Run Text="{Binding Progress.Elapsed, Mode=OneWay}" />
                                    <Run Text=" · Warnings: " /><Run Text="{Binding Progress.WarningCount, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource ShellStatusBanner}" Margin="12,4"
                            Visibility="{Binding HasCompletedScanNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Dismiss" Margin="8,0,0,0"
                                    Command="{Binding DismissCompletedScanCommand}" />
                            <Button DockPanel.Dock="Right" Content="View results" Margin="8,0,0,0"
                                    Command="{Binding OpenCompletedScanCommand}" />
                            <TextBlock Text="{Binding CompletedScanNoticeText}" VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite" />
                        </DockPanel>
                    </Border>
                    </StackPanel>
                    <views:EmptyStateView Grid.Row="1" Visibility="{Binding IsEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <TabControl x:Name="MainTabs" Grid.Row="1"
                                AutomationProperties.AutomationId="MainTabs"
                                AutomationProperties.Name="Workspace areas"
                                ItemContainerStyle="{StaticResource ShellNavigationItem}"
                                SelectedValuePath="Tag" SelectedValue="{Binding SelectedArea, Mode=TwoWay}"
                                Visibility="{Binding IsWorkspaceVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TabItem Header="_Scan" Tag="{x:Static vm:WorkspaceArea.Scan}">
                            <TabControl ItemContainerStyle="{StaticResource ShellNavigationItem}" x:Name="ScanTabs" AutomationProperties.AutomationId="ScanNavigation"
                                        AutomationProperties.Name="Scan views" SelectedValuePath="Tag"
                                        SelectedValue="{Binding ScanDestination, Mode=TwoWay}">
                                <TabItem AutomationProperties.AutomationId="SetupTab" Header="_Setup" Tag="{x:Static vm:WorkspaceDestination.ScanSetup}">
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSetupAvailable}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <views:SessionSetupView DataContext="{Binding Setup}" />
                                    </Grid>
                                </TabItem>
                                <TabItem AutomationProperties.AutomationId="ProgressTab" Header="_Progress" Tag="{x:Static vm:WorkspaceDestination.ScanProgress}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Margin="24,8" Style="{StaticResource ShellBody}"
                                                    AutomationProperties.AutomationId="ProgressScanContext" Text="{Binding ProgressScanContext}" />
                                        <views:ScanProgressView x:Name="ProgressWorkspace" DataContext="{Binding Progress}" />
                                    </DockPanel>
                                </TabItem>
                                <TabItem Header="Su_mmary" Tag="{x:Static vm:WorkspaceDestination.ScanSummary}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Margin="24,8" Style="{StaticResource ShellBody}"
                                                    Text="{Binding SelectedScanContext}" />
                                        <views:ScanProgressView x:Name="SummaryWorkspace" DataContext="{Binding Summary}" />
                                    </DockPanel>
                                </TabItem>
                            </TabControl>
                        </TabItem>
                        <TabItem Header="_Results" Tag="{x:Static vm:WorkspaceArea.Results}">
                            <TabControl ItemContainerStyle="{StaticResource ShellNavigationItem}" x:Name="ResultsTabs" AutomationProperties.AutomationId="ResultsNavigation"
                                        AutomationProperties.Name="Results views" SelectedValuePath="Tag"
                                        SelectedValue="{Binding ResultsDestination, Mode=TwoWay}">
                                <TabItem AutomationProperties.AutomationId="DuplicateFilesTab" Header="_Files" Tag="{x:Static vm:WorkspaceDestination.FileResults}">
                                    <views:DuplicateFilesView x:Name="DuplicateFilesWorkspace" DataContext="{Binding DuplicateFiles}" />
                                </TabItem>
                                <TabItem AutomationProperties.AutomationId="DuplicateFoldersTab" Header="F_olders" Tag="{x:Static vm:WorkspaceDestination.FolderResults}">
                                    <views:DuplicateFoldersView x:Name="DuplicateFoldersWorkspace" DataContext="{Binding DuplicateFolders}" />
                                </TabItem>
                            </TabControl>
                        </TabItem>
                        <TabItem AutomationProperties.AutomationId="PreflightTab" Header="_Review" Tag="{x:Static vm:WorkspaceArea.Review}">
                            <views:PreflightView DataContext="{Binding Preflight}" />
                        </TabItem>
                        <TabItem Header="_History" Tag="{x:Static vm:WorkspaceArea.History}">
                            <TabControl ItemContainerStyle="{StaticResource ShellNavigationItem}" AutomationProperties.AutomationId="HistoryNavigation" SelectedValuePath="Tag"
                                        SelectedValue="{Binding HistoryDestination, Mode=TwoWay}">
                                <TabItem AutomationProperties.AutomationId="RunHistoryTab" Header="_Scans" Tag="{x:Static vm:WorkspaceDestination.History}">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="24,8">
                                            <Button DockPanel.Dock="Right" Margin="12,0,0,0" Style="{StaticResource ShellPrimaryAction}"
                                                        AutomationProperties.AutomationId="OpenScan" AutomationProperties.Name="Open highlighted scan in the workspace"
                                                        Command="{Binding OpenScanCommand}">
                                                <AccessText Text="_Open scan" />
                                            </Button>
                                            <TextBlock VerticalAlignment="Center" Style="{StaticResource ShellBody}" Text="{Binding HistoryContext}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding HistoryContext}" />
                                        </DockPanel>
                                        <views:RunHistoryView x:Name="HistoryWorkspace" DataContext="{Binding History}" />
                                    </DockPanel>
                                </TabItem>
                                <TabItem AutomationProperties.AutomationId="PerformanceTab" Header="_Performance" Tag="{x:Static vm:WorkspaceDestination.Performance}">
                                    <views:PerformanceView x:Name="PerformanceWorkspace" DataContext="{Binding Performance}" />
                                </TabItem>
                            </TabControl>
                        </TabItem>
                    </TabControl>


                    <views:ErrorStateView Grid.Row="1" Panel.ZIndex="10"
                                          Visibility="{Binding HasContentError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Grid>
        </Grid>

        <Grid Margin="32"
              Visibility="{Binding IsStarting, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Width="540" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource ShellTitle}" Text="{Binding StatusTitle}" />
                <TextBlock Margin="0,9,0,20"
                           HorizontalAlignment="Center"
                           Style="{StaticResource ShellBody}"
                           Text="{Binding StatusDetail}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <ProgressBar Height="5" IsIndeterminate="True" />
            </StackPanel>
        </Grid>

        <ScrollViewer Margin="24" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
              Visibility="{Binding IsRecoveryScreenVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border MaxWidth="680"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource ShellStatusBanner}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ShellTitle}" Text="{Binding StatusTitle}" />
                    <TextBlock Margin="0,10,0,0" Text="{Binding StatusDetail}" TextWrapping="Wrap" />
                    <Expander Header="Technical details" AutomationProperties.AutomationId="ConnectionRecoveryDetails" Margin="0,16,0,0">
                    <StackPanel>
                    <TextBlock Margin="0,8,0,5" FontWeight="SemiBold" Text="Worker executable" />
                    <TextBox IsReadOnly="True" Text="{Binding WorkerExecutablePath, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,12,0,0"
                               Style="{StaticResource ShellBody}"
                               Text="Correct the executable, database, or permissions issue if needed, then restart the worker in place."
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,18,0,5" FontWeight="SemiBold" Text="Diagnostic log" />
                    <TextBox IsReadOnly="True" Text="{Binding DiagnosticLogPath, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    </Expander>
                    <Button Margin="0,22,0,0"
                            AutomationProperties.AutomationId="RestartWorkerButton"
                            AutomationProperties.Name="Restart worker and recover"
                            HorizontalAlignment="Left"
                            MinWidth="140"
                            Style="{StaticResource ShellAction}"
                            Command="{Binding RestartWorkerCommand}"
                            Content="Reconnect" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <StatusBar Grid.Row="1" Visibility="{Binding IsRecoveryScreenVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StatusBarItem><TextBlock Text="Scan engine:" /></StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusTitle}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock MaxWidth="760" Text="{Binding StatusDetail}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>
        <Border Grid.RowSpan="2" Panel.ZIndex="10" MaxWidth="520" Padding="24" HorizontalAlignment="Center"
                KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
                VerticalAlignment="Center" Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="2"
                Visibility="{Binding HasSetupDeparture, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Save setup changes before leaving?" TextWrapping="Wrap" />
                <TextBlock Margin="0,8" Text="Save keeps your edits. Discard restores the saved setup. Stay returns to editing. Earlier scan results are unchanged." TextWrapping="Wrap" />
                <TextBlock Text="{Binding Setup.OperationError}" TextWrapping="Wrap" />
                <WrapPanel>
                    <Button Margin="0,0,8,8" Content="Save" Command="{Binding SaveSetupAndContinueCommand}" />
                    <Button Margin="0,0,8,8" Content="Discard" Command="{Binding DiscardSetupAndContinueCommand}" />
                    <Button x:Name="StayInSetupButton" AutomationProperties.AutomationId="StayInSetup" Margin="0,0,8,8" Content="Stay" Command="{Binding StayInSetupCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
