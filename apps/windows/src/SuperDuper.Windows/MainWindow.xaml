<Window x:Class="SuperDuper.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SuperDuper.Windows.Views"
        xmlns:vm="clr-namespace:SuperDuper.Windows.Core.ViewModels;assembly=SuperDuper.Windows.Core"
        mc:Ignorable="d"
        Title="Super Duper"
        FontSize="14"
        Icon="Assets/AppIcon/SuperDuper.ico"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="0,0,1,0">
                <views:SessionListView DataContext="{Binding Sessions}" />
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="{StaticResource ShellContentInset}"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource ShellTitle}" Text="{Binding WorkspaceSessionName}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding WorkspaceSessionName}" />
                            <TextBlock AutomationProperties.AutomationId="SelectedScanContext"
                                       Margin="0,4,12,0" Style="{StaticResource ShellBody}" Text="{Binding SelectedScanContext}" />
                            <TextBlock Style="{StaticResource ShellBody}" Text="Loading saved scan…"
                                       Visibility="{Binding IsLoadingSession, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                x:Name="StartScanButton"
                                AutomationProperties.AutomationId="StartScanButton"
                                MinWidth="112"
                                Style="{StaticResource ShellPrimaryAction}"
                                Command="{Binding StartRunCommand}"
                                ToolTip="{Binding StartRunLabel}"
                                ToolTipService.ShowOnDisabled="True"
                                AutomationProperties.Name="{Binding StartRunLabel}"
                                VerticalAlignment="Center"
                                MaxWidth="200">
                            <TextBlock Text="{Binding StartRunLabel}" TextTrimming="CharacterEllipsis" />
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource ShellStatusBanner}" Margin="12,8"
                            Visibility="{Binding HasActiveRun, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="12,0,0,0" Style="{StaticResource ShellAction}"
                                    AutomationProperties.AutomationId="ViewActiveProgress"
                                    AutomationProperties.Name="View active scan progress"
                                    Content="View progress" Command="{Binding ViewProgressCommand}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource ShellBody}" TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ActiveScanName}">
                                    <Run Text="Active scan: " /><Run Text="{Binding ActiveScanName, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource ShellBody}">
                                    <Run Text="{Binding Progress.Phase, Mode=OneWay}" />
                                    <Run Text=" · " /><Run Text="{Binding Progress.Elapsed, Mode=OneWay}" />
                                    <Run Text=" · Warnings: " /><Run Text="{Binding Progress.WarningCount, Mode=OneWay}" />
                                    <Run Text=" · Another scan cannot start yet." />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <views:EmptyStateView Grid.Row="1" Visibility="{Binding IsEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <TabControl x:Name="MainTabs" Grid.Row="1"
                                AutomationProperties.AutomationId="MainTabs"
                                AutomationProperties.Name="Workspace areas"
                                ItemContainerStyle="{StaticResource ShellNavigationItem}"
                                SelectedValuePath="Tag" SelectedValue="{Binding SelectedArea, Mode=TwoWay}"
                                Visibility="{Binding IsWorkspaceVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TabItem Header="_Scan" Tag="{x:Static vm:WorkspaceArea.Scan}">
                            <TabControl ItemContainerStyle="{StaticResource ShellNavigationItem}" x:Name="ScanTabs" AutomationProperties.AutomationId="ScanNavigation"
                                        AutomationProperties.Name="Scan views" SelectedValuePath="Tag"
                                        SelectedValue="{Binding ScanDestination, Mode=TwoWay}">
                                <TabItem AutomationProperties.AutomationId="SetupTab" Header="_Setup" Tag="{x:Static vm:WorkspaceDestination.ScanSetup}">
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSetupAvailable}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <views:SessionSetupView DataContext="{Binding Setup}" />
                                    </Grid>
                                </TabItem>
                                <TabItem AutomationProperties.AutomationId="ProgressTab" Header="_Progress" Tag="{x:Static vm:WorkspaceDestination.ScanProgress}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Margin="24,8" Style="{StaticResource ShellBody}"
                                                    AutomationProperties.AutomationId="ProgressScanContext" Text="{Binding ProgressScanContext}" />
                                        <views:ScanProgressView DataContext="{Binding Progress}" />
                                    </DockPanel>
                                </TabItem>
                                <TabItem Header="Su_mmary" Tag="{x:Static vm:WorkspaceDestination.ScanSummary}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Margin="24,8" Style="{StaticResource ShellBody}"
                                                    Text="{Binding SelectedScanContext}" />
                                        <views:ScanProgressView DataContext="{Binding Summary}" />
                                    </DockPanel>
                                </TabItem>
                            </TabControl>
                        </TabItem>
                        <TabItem Header="_Results" Tag="{x:Static vm:WorkspaceArea.Results}">
                            <TabControl ItemContainerStyle="{StaticResource ShellNavigationItem}" x:Name="ResultsTabs" AutomationProperties.AutomationId="ResultsNavigation"
                                        AutomationProperties.Name="Results views" SelectedValuePath="Tag"
                                        SelectedValue="{Binding ResultsDestination, Mode=TwoWay}">
                                <TabItem AutomationProperties.AutomationId="DuplicateFilesTab" Header="_Files" Tag="{x:Static vm:WorkspaceDestination.FileResults}">
                                    <views:DuplicateFilesView x:Name="DuplicateFilesWorkspace" DataContext="{Binding DuplicateFiles}" />
                                </TabItem>
                                <TabItem AutomationProperties.AutomationId="DuplicateFoldersTab" Header="F_olders" Tag="{x:Static vm:WorkspaceDestination.FolderResults}">
                                    <views:DuplicateFoldersView DataContext="{Binding DuplicateFolders}" />
                                </TabItem>
                            </TabControl>
                        </TabItem>
                        <TabItem AutomationProperties.AutomationId="PreflightTab" Header="_Review" Tag="{x:Static vm:WorkspaceArea.Review}">
                            <views:PreflightView DataContext="{Binding Preflight}" />
                        </TabItem>
                        <TabItem Header="_History" Tag="{x:Static vm:WorkspaceArea.History}">
                            <TabControl ItemContainerStyle="{StaticResource ShellNavigationItem}" AutomationProperties.AutomationId="HistoryNavigation" SelectedValuePath="Tag"
                                        SelectedValue="{Binding HistoryDestination, Mode=TwoWay}">
                                <TabItem AutomationProperties.AutomationId="RunHistoryTab" Header="_Scans" Tag="{x:Static vm:WorkspaceDestination.History}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Top" Margin="24,8">
                                            <TextBlock Style="{StaticResource ShellBody}" Text="{Binding HistoryContext}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding HistoryContext}" />
                                            <Button Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource ShellPrimaryAction}"
                                                        AutomationProperties.AutomationId="OpenScan" AutomationProperties.Name="Open highlighted scan in the workspace"
                                                        Content="_Open scan" Command="{Binding OpenScanCommand}" />
                                        </StackPanel>
                                        <views:RunHistoryView DataContext="{Binding History}" />
                                    </DockPanel>
                                </TabItem>
                                <TabItem AutomationProperties.AutomationId="PerformanceTab" Header="_Performance" Tag="{x:Static vm:WorkspaceDestination.Performance}">
                                    <views:PerformanceView x:Name="PerformanceWorkspace" DataContext="{Binding Performance}" />
                                </TabItem>
                            </TabControl>
                        </TabItem>
                    </TabControl>


                    <views:ErrorStateView Grid.Row="1" Panel.ZIndex="10"
                                          Visibility="{Binding HasContentError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Grid>
        </Grid>

        <Grid Margin="32"
              Visibility="{Binding IsStarting, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Width="540" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource ShellTitle}" Text="{Binding StatusTitle}" />
                <TextBlock Margin="0,9,0,20"
                           HorizontalAlignment="Center"
                           Style="{StaticResource ShellBody}"
                           Text="{Binding StatusDetail}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <ProgressBar Height="5" IsIndeterminate="True" />
            </StackPanel>
        </Grid>

        <Grid Margin="32"
              Visibility="{Binding IsRecoveryScreenVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="680"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource ShellStatusBanner}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ShellTitle}" Text="{Binding StatusTitle}" />
                    <TextBlock Margin="0,10,0,0" Text="{Binding StatusDetail}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,20,0,5" FontWeight="SemiBold" Text="Worker executable" />
                    <TextBox IsReadOnly="True" Text="{Binding WorkerExecutablePath, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,12,0,0"
                               Style="{StaticResource ShellBody}"
                               Text="Correct the executable, database, or permissions issue if needed, then restart the worker in place."
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,18,0,5" FontWeight="SemiBold" Text="Diagnostic log" />
                    <TextBox IsReadOnly="True" Text="{Binding DiagnosticLogPath, Mode=OneWay}" TextWrapping="Wrap" />
                    <Button Margin="0,22,0,0"
                            AutomationProperties.AutomationId="RestartWorkerButton"
                            AutomationProperties.Name="Restart worker and recover"
                            HorizontalAlignment="Left"
                            MinWidth="140"
                            Style="{StaticResource ShellAction}"
                            Command="{Binding RestartWorkerCommand}"
                            Content="Restart worker" />
                </StackPanel>
            </Border>
        </Grid>

        <StatusBar Grid.Row="1">
            <StatusBarItem><TextBlock Text="Scan engine:" /></StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusTitle}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock MaxWidth="760" Text="{Binding StatusDetail}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
