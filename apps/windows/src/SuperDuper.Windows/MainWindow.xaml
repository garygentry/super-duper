<Window x:Class="SuperDuper.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SuperDuper.Windows.Views"
        mc:Ignorable="d"
        Title="Super Duper"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="0,0,1,0">
                <views:SessionListView DataContext="{Binding Sessions}" />
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="24,16"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding DisplaySessionName}" />
                            <TextBlock Margin="0,3,0,0" Opacity="0.65" Text="Find exact duplicate files with a durable scan history." />
                        </StackPanel>
                        <Button Grid.Column="1"
                                MinWidth="112"
                                Padding="16,8"
                                Command="{Binding StartRunCommand}"
                                Content="Start scan" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <views:EmptyStateView Visibility="{Binding IsEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                                Visibility="{Binding IsWorkspaceVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TabItem Header="Setup">
                            <views:SessionSetupView DataContext="{Binding Setup}" />
                        </TabItem>
                        <TabItem Header="Progress">
                            <views:ScanProgressView DataContext="{Binding Progress}" />
                        </TabItem>
                        <TabItem Header="Run history">
                            <views:RunHistoryView DataContext="{Binding History}" />
                        </TabItem>
                        <TabItem Header="Duplicate files">
                            <views:DuplicateFilesView DataContext="{Binding DuplicateFiles}" />
                        </TabItem>
                        <TabItem Header="Duplicate folders">
                            <views:DuplicateFoldersView DataContext="{Binding DuplicateFolders}" />
                        </TabItem>
                    </TabControl>

                    <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                            Opacity="0.9"
                            Visibility="{Binding IsLoadingSession, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar Width="160" Height="5" IsIndeterminate="True" />
                            <TextBlock Margin="0,10,0,0" Opacity="0.7" Text="Loading session…" />
                        </StackPanel>
                    </Border>

                    <views:ErrorStateView Panel.ZIndex="10"
                                          Visibility="{Binding HasContentError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Grid>
        </Grid>

        <Grid Margin="32"
              Visibility="{Binding IsStarting, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Width="540" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center" FontSize="28" FontWeight="SemiBold" Text="{Binding StatusTitle}" />
                <TextBlock Margin="0,9,0,20"
                           HorizontalAlignment="Center"
                           Opacity="0.7"
                           Text="{Binding StatusDetail}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <ProgressBar Height="5" IsIndeterminate="True" />
            </StackPanel>
        </Grid>

        <Grid Margin="32"
              Visibility="{Binding IsFailed, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="680"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="#C84B31"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="25" FontWeight="SemiBold" Text="{Binding StatusTitle}" />
                    <TextBlock Margin="0,10,0,0" Text="{Binding StatusDetail}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,20,0,5" FontWeight="SemiBold" Text="Worker executable" />
                    <TextBox IsReadOnly="True" Text="{Binding WorkerExecutablePath, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,12,0,0"
                               Opacity="0.7"
                               Text="Build the Rust workspace, then restart Super Duper. Set SUPER_DUPER_WORKER_PATH to override this location."
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <StatusBar Grid.Row="1">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusTitle}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock MaxWidth="760" Text="{Binding StatusDetail}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
