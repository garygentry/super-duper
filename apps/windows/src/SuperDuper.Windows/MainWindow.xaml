<Window x:Class="SuperDuper.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Super Duper"
        Width="920"
        Height="580"
        MinWidth="720"
        MinHeight="460"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="30" FontWeight="SemiBold" Text="Super Duper" />
            <TextBlock Margin="0,6,0,0"
                       FontSize="15"
                       Opacity="0.72"
                       Text="Find duplicate files without losing control of your data." />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,28,0,28"
                Padding="28"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <StackPanel Visibility="{Binding IsStarting, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding StatusTitle}" />
                    <TextBlock Margin="0,10,0,20"
                               FontSize="14"
                               Opacity="0.72"
                               Text="{Binding StatusDetail}"
                               TextWrapping="Wrap" />
                    <ProgressBar Height="4" IsIndeterminate="True" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding StatusTitle}" />
                    <TextBlock Margin="0,10,0,0"
                               FontSize="14"
                               Opacity="0.72"
                               Text="{Binding StatusDetail}"
                               TextWrapping="Wrap" />
                    <Border Margin="0,24,0,0" Padding="16" CornerRadius="6">
                        <TextBlock Text="The Windows shell and Rust engine completed their protocol health handshake. Session setup arrives in Milestone 1."
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <StackPanel Visibility="{Binding IsFailed, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding StatusTitle}" />
                    <TextBlock Margin="0,10,0,0"
                               FontSize="14"
                               Text="{Binding StatusDetail}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,20,0,4" FontWeight="SemiBold" Text="Worker executable" />
                    <TextBox IsReadOnly="True"
                             Text="{Binding WorkerExecutablePath, Mode=OneWay}"
                             TextWrapping="Wrap" />
                    <TextBlock Margin="0,12,0,0"
                               Opacity="0.72"
                               Text="Build the Rust workspace, then restart Super Duper. Set SUPER_DUPER_WORKER_PATH to override this location."
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusTitle}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
