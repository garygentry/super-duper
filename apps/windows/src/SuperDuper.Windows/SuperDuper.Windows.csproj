<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup>
    <WorkerCargoProfile Condition="'$(Configuration)' == 'Release'">release</WorkerCargoProfile>
    <WorkerCargoProfile Condition="'$(WorkerCargoProfile)' == ''">debug</WorkerCargoProfile>
    <WorkerExecutableSource>$(MSBuildProjectDirectory)\..\..\..\..\target\$(WorkerCargoProfile)\super-duper-worker.exe</WorkerExecutableSource>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.13" />
    <ProjectReference Include="..\SuperDuper.Windows.Core\SuperDuper.Windows.Core.csproj" />
    <ProjectReference Include="..\SuperDuper.Windows.Infrastructure\SuperDuper.Windows.Infrastructure.csproj" />
  </ItemGroup>

  <Target Name="CopyWorkerExecutable" AfterTargets="Build" Condition="Exists('$(WorkerExecutableSource)')">
    <Copy SourceFiles="$(WorkerExecutableSource)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyWorkerExecutableToPublishDirectory" AfterTargets="Publish" Condition="Exists('$(WorkerExecutableSource)')">
    <Copy SourceFiles="$(WorkerExecutableSource)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
