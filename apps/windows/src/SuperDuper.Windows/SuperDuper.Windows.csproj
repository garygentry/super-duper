<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon\SuperDuper.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <WorkerCargoProfile Condition="'$(Configuration)' == 'Release'">release</WorkerCargoProfile>
    <WorkerCargoProfile Condition="'$(WorkerCargoProfile)' == ''">debug</WorkerCargoProfile>
    <WorkerExecutableSource>$(MSBuildProjectDirectory)\..\..\..\..\target\$(WorkerCargoProfile)\super-duper-worker.exe</WorkerExecutableSource>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon\SuperDuper.ico" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <ProjectReference Include="..\SuperDuper.Windows.Core\SuperDuper.Windows.Core.csproj" />
    <ProjectReference Include="..\SuperDuper.Windows.Infrastructure\SuperDuper.Windows.Infrastructure.csproj" />
  </ItemGroup>

  <Target Name="CopyWorkerExecutable" AfterTargets="Build" Condition="Exists('$(WorkerExecutableSource)')">
    <Copy SourceFiles="$(WorkerExecutableSource)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyWorkerExecutableToPublishDirectory" AfterTargets="Publish" Condition="Exists('$(WorkerExecutableSource)')">
    <Copy SourceFiles="$(WorkerExecutableSource)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- A missing worker used to be silent: Debug ran whatever worker was already beside the app
       (stale or absent), and Release only failed later, in the release verifier's artifact check. -->
  <Target Name="CheckWorkerExecutable" AfterTargets="Build" Condition="!Exists('$(WorkerExecutableSource)')">
    <Warning Condition="'$(Configuration)' != 'Release'"
             Text="super-duper-worker.exe not found at $(WorkerExecutableSource); build it first (cargo build --workspace) or the app will run a stale or missing worker." />
    <Error Condition="'$(Configuration)' == 'Release'"
           Text="super-duper-worker.exe not found at $(WorkerExecutableSource); a Release build requires it (cargo build --workspace --release)." />
  </Target>

  <Target Name="CheckWorkerExecutableForPublish" AfterTargets="Publish" Condition="!Exists('$(WorkerExecutableSource)')">
    <Error Text="super-duper-worker.exe not found at $(WorkerExecutableSource); publish requires it (cargo build --workspace --release)." />
  </Target>

</Project>
