                     accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding GroupErrorAnnouncementVersion}"
                     accessibility:AutomationNotificationBehavior.NotificationKind="ActionAborted"
                     accessibility:AutomationNotificationBehavior.NotificationProcessing="ImportantMostRecent"
                     accessibility:AutomationNotificationBehavior.ActivityId="DuplicateFileGroupQuery"
                     BorderBrush="{DynamicResource TextFillColorPrimaryBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock MaxWidth="620" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>
             <StackPanel HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         automation:AutomationProperties.AutomationId="FileUnavailableState"
                         automation:AutomationProperties.LiveSetting="Polite"
                         automation:AutomationProperties.Name="{Binding StateMessage, StringFormat='Results unavailable: {0}'}"
                         Visibility="{Binding IsUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource PageTitle}" Text="Results unavailable" />
                <TextBlock Margin="0,6,0,0" MaxWidth="560" Text="{Binding StateMessage}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
             <StackPanel HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         automation:AutomationProperties.AutomationId="FileEmptyState"
                         automation:AutomationProperties.LiveSetting="Polite"
                         automation:AutomationProperties.Name="{Binding StateMessage, StringFormat='No duplicate files: {0}'}"
                         Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource PageTitle}" Text="No duplicate files" />
                <TextBlock Margin="0,6,0,0" Text="{Binding StateMessage}" />
            </StackPanel>
        </Grid>

        <GridSplitter x:Name="ComparisonSplitter"
                      Grid.Column="1"
                      Width="4"
                      Margin="4,0"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns"
                      ShowsPreview="True"
                      KeyboardNavigation.TabIndex="445"
                      automation:AutomationProperties.AutomationId="FileComparisonSplitter"
                      automation:AutomationProperties.Name="Resize duplicate set list and copy comparison" />

        <Grid x:Name="DetailPane"
