                    <ProgressBar Width="150" Height="4" IsIndeterminate="True" />
                    <TextBlock Margin="0,9,0,0" Text="Loading duplicate groups…" />
                </StackPanel>
            </Border>
             <Border x:Name="GroupErrorStatus"
