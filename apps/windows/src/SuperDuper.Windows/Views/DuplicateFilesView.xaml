                                            automation:AutomationProperties.Name="{Binding Path, StringFormat='Show {0} in Explorer'}"
                                            Command="{Binding DataContext.RevealInExplorerCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Show in Explorer">
                                        <Path Data="{StaticResource ShellIconOpenLocation}" Style="{StaticResource ShellActionIcon}" />
                                    </Button>
                                </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
