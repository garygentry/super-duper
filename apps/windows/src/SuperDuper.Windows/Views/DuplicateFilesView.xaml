                    <Button Margin="8,0,0,0"
                            Style="{StaticResource ShellIconAction}"
                            KeyboardNavigation.TabIndex="440"
                            automation:AutomationProperties.AutomationId="FileNextGroupPage"
                            automation:AutomationProperties.Name="Next duplicate group page"
                            Command="{Binding NextPageCommand}"
                            ToolTip="Next sets">
                        <Path Data="{StaticResource ShellIconChevronRight}" Style="{StaticResource ShellActionIcon}" />
                    </Button>

                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource ApplicationBackgroundBrush}"
