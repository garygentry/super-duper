                                       automation:AutomationProperties.Name="{Binding SelectedGroup.LocationSpan, StringFormat='Selected duplicate set location span: {0}'}"
                                       Text="{Binding SelectedGroup.LocationSpan}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,3,0,0"
                                       automation:AutomationProperties.AutomationId="FileReviewPlanSummary"
                                       automation:AutomationProperties.LiveSetting="Polite"
                                       automation:AutomationProperties.Name="{Binding ReviewPlanSummaryText}"
                                       Text="{Binding ReviewPlanSummaryText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
