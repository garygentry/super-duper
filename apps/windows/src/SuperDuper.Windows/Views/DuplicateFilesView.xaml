<UserControl x:Class="SuperDuper.Windows.Views.DuplicateFilesView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="Duplicate files" />
                <TextBlock Margin="0,4,0,0"
                           Opacity="0.68"
                           Text="Results belong to the selected historical run and stay server-paged." />
            </StackPanel>
            <TextBox x:Name="FileSearch"
                     Grid.Column="1"
                     Margin="12,0,0,0"
                     VerticalContentAlignment="Center"
                     automation:AutomationProperties.Name="Path search"
                     automation:AutomationProperties.AutomationId="FileSearch"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Search duplicate file paths" />
            <TextBox x:Name="FileMinimumSize"
                     Grid.Column="2"
                     Width="145"
                     Margin="8,0,0,0"
                     VerticalContentAlignment="Center"
                     automation:AutomationProperties.Name="Minimum file size in bytes"
                     automation:AutomationProperties.AutomationId="FileMinimumSize"
                     Text="{Binding MinimumSizeText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Minimum file size in bytes" />
            <Button x:Name="FileApplyFilters"
                    Grid.Column="3"
                    automation:AutomationProperties.AutomationId="FileApplyFilters"
                    Margin="8,0,0,0"
                    Padding="13,7"
                    Command="{Binding ApplyFiltersCommand}"
                    Content="Apply filters" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DataGrid x:Name="GroupsGrid"
                      automation:AutomationProperties.AutomationId="FileGroupsGrid"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="True"
                      EnableColumnVirtualization="True"
                      EnableRowVirtualization="True"
                      IsReadOnly="True"
                      ItemsSource="{Binding Groups}"
                      SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                      SelectionMode="Single"
                      Sorting="OnGroupsSorting"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="*"
                                        MinWidth="180"
                                        Header="Representative"
                                        SortMemberPath="RepresentativeName"
                                        Binding="{Binding RepresentativeName}" />
                    <DataGridTextColumn Width="90"
                                        Header="Type"
                                        SortMemberPath="RepresentativeName"
                                        Binding="{Binding RepresentativeType}" />
                    <DataGridTextColumn Width="125"
                                        Header="Group size"
                                        SortMemberPath="GroupSize"
                                        Binding="{Binding GroupSize}" />
                    <DataGridTextColumn Width="105"
                                        Header="Copies"
                                        SortMemberPath="CopyCount"
                                        Binding="{Binding CopyCount}" />
                    <DataGridTextColumn Width="145"
                                        Header="Recoverable"
                                        SortDirection="Descending"
                                        SortMemberPath="RecoverableBytes"
                                        Binding="{Binding RecoverableBytes}" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="1" Margin="0,9,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Opacity="0.68" Text="{Binding GroupCountText}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Padding="10,4" Command="{Binding PreviousPageCommand}" Content="Previous" />
                    <Button Margin="8,0,0,0" Padding="10,4" Command="{Binding NextPageCommand}" Content="Next" />
                    <Button Margin="8,0,0,0" Padding="10,4" Command="{Binding ClearFiltersCommand}" Content="Clear filters" />
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                    Opacity="0.94"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="150" Height="4" IsIndeterminate="True" />
                    <TextBlock Margin="0,9,0,0" Opacity="0.7" Text="Loading duplicate groups…" />
                </StackPanel>
            </Border>
            <Border Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="#C84B31"
                    BorderThickness="1"
                    CornerRadius="7"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock MaxWidth="620" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="Results unavailable" />
                <TextBlock Margin="0,6,0,0" MaxWidth="560" Opacity="0.68" Text="{Binding StateMessage}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="No duplicate files" />
                <TextBlock Margin="0,6,0,0" Opacity="0.68" Text="{Binding StateMessage}" />
            </StackPanel>
        </Grid>

        <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" ResizeDirection="Rows" />

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="17" FontWeight="SemiBold" Text="Copies in selected group" />
                <TextBlock Grid.Column="1" Opacity="0.68" Text="{Binding MemberCountText}" />
            </Grid>
            <DataGrid x:Name="MembersGrid"
                      Grid.Row="1"
                      automation:AutomationProperties.AutomationId="FileMembersGrid"
                      AutoGenerateColumns="False"
                      EnableColumnVirtualization="True"
                      EnableRowVirtualization="True"
                      IsReadOnly="True"
                      ItemsSource="{Binding Members}"
                      SelectionMode="Single"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="*" MinWidth="300" Header="Path" Binding="{Binding Path}" />
                    <DataGridTextColumn Width="145" Header="Modified" Binding="{Binding Modified}" />
                    <DataGridTextColumn Width="110" Header="Size" Binding="{Binding Size}" />
                    <DataGridTemplateColumn Width="190" Header="Actions">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Padding="7,2"
                                            Command="{Binding DataContext.CopyPathCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Content="Copy path" />
                                    <Button Margin="6,0,0,0"
                                            Padding="7,2"
                                            Command="{Binding DataContext.RevealInExplorerCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Content="Show in Explorer" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Foreground="#C84B31"
                           Text="{Binding DetailErrorMessage}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasDetailError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Padding="10,4" Command="{Binding PreviousMemberPageCommand}" Content="Previous copies" />
                    <Button Margin="8,0,0,0" Padding="10,4" Command="{Binding NextMemberPageCommand}" Content="Next copies" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="1"
                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                    Opacity="0.94"
                    Visibility="{Binding IsDetailLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="130" Height="4" IsIndeterminate="True" />
                    <TextBlock Margin="0,8,0,0" Opacity="0.68" Text="Loading group members…" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsDetailEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock HorizontalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="No copies to display" />
                <TextBlock Margin="0,5,0,0" Opacity="0.68" Text="This group no longer has visible members." />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
