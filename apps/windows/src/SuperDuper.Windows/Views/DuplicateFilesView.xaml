                                                Visibility="{Binding DataContext.HasLiveValidationError, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                 </StackPanel>
                                 <TextBlock Margin="0,0,0,3"
                                            FontWeight="SemiBold"
                                            Text="{Binding Decision, StringFormat='Current decision: {0}'}"
                                            TextWrapping="Wrap" />
