<UserControl x:Class="SuperDuper.Windows.Views.DuplicateFilesView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:accessibility="clr-namespace:SuperDuper.Windows.Accessibility">
    <!-- The collapsed query header stays compact while the results workspace receives the
         remaining height. Advanced query/rule content scrolls in its own bounded region. -->
    <Grid x:Name="FileWorkspaceRoot" SizeChanged="OnWorkspaceSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="24,8,24,4" KeyboardNavigation.TabNavigation="Continue">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <DockPanel MinWidth="180" VerticalAlignment="Bottom">
                <Label DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" Padding="0,0,0,3" Target="{Binding ElementName=FileSearch}" Content="Path _search"/>
                                    <TextBox x:Name="FileSearch"
                             VerticalContentAlignment="Center"
                             KeyboardNavigation.TabIndex="10"
                             automation:AutomationProperties.Name="Path search"
                             automation:AutomationProperties.HelpText="Enter a complete immutable member path when Exact path is checked; otherwise performs a case-insensitive literal substring search with a 512-character maximum"
                             automation:AutomationProperties.AutomationId="FileSearch"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="OnFilterEditorKeyDown" HorizontalScrollBarVisibility="Auto" ToolTip="Search duplicate file paths" />

            </DockPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="8,0,0,0">
                                <Button x:Name="FileApplyFilters"
                        automation:AutomationProperties.AutomationId="FileApplyFilters"
                        Margin="8,0,0,0"
                        KeyboardNavigation.TabIndex="20"
                        automation:AutomationProperties.Name="Apply duplicate file filters"
                        Command="{Binding ApplyFiltersCommand}"
                        Content="_Apply" />
                <ToggleButton x:Name="FileFiltersToggle" KeyboardNavigation.TabIndex="25" Content="_Filters" Margin="8,0,0,0"
                    automation:AutomationProperties.AutomationId="FileFiltersToggle"
                    automation:AutomationProperties.Name="Show or hide draft file filters"
                    IsChecked="{Binding IsExpanded, ElementName=FileFiltersExpander, Mode=TwoWay}"/>
                                    <Button Margin="8,0,0,0"
                            KeyboardNavigation.TabIndex="30"
                            automation:AutomationProperties.AutomationId="FileClearFilters"
                            automation:AutomationProperties.Name="Clear all duplicate file filters"
                            Command="{Binding ClearFiltersCommand}"
                            Content="Clear filters" />
            </WrapPanel>
        </Grid>
        <TextBlock Margin="0,4,0,4" TextWrapping="Wrap" Text="{Binding QueryEditorStatus}"
            automation:AutomationProperties.AutomationId="FileQueryEditorStatus"/>
        <UniformGrid Columns="3" automation:AutomationProperties.AutomationId="FileReviewSummary"
            automation:AutomationProperties.Name="Filtered duplicate file results">
            <WrapPanel Margin="0,0,8,0">
                <TextBlock Text="Sets: " VerticalAlignment="Center"/>
                <TextBlock Text="{Binding FilteredSetsText}" FontWeight="SemiBold" VerticalAlignment="Center"
                    automation:AutomationProperties.AutomationId="FileSummaryMatchingSets" automation:AutomationProperties.LiveSetting="Polite"
                    automation:AutomationProperties.Name="{Binding FilteredSetsText, StringFormat='Filtered sets: {0}'}"/></WrapPanel>
            <WrapPanel Margin="0,0,8,0">
                <TextBlock Text="Copies: " VerticalAlignment="Center"/>
                <TextBlock Text="{Binding FilteredCopiesText}" FontWeight="SemiBold" VerticalAlignment="Center"
                    automation:AutomationProperties.AutomationId="FileSummaryMatchingCopies" automation:AutomationProperties.LiveSetting="Polite"
                    automation:AutomationProperties.Name="{Binding FilteredCopiesText, StringFormat='Filtered copies: {0}'}"/></WrapPanel>
            <WrapPanel Margin="0,0,8,0">
                <TextBlock Text="Potential savings: " VerticalAlignment="Center"/>
                <TextBlock Text="{Binding FilteredSavingsText}" FontWeight="SemiBold" VerticalAlignment="Center"
                    automation:AutomationProperties.AutomationId="FileSummaryRecoverable" automation:AutomationProperties.LiveSetting="Polite"
                    automation:AutomationProperties.Name="{Binding FilteredSavingsText, StringFormat='Filtered potential savings: {0}'}" ToolTip="{Binding FilteredSavingsExactText}"/></WrapPanel>
        </UniformGrid>
        <ScrollViewer MaxHeight="40" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding AppliedFilters}" automation:AutomationProperties.Name="Applied file filters">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Button KeyboardNavigation.TabIndex="35" Margin="0,4,6,0" MaxWidth="280" ToolTip="{Binding Text}"
                        automation:AutomationProperties.Name="{Binding AutomationName}"
                        Click="OnRemoveFilterClick" Tag="{Binding}">
                        <DockPanel><TextBlock DockPanel.Dock="Right" Text=" ×"/>
                            <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis"/></DockPanel>
                    </Button>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </StackPanel>
    <Grid Grid.Row="1" Margin="24,8,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="WorkspaceScrollViewer"
                      Grid.Row="0"
                      MaxHeight="250"
                      automation:AutomationProperties.AutomationId="FileWorkspaceScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Expander x:Name="FileFiltersExpander" Margin="0,0,0,0"
                      automation:AutomationProperties.AutomationId="FileFiltersExpander"
                      Header="Filters" IsExpanded="False" PreviewKeyDown="OnFilterEditorKeyDown" Collapsed="OnFiltersCollapsed"
                      Visibility="{Binding IsExpanded, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
            <WrapPanel Margin="0,10,0,0"
                       VerticalAlignment="Center"
                       automation:AutomationProperties.Name="Primary duplicate file filter controls">
                    <CheckBox x:Name="FileExactPathMatch"
                              Margin="0,5,0,0"
                              KeyboardNavigation.TabIndex="40"
                              automation:AutomationProperties.AutomationId="FileExactPathMatch"
                              automation:AutomationProperties.Name="Match the complete canonical member path"
                              automation:AutomationProperties.HelpText="Uses locale-independent Unicode case normalization and the immutable canonical path; clear this option to restore literal substring search"
                              Content="Exact path"
                              IsChecked="{Binding ExactPathMatch}"
                              ToolTip="Match one complete canonical member path" />
                <StackPanel Width="145" Margin="0,0,8,0">
                    <Label Padding="0,0,0,3"
                           Target="{Binding ElementName=FileMinimumSize}"
                           Content="_Minimum size" />
                    <TextBox x:Name="FileMinimumSize"
                             Width="145"
                             VerticalContentAlignment="Center"
                             KeyboardNavigation.TabIndex="50"
                             automation:AutomationProperties.Name="Minimum one-copy file size"
                             automation:AutomationProperties.HelpText="Converts exactly to a non-negative whole number of bytes applied to one-copy file size; GiB (1,073,741,824 bytes). Use a decimal point for fractions"
                             automation:AutomationProperties.AutomationId="FileMinimumSize"
                             Text="{Binding MinimumSizeText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Minimum one-copy file size" />
                    <Label Content="Size _unit" Target="{Binding ElementName=FileSizeUnit}" Padding="0,4,0,3"/>
                    <ComboBox x:Name="FileSizeUnit" KeyboardNavigation.TabIndex="55" ItemsSource="{Binding SizeUnits}" SelectedItem="{Binding MinimumSizeUnit}"
                        automation:AutomationProperties.AutomationId="FileSizeUnit" automation:AutomationProperties.Name="Minimum size unit"
                        automation:AutomationProperties.HelpText="Binary units: KiB = 1,024 bytes; MiB = 1,048,576 bytes; GiB = 1,073,741,824 bytes; TiB = 1,099,511,627,776 bytes"/>
                </StackPanel>
                <CheckBox x:Name="FileOneGigabyteOrLarger"
                          Margin="10,0,2,0"
                          VerticalAlignment="Center"
                          KeyboardNavigation.TabIndex="60"
                          automation:AutomationProperties.AutomationId="FileOneGigabyteOrLarger"
                          automation:AutomationProperties.Name="Show only duplicate sets whose one-copy size is at least 1 GiB, 1,073,741,824 bytes"
                          Content="1 GiB or larger"
                          IsChecked="{Binding OneGigabyteOrLarger}"
                          ToolTip="One-copy size of at least 1 GiB (1,073,741,824 bytes)" />
                <CheckBox x:Name="FileThreeOrMoreCopies"
                          Margin="10,0,2,0"
                          VerticalAlignment="Center"
                          KeyboardNavigation.TabIndex="70"
                          automation:AutomationProperties.AutomationId="FileThreeOrMoreCopies"
                          automation:AutomationProperties.Name="Show only duplicate sets with three or more copies"
                          Content="Three or more copies"
                          IsChecked="{Binding ThreeOrMoreCopies}" />
                <CheckBox x:Name="FileAcrossDrives"
                          Margin="10,0,2,0"
                          VerticalAlignment="Center"
                          KeyboardNavigation.TabIndex="80"
                          automation:AutomationProperties.AutomationId="FileAcrossDrives"
                          automation:AutomationProperties.Name="Show only duplicate sets across multiple drives"
                          Content="Across drives"
                          IsChecked="{Binding AcrossDrives}" />

            </WrapPanel>
            <WrapPanel Margin="0,10,0,0"
                       VerticalAlignment="Center"
                       automation:AutomationProperties.Name="Filename extension filter controls">
                <Label Margin="0,0,8,0"
                       Padding="0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Target="{Binding ElementName=FileExtension}"
                       Content="_Extension" />
                <TextBox x:Name="FileExtension"
                         Width="145"
                         VerticalContentAlignment="Center"
                         KeyboardNavigation.TabIndex="90"
                         automation:AutomationProperties.AutomationId="FileExtension"
                         automation:AutomationProperties.Name="Filename extension without the dot"
                         automation:AutomationProperties.HelpText="Matches any immutable member's final filename extension by default; use All copies must match to require every immutable member. This is not the representative label or a file-type classification"
                         Text="{Binding ExtensionText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Final filename extension without the dot; for example jpg" />
                <CheckBox x:Name="FileWithoutExtension"
                          Margin="10,0,0,0"
                          VerticalAlignment="Center"
                          KeyboardNavigation.TabIndex="100"
                          automation:AutomationProperties.AutomationId="FileWithoutExtension"
                          automation:AutomationProperties.Name="Use no filename extension as the extension filter value"
                          automation:AutomationProperties.HelpText="Overrides the extension box; filenames with no dot, a terminal dot, or only a leading dot are treated as having no extension. Any member matches by default; All copies must match changes this to every member"
                          Content="No extension"
                          IsChecked="{Binding WithoutExtension}"
                          ToolTip="Use no filename extension as the requested value" />
                <CheckBox x:Name="FileAllExtensionsMatch"
                          Margin="10,0,0,0"
                          VerticalAlignment="Center"
                          KeyboardNavigation.TabIndex="110"
                          automation:AutomationProperties.AutomationId="FileAllExtensionsMatch"
                          automation:AutomationProperties.Name="Require every copy in a duplicate set to match the filename extension filter"
                          automation:AutomationProperties.HelpText="Every immutable member must have the requested filename extension, or no extension when No extension is selected; filename extension remains distinct from file type"
                          Content="All copies must match"
                          IsChecked="{Binding AllMembersMustMatchExtension}"
                          ToolTip="Require every immutable member to match the extension value" />
            </WrapPanel>
            <WrapPanel Margin="0,10,0,0"
                       VerticalAlignment="Center"
                       automation:AutomationProperties.Name="Selected-root facet controls">
                <Label Margin="0,0,8,0"
                       Padding="0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Target="{Binding ElementName=FileSelectedRootFacet}"
                       Content="Selected _root" />
                <ComboBox x:Name="FileSelectedRootFacet"
                          Width="360"
                          MaxDropDownHeight="280"
                          VerticalContentAlignment="Center"
                          KeyboardNavigation.TabIndex="120"
                          automation:AutomationProperties.AutomationId="FileSelectedRootFacet"
                          automation:AutomationProperties.Name="Selected root facet; choose All selected roots to remove this filter"
                          DisplayMemberPath="DisplayText"
                          ItemsSource="{Binding SelectedRootFacetOptions}"
                          SelectedItem="{Binding SelectedRootFacet, Mode=TwoWay}">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
                            <Setter Property="automation:AutomationProperties.Name" Value="{Binding DisplayText}" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                <StackPanel Margin="8,0,0,0">
                    <Label Content="Root order" Target="{Binding ElementName=FileRootFacetSort}" Padding="0,0,0,3"/>
                    <ComboBox x:Name="FileRootFacetSort" KeyboardNavigation.TabIndex="129" Width="150" SelectedIndex="{Binding RootFacetSortIndex}"
                        automation:AutomationProperties.AutomationId="FileRootFacetSort" automation:AutomationProperties.Name="Root facet sort order">
                        <ComboBoxItem Content="Most sets first"/><ComboBoxItem Content="Name A–Z"/>
                    </ComboBox>
                </StackPanel>
                <Button Margin="8,0,0,0"
                        KeyboardNavigation.TabIndex="130"
                        automation:AutomationProperties.AutomationId="FilePreviousRootFacets"
                        automation:AutomationProperties.Name="Previous selected-root facet page"
                        Command="{Binding PreviousRootFacetPageCommand}"
                        Content="Previous roots" />
                <Button Margin="6,0,0,0"
                        KeyboardNavigation.TabIndex="140"
                        automation:AutomationProperties.AutomationId="FileNextRootFacets"
                        automation:AutomationProperties.Name="Next selected-root facet page"
                        Command="{Binding NextRootFacetPageCommand}"
                        Content="Next roots" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           automation:AutomationProperties.AutomationId="FileRootFacetCount"
                           automation:AutomationProperties.LiveSetting="Polite"
                           automation:AutomationProperties.Name="{Binding RootFacetStatusAnnouncement}"
                           accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding RootFacetStatusAnnouncementVersion}"
                           accessibility:AutomationNotificationBehavior.NotificationKind="ActionCompleted"
                           accessibility:AutomationNotificationBehavior.NotificationProcessing="MostRecent"
                           accessibility:AutomationNotificationBehavior.ActivityId="DuplicateFileSelectedRootFacetQuery"
                           Text="{Binding RootFacetCountText}" />
                <ProgressBar Width="70"
                             Height="4"
                             Margin="10,0,0,0"
                             automation:AutomationProperties.Name="Loading selected-root facets"
                             IsIndeterminate="True"
                             Visibility="{Binding IsRootFacetLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           automation:AutomationProperties.AutomationId="FileRootFacetError"
                           automation:AutomationProperties.LiveSetting="Assertive"
                           automation:AutomationProperties.Name="{Binding RootFacetErrorMessage, StringFormat='Selected-root facet error: {0}'}"
                           accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding RootFacetErrorAnnouncementVersion}"
                           accessibility:AutomationNotificationBehavior.NotificationKind="ActionAborted"
                           accessibility:AutomationNotificationBehavior.NotificationProcessing="ImportantMostRecent"
                           accessibility:AutomationNotificationBehavior.ActivityId="DuplicateFileSelectedRootFacetQuery"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{Binding RootFacetErrorMessage}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasRootFacetError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           automation:AutomationProperties.AutomationId="FileSelectedRootFilterText"
                           automation:AutomationProperties.LiveSetting="Polite"
                           automation:AutomationProperties.Name="{Binding SelectedRootFilterText, StringFormat='Selected-root filter status: {0}'}"
                           Text="{Binding SelectedRootFilterText}"
                           TextTrimming="CharacterEllipsis" />
            </WrapPanel>
            <WrapPanel Margin="0,8,0,0"
                       VerticalAlignment="Center"
                       automation:AutomationProperties.Name="Drive facet controls">
                <Label Margin="0,0,8,0"
                       Padding="0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Target="{Binding ElementName=FileDriveFacet}"
                       Content="_Drive" />
                <ComboBox x:Name="FileDriveFacet"
                          Width="220"
                          MaxDropDownHeight="280"
                          VerticalContentAlignment="Center"
                          KeyboardNavigation.TabIndex="150"
                          automation:AutomationProperties.AutomationId="FileDriveFacet"
                          automation:AutomationProperties.Name="Drive facet; choose All drives to remove this filter"
                          DisplayMemberPath="DisplayText"
                          ItemsSource="{Binding DriveFacetOptions}"
                          SelectedItem="{Binding SelectedDriveFacet, Mode=TwoWay}">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
                            <Setter Property="automation:AutomationProperties.Name" Value="{Binding DisplayText}" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                <StackPanel Margin="8,0,0,0">
                    <Label Content="Drive order" Target="{Binding ElementName=FileDriveFacetSort}" Padding="0,0,0,3"/>
                    <ComboBox x:Name="FileDriveFacetSort" KeyboardNavigation.TabIndex="159" Width="150" SelectedIndex="{Binding DriveFacetSortIndex}"
                        automation:AutomationProperties.AutomationId="FileDriveFacetSort" automation:AutomationProperties.Name="Drive facet sort order">
                        <ComboBoxItem Content="Most sets first"/><ComboBoxItem Content="Name A–Z"/>
                    </ComboBox>
                </StackPanel>
                <Button Margin="8,0,0,0"
                        KeyboardNavigation.TabIndex="160"
                        automation:AutomationProperties.AutomationId="FilePreviousDriveFacets"
                        automation:AutomationProperties.Name="Previous drive facet page"
                        Command="{Binding PreviousDriveFacetPageCommand}"
                        Content="Previous drives" />
                <Button Margin="6,0,0,0"
                        KeyboardNavigation.TabIndex="170"
                        automation:AutomationProperties.AutomationId="FileNextDriveFacets"
                        automation:AutomationProperties.Name="Next drive facet page"
                        Command="{Binding NextDriveFacetPageCommand}"
                        Content="Next drives" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           automation:AutomationProperties.AutomationId="FileDriveFacetCount"
                           automation:AutomationProperties.LiveSetting="Polite"
                           automation:AutomationProperties.Name="{Binding DriveFacetStatusAnnouncement}"
                           accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding DriveFacetStatusAnnouncementVersion}"
                           accessibility:AutomationNotificationBehavior.NotificationKind="ActionCompleted"
                           accessibility:AutomationNotificationBehavior.NotificationProcessing="MostRecent"
                           accessibility:AutomationNotificationBehavior.ActivityId="DuplicateFileDriveFacetQuery"
                           Text="{Binding DriveFacetCountText}" />
                <ProgressBar Width="70"
                             Height="4"
                             Margin="10,0,0,0"
                             automation:AutomationProperties.Name="Loading drive facets"
                             IsIndeterminate="True"
                             Visibility="{Binding IsDriveFacetLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           automation:AutomationProperties.AutomationId="FileDriveFacetError"
                           automation:AutomationProperties.LiveSetting="Assertive"
                           automation:AutomationProperties.Name="{Binding DriveFacetErrorMessage, StringFormat='Drive facet error: {0}'}"
                           accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding DriveFacetErrorAnnouncementVersion}"
                           accessibility:AutomationNotificationBehavior.NotificationKind="ActionAborted"
                           accessibility:AutomationNotificationBehavior.NotificationProcessing="ImportantMostRecent"
                           accessibility:AutomationNotificationBehavior.ActivityId="DuplicateFileDriveFacetQuery"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{Binding DriveFacetErrorMessage}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasDriveFacetError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           automation:AutomationProperties.AutomationId="FileSelectedDriveFilterText"
                           automation:AutomationProperties.LiveSetting="Polite"
                           automation:AutomationProperties.Name="{Binding SelectedDriveFilterText, StringFormat='Drive filter status: {0}'}"
                           Text="{Binding SelectedDriveFilterText}"
                           TextTrimming="CharacterEllipsis" />
            </WrapPanel>
            <Expander x:Name="FileTotalsExpander" Header="Location coverage and largest opportunity" IsExpanded="False"
                      automation:AutomationProperties.AutomationId="FileTotalsExpander">
                <StackPanel>
                <Border Margin="6,0,0,0" Padding="12,9" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="Largest opportunity" />
                        <TextBlock automation:AutomationProperties.AutomationId="FileSummaryLargestOpportunity"
                                   automation:AutomationProperties.LiveSetting="Polite"
                                   automation:AutomationProperties.Name="{Binding LargestOpportunityText, StringFormat='Largest recoverable opportunity: {0}'}"
                                   Style="{StaticResource SectionTitle}"
                                   Text="{Binding LargestOpportunityText}" />
                    </StackPanel>
                </Border>

            <Border Margin="0,8,0,0"
                    Padding="12,8"
                    automation:AutomationProperties.AutomationId="FileLocationSummary"
                    automation:AutomationProperties.Name="Duplicate file location coverage"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,0,8,0" FontWeight="SemiBold" Text="Location coverage" />
                    <TextBlock Grid.Column="1"
                               automation:AutomationProperties.AutomationId="FileLocationSummaryText"
                               automation:AutomationProperties.LiveSetting="Polite"
                               automation:AutomationProperties.Name="{Binding LocationCoverageText, StringFormat='Location coverage: {0}'}"
                               Text="{Binding LocationCoverageText}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>
                </StackPanel>
            </Expander>
            <Expander Margin="0,12,0,0"
                      automation:AutomationProperties.AutomationId="PreferredRootPreviewExpander"
                      automation:AutomationProperties.Name="Ordered preferred scan-root review rule"
                      automation:AutomationProperties.HelpText="Edit and save a named root ordering, preview an explicit immutable scope, and optionally confirm reversible review decisions. No files are validated or deleted."
                      Header="Preferred-root review rule — preview, apply review intent, or reverse; nothing is deleted"
                      IsExpanded="False">
                <Border Margin="0,6,0,0"
                        Padding="12"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel>
                        <StackPanel>
                            <WrapPanel>
                                <Label Padding="0,0,6,0"
                                       VerticalAlignment="Center"
                                       Target="{Binding ElementName=PreferenceRuleList}"
                                       Content="Saved _rule" />
                                <ComboBox x:Name="PreferenceRuleList"
                                          Width="230"
                                          KeyboardNavigation.TabIndex="180"
                                          automation:AutomationProperties.AutomationId="PreferenceRuleList"
                                          automation:AutomationProperties.Name="Saved preferred-root rules"
                                          DisplayMemberPath="Name"
                                          ItemsSource="{Binding PreferenceRules.Rules}"
                                          SelectedItem="{Binding PreferenceRules.SelectedRule, Mode=TwoWay}" />
                                <Button x:Name="PreferenceApplyRuleButton"
                                        Margin="6,0,0,0"
                                        KeyboardNavigation.TabIndex="190"
                                        automation:AutomationProperties.AutomationId="PreferenceNewRule"
                                        automation:AutomationProperties.Name="Create a new ordered preferred-root rule"
                                        Command="{Binding PreferenceRules.NewRuleCommand}"
                                        Content="New" />
                            </WrapPanel>
                            <Label Margin="0,8,0,0"
                                   Padding="0,0,0,3"
                                   Target="{Binding ElementName=PreferenceRuleName}"
                                   Content="Rule _name" />
                            <TextBox x:Name="PreferenceRuleName"
                                     KeyboardNavigation.TabIndex="200"
                                     automation:AutomationProperties.AutomationId="PreferenceRuleName"
                                     automation:AutomationProperties.Name="Preferred-root rule name"
                                     automation:AutomationProperties.HelpText="Enter 1 to 128 characters without surrounding whitespace"
                                     Text="{Binding PreferenceRules.RuleName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,8,0,4"
                                       FontWeight="SemiBold"
                                       Text="Roots, highest rank first" />
                            <ListBox Height="96"
                                     KeyboardNavigation.TabIndex="210"
                                     automation:AutomationProperties.AutomationId="PreferenceOrderedRoots"
                                     automation:AutomationProperties.Name="Ordered preferred scan roots; highest rank first"
                                     ItemsSource="{Binding PreferenceRules.OrderedRoots}"
                                     SelectedItem="{Binding PreferenceRules.SelectedRoot, Mode=TwoWay}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
                                        <Setter Property="automation:AutomationProperties.Name" Value="{Binding}" />
                                        <Setter Property="automation:AutomationProperties.HelpText" Value="Use Move up and Move down to change this root's explicit rank" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <WrapPanel Margin="0,6,0,0">
                                <Button
                                        KeyboardNavigation.TabIndex="220"
                                        automation:AutomationProperties.AutomationId="PreferenceMoveRootUp"
                                        automation:AutomationProperties.Name="Move selected root one rank higher"
                                        Command="{Binding PreferenceRules.MoveRootUpCommand}"
                                        Content="Move up" />
                                <Button Margin="6,0,0,0"
                                        KeyboardNavigation.TabIndex="230"
                                        automation:AutomationProperties.AutomationId="PreferenceMoveRootDown"
                                        automation:AutomationProperties.Name="Move selected root one rank lower"
                                        Command="{Binding PreferenceRules.MoveRootDownCommand}"
                                        Content="Move down" />
                                <Button Margin="6,0,0,0"
                                        KeyboardNavigation.TabIndex="240"
                                        automation:AutomationProperties.AutomationId="PreferenceRemoveRoot"
                                        automation:AutomationProperties.Name="Remove selected root from this rule"
                                        Command="{Binding PreferenceRules.RemoveRootCommand}"
                                        Content="Remove" />
                            </WrapPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <TextBox Width="255"
                                         KeyboardNavigation.TabIndex="250"
                                         automation:AutomationProperties.AutomationId="PreferenceNewRoot"
                                         automation:AutomationProperties.Name="Absolute scan root to add to the ordered rule"
                                         Text="{Binding PreferenceRules.NewRoot, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Margin="6,0,0,0"
                                        KeyboardNavigation.TabIndex="260"
                                        automation:AutomationProperties.AutomationId="PreferenceAddRoot"
                                        automation:AutomationProperties.Name="Add root at the lowest preference rank"
                                        Command="{Binding PreferenceRules.AddRootCommand}"
                                        Content="Add root" />
                            </WrapPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <Button
                                        KeyboardNavigation.TabIndex="270"
                                        automation:AutomationProperties.AutomationId="PreferenceSaveRule"
                                        automation:AutomationProperties.Name="Save named ordered preferred-root rule configuration"
                                        automation:AutomationProperties.HelpText="Saves configuration only; does not change any review decision"
                                        Command="{Binding PreferenceRules.SaveCommand}"
                                        Content="Save rule" />
                            </WrapPanel>
                        </StackPanel>
                        <StackPanel Margin="0,12,0,0">
                            <WrapPanel>
                                <Label Padding="0,0,6,0"
                                       VerticalAlignment="Center"
                                       Target="{Binding ElementName=PreferencePreviewScope}"
                                       Content="Preview _scope" />
                                <ComboBox x:Name="PreferencePreviewScope"
                                          Width="220"
                                          KeyboardNavigation.TabIndex="280"
                                          automation:AutomationProperties.AutomationId="PreferencePreviewScope"
                                          automation:AutomationProperties.Name="Explicit preferred-root preview scope"
                                          DisplayMemberPath="DisplayName"
                                          ItemsSource="{Binding PreferenceRules.ScopeOptions}"
                                          SelectedItem="{Binding PreferenceRules.SelectedScope, Mode=TwoWay}" />
                                <Button Margin="8,0,0,0"
                                        KeyboardNavigation.TabIndex="290"
                                        automation:AutomationProperties.AutomationId="PreferenceRunPreview"
                                        automation:AutomationProperties.Name="Run read-only preferred-root preview"
                                        automation:AutomationProperties.HelpText="Computes virtual Keep and Remove outcomes without applying decisions or deleting files"
                                        Command="{Binding PreferenceRules.PreviewCommand}"
                                        Content="Preview" />
                                <Button Margin="6,0,0,0"
                                        KeyboardNavigation.TabIndex="300"
                                        automation:AutomationProperties.AutomationId="PreferenceNextPreviewPage"
                                        automation:AutomationProperties.Name="Next preferred-root preview page"
                                        Command="{Binding PreferenceRules.NextPageCommand}"
                                        Content="Next page" />
                                <Button Margin="6,0,0,0"
                                        KeyboardNavigation.TabIndex="310"
                                        automation:AutomationProperties.AutomationId="PreferenceApplyRule"
                                        automation:AutomationProperties.Name="Review and confirm this exact preferred-root preview"
                                        automation:AutomationProperties.HelpText="Opens a confirmation; applying changes reversible review decisions only and does not validate or delete files"
                                        Command="{Binding PreferenceRules.ApplyCommand}"
                                        Content="Apply rule…" />
                            </WrapPanel>
                            <Border Margin="0,8,0,0"
                                    Padding="10"
                                    BorderBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                                    BorderThickness="2"
                                    Visibility="{Binding PreferenceRules.IsApplicationConfirmationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock x:Name="PreferenceApplicationConfirmationHeading"
                                               Focusable="True"
                                               KeyboardNavigation.TabIndex="320"
                                               FontWeight="SemiBold"
                                               Text="Confirm reversible review-rule application"
                                               automation:AutomationProperties.AutomationId="PreferenceApplicationConfirmationHeading"
                                               automation:AutomationProperties.Name="Confirm reversible review-rule application" />
                                    <TextBlock Margin="0,5,0,0"
                                               TextWrapping="Wrap"
                                               Text="{Binding PreferenceRules.ApplicationConfirmationText}"
                                               automation:AutomationProperties.AutomationId="PreferenceApplicationConfirmationSummary"
                                               automation:AutomationProperties.Name="{Binding PreferenceRules.ApplicationConfirmationText}" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button
                                                KeyboardNavigation.TabIndex="330"
                                                automation:AutomationProperties.AutomationId="PreferenceConfirmApplication"
                                                automation:AutomationProperties.Name="Confirm rule application to review decisions only"
                                                automation:AutomationProperties.HelpText="Records reversible review intent; does not validate or delete files"
                                                Command="{Binding PreferenceRules.ConfirmApplicationCommand}"
                                                Content="Confirm application" />
                                        <Button Margin="6,0,0,0"
                                                KeyboardNavigation.TabIndex="340"
                                                automation:AutomationProperties.AutomationId="PreferenceCancelApplication"
                                                automation:AutomationProperties.Name="Cancel rule application confirmation"
                                                Command="{Binding PreferenceRules.CancelApplicationCommand}"
                                                Content="Cancel" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       automation:AutomationProperties.AutomationId="PreferenceApplicationHistory"
                                       automation:AutomationProperties.Name="{Binding PreferenceRules.ApplicationHistoryText}"
                                       Text="{Binding PreferenceRules.ApplicationHistoryText}" />
                            <Button x:Name="PreferenceReverseApplicationButton"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Left"
                                    KeyboardNavigation.TabIndex="350"
                                    automation:AutomationProperties.AutomationId="PreferenceReverseApplication"
                                    automation:AutomationProperties.Name="Review and confirm reversal of this rule application"
                                    automation:AutomationProperties.HelpText="Clears only this application's rule-produced decisions and preserves manual choices"
                                    Command="{Binding PreferenceRules.ReverseCommand}"
                                    Content="Reverse this application…" />
                            <Border Margin="0,8,0,0"
                                    Padding="10"
                                    BorderBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                                    BorderThickness="2"
                                    Visibility="{Binding PreferenceRules.IsReversalConfirmationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock x:Name="PreferenceReversalConfirmationHeading"
                                               Focusable="True"
                                               KeyboardNavigation.TabIndex="360"
                                               FontWeight="SemiBold"
                                               Text="Confirm isolated rule-application reversal"
                                               automation:AutomationProperties.AutomationId="PreferenceReversalConfirmationHeading"
                                               automation:AutomationProperties.Name="Confirm isolated rule-application reversal" />
                                    <TextBlock Margin="0,5,0,0"
                                               TextWrapping="Wrap"
                                               Text="{Binding PreferenceRules.ReversalConfirmationText}"
                                               automation:AutomationProperties.AutomationId="PreferenceReversalConfirmationSummary"
                                               automation:AutomationProperties.Name="{Binding PreferenceRules.ReversalConfirmationText}" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button
                                                KeyboardNavigation.TabIndex="370"
                                                automation:AutomationProperties.AutomationId="PreferenceConfirmReversal"
                                                automation:AutomationProperties.Name="Confirm reversal while preserving manual review choices"
                                                Command="{Binding PreferenceRules.ConfirmReversalCommand}"
                                                Content="Confirm reversal" />
                                        <Button Margin="6,0,0,0"
                                                KeyboardNavigation.TabIndex="380"
                                                automation:AutomationProperties.AutomationId="PreferenceCancelReversal"
                                                automation:AutomationProperties.Name="Cancel rule-application reversal"
                                                Command="{Binding PreferenceRules.CancelReversalCommand}"
                                                Content="Cancel" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       automation:AutomationProperties.AutomationId="PreferencePreviewSummary"
                                       automation:AutomationProperties.Name="{Binding PreferenceRules.SummaryText, StringFormat='Preferred-root preview summary: {0}'}"
                                       Text="{Binding PreferenceRules.SummaryText}" />
                            <TextBlock Margin="0,5,0,0"
                                       TextWrapping="Wrap"
                                       automation:AutomationProperties.AutomationId="PreferencePreviewStatus"
                                       automation:AutomationProperties.LiveSetting="Polite"
                                       automation:AutomationProperties.Name="{Binding PreferenceRules.StatusMessage}"
                                       accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding PreferenceRules.AnnouncementVersion}"
                                       accessibility:AutomationNotificationBehavior.NotificationKind="ActionCompleted"
                                       accessibility:AutomationNotificationBehavior.NotificationProcessing="MostRecent"
                                       accessibility:AutomationNotificationBehavior.ActivityId="PreferredRootPreview"
                                       Text="{Binding PreferenceRules.StatusMessage}" />
                            <TextBlock Margin="0,5,0,0"
                                       TextWrapping="Wrap"
                                       automation:AutomationProperties.AutomationId="PreferencePreviewError"
                                       automation:AutomationProperties.LiveSetting="Assertive"
                                       automation:AutomationProperties.Name="{Binding PreferenceRules.ErrorMessage, StringFormat='Preferred-root preview error: {0}'}"
                                       accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding PreferenceRules.AnnouncementVersion}"
                                       accessibility:AutomationNotificationBehavior.NotificationKind="ActionAborted"
                                       accessibility:AutomationNotificationBehavior.NotificationProcessing="ImportantMostRecent"
                                       accessibility:AutomationNotificationBehavior.ActivityId="PreferredRootPreviewError"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="{Binding PreferenceRules.ErrorMessage}"
                                       Visibility="{Binding PreferenceRules.HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <DataGrid Height="145"
                                      Margin="0,8,0,0"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="False"
                                      CanUserResizeRows="False"
                                      EnableRowVirtualization="True"
                                      IsReadOnly="True"
                                      KeyboardNavigation.TabIndex="390"
                                      automation:AutomationProperties.AutomationId="PreferencePreviewGroups"
                                      automation:AutomationProperties.Name="Read-only preferred-root preview results"
                                      ItemsSource="{Binding PreferenceRules.PreviewGroups}"
                                      SelectionMode="Single"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
                                        <Setter Property="automation:AutomationProperties.Name" Value="{Binding AutomationName}" />
                                        <Setter Property="automation:AutomationProperties.HelpText" Value="This is a virtual preview only; nothing is applied or deleted" />
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="70" Header="Set" Binding="{Binding GroupId}" />
                                    <DataGridTextColumn Width="90" Header="Status" Binding="{Binding Status}" />
                                    <DataGridTextColumn Width="150" Header="Preferred root" Binding="{Binding PreferredRoot}" />
                                    <DataGridTextColumn Width="*" Header="Explanation" Binding="{Binding Explanation}" />
                                    <DataGridTextColumn Width="105" Header="Virtual keep" Binding="{Binding ProposedKeepText}" />
                                    <DataGridTextColumn Width="155" Header="Virtual remove" Binding="{Binding ProposedRemoveText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Expander>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1">
            <Border Margin="0,0,0,10"
                    Padding="12,9"
                    BorderBrush="{DynamicResource TextFillColorPrimaryBrush}"
                    BorderThickness="2"
                    CornerRadius="6"
                    Visibility="{Binding HasDirtyRoots, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0" Orientation="Horizontal">
                        <Button x:Name="ReconcileDirtyRootButton"
                                KeyboardNavigation.TabIndex="400"
                                automation:AutomationProperties.AccessKey="Alt+X"
                                automation:AutomationProperties.AutomationId="FileReconcileDirtyRoot"
                                automation:AutomationProperties.Name="Reconcile next bounded dirty-root batch; access key Alt+X; focus returns to the visible copy comparison"
                                automation:AutomationProperties.HelpText="Checks at most 200 server-owned duplicate copies for one durable dirty root. It does not bind full results, follow watcher events, or change immutable scan history."
                                Click="OnReconcileDirtyRootClick"
                                Content="Reconcile ne_xt batch"
                                IsEnabled="{Binding CanReconcileDirtyRoot}" />
                        <Button Margin="8,0,0,0"
                                KeyboardNavigation.TabIndex="410"
                                automation:AutomationProperties.AutomationId="FileCancelDirtyRootReconciliation"
                                automation:AutomationProperties.Name="Cancel bounded dirty-root reconciliation"
                                Command="{Binding CancelDirtyRootReconciliationCommand}"
                                Content="Cancel reconciliation" />
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center"
                               automation:AutomationProperties.AutomationId="FileDirtyRootWarning"
                               automation:AutomationProperties.LiveSetting="Assertive"
                               automation:AutomationProperties.Name="{Binding DirtyRootWarningMessage}"
                               FontWeight="SemiBold"
                               Text="{Binding DirtyRootWarningMessage}"
                               TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <TextBlock Margin="0,0,0,8"
                       automation:AutomationProperties.AutomationId="FileDirtyRootStatus"
                       automation:AutomationProperties.LiveSetting="Polite"
                       automation:AutomationProperties.Name="{Binding DirtyRootStatusMessage}"
                       accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding DirtyRootStatusAnnouncementVersion}"
                       accessibility:AutomationNotificationBehavior.NotificationKind="ActionCompleted"
                       accessibility:AutomationNotificationBehavior.NotificationProcessing="MostRecent"
                       accessibility:AutomationNotificationBehavior.ActivityId="DuplicateFileDirtyRootReconciliation"
                       Text="{Binding DirtyRootStatusMessage}"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasDirtyRootStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Margin="0,0,0,8"
                       automation:AutomationProperties.AutomationId="FileDirtyRootError"
                       automation:AutomationProperties.LiveSetting="Assertive"
                       automation:AutomationProperties.Name="{Binding DirtyRootErrorMessage}"
                       accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding DirtyRootErrorAnnouncementVersion}"
                       accessibility:AutomationNotificationBehavior.NotificationKind="ActionAborted"
                       accessibility:AutomationNotificationBehavior.NotificationProcessing="ImportantMostRecent"
                       accessibility:AutomationNotificationBehavior.ActivityId="DuplicateFileDirtyRootReconciliation"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Text="{Binding DirtyRootErrorMessage}"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasDirtyRootError, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Margin="0,0,0,8"
                       automation:AutomationProperties.AutomationId="FileLiveHintStatus"
                       automation:AutomationProperties.LiveSetting="Polite"
                       automation:AutomationProperties.Name="{Binding LiveHintStatusMessage}"
                       accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding LiveHintAnnouncementVersion}"
                       accessibility:AutomationNotificationBehavior.NotificationKind="ActionCompleted"
                       accessibility:AutomationNotificationBehavior.NotificationProcessing="MostRecent"
                       accessibility:AutomationNotificationBehavior.ActivityId="DuplicateFileLiveHints"
                       Text="{Binding LiveHintStatusMessage}"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasLiveHintStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />

        </StackPanel>

        <Grid x:Name="FileComparisonWorkspace"
              Grid.Row="2"
              automation:AutomationProperties.AutomationId="FileComparisonWorkspace"
              automation:AutomationProperties.Name="Adjustable duplicate set list and copy comparison">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SetPaneColumn" Width="36*" MinWidth="280" />
                <ColumnDefinition x:Name="ComparisonSplitterColumn" Width="12" />
                <ColumnDefinition x:Name="DetailPaneColumn" Width="64*" MinWidth="360" />
            </Grid.ColumnDefinitions>

        <Grid x:Name="SetPane" Grid.Column="0"
              automation:AutomationProperties.AutomationId="FileSetPane"
              automation:AutomationProperties.Name="Duplicate set list">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="SetPaneHeading" Style="{StaticResource SectionTitle}" Text="Duplicate sets" />
                    <ComboBox x:Name="FileSetSort"
                              MinWidth="190"
                              Margin="0,5,0,0"
                              HorizontalAlignment="Left"
                              KeyboardNavigation.TabIndex="415"
                              automation:AutomationProperties.AutomationId="FileSetSort"
                              automation:AutomationProperties.Name="Sort duplicate sets"
                              SelectionChanged="OnSetSortChanged">
                        <ComboBoxItem Tag="RecoverableBytes:Descending" Content="Potential savings, largest first" />
                        <ComboBoxItem Tag="RecoverableBytes:Ascending" Content="Potential savings, smallest first" />
                        <ComboBoxItem Tag="GroupSize:Descending" Content="One-copy size, largest first" />
                        <ComboBoxItem Tag="GroupSize:Ascending" Content="One-copy size, smallest first" />
                        <ComboBoxItem Tag="CopyCount:Descending" Content="Copies, most first" />
                        <ComboBoxItem Tag="CopyCount:Ascending" Content="Copies, fewest first" />
                        <ComboBoxItem Tag="RepresentativeName:Ascending" Content="Representative label, A–Z" />
                        <ComboBoxItem Tag="RepresentativeName:Descending" Content="Representative label, Z–A" />
                    </ComboBox>
                </StackPanel>
                <Button x:Name="CompareSelectedSetButton"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        KeyboardNavigation.TabIndex="417"
                        automation:AutomationProperties.AutomationId="FileCompareSelectedSet"
                        automation:AutomationProperties.Name="Compare copies in the selected duplicate set"
                        Click="OnCompareSelectedSetClick"
                        Content="Compare selected set"
                        IsEnabled="{Binding HasSelectedGroup}"
                        Visibility="Collapsed" />
            </Grid>
            <DataGrid x:Name="GroupsGrid" Grid.Row="1"
                      MinHeight="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      automation:AutomationProperties.AutomationId="FileGroupsGrid"
                      automation:AutomationProperties.Name="Duplicate file groups"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="True"
                      EnableColumnVirtualization="True"
                      EnableRowVirtualization="True"
                      IsReadOnly="True"
                      KeyboardNavigation.TabIndex="420"
                      ItemsSource="{Binding Groups}"
                      SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                      SelectionMode="Single"
                      Sorting="OnGroupsSorting"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="*"
                                            Header="Duplicate sets"
                                            SortMemberPath="RecoverableBytes"
                                            SortDirection="Descending">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="3,4"
                                            automation:AutomationProperties.Name="{Binding RepresentativeName, StringFormat='Duplicate set represented by {0}'}">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding RepresentativeName}"
                                               TextWrapping="Wrap"
                                               ToolTip="{Binding RepresentativeName}" />
                                    <WrapPanel Margin="0,3,0,0">
                                        <TextBlock Text="{Binding CopyCount, StringFormat={}{0} copies}" />
                                        <TextBlock Margin="8,0,0,0" Text="{Binding GroupSize, StringFormat=Size {0}}" />
                                        <TextBlock Margin="8,0,0,0" Text="{Binding RecoverableBytes, StringFormat=Save up to {0}}" />
                                    </WrapPanel>
                                    <TextBlock Margin="0,3,0,0"
                                               Text="{Binding LocationSpan}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="2" Margin="0,9,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="GroupStatusText"
                           VerticalAlignment="Center"
                           automation:AutomationProperties.AutomationId="FileGroupCount"
                           automation:AutomationProperties.LiveSetting="Polite"
                           automation:AutomationProperties.Name="{Binding GroupStatusAnnouncement}"
                           accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding GroupStatusAnnouncementVersion}"
                           accessibility:AutomationNotificationBehavior.NotificationKind="ActionCompleted"
                           accessibility:AutomationNotificationBehavior.NotificationProcessing="MostRecent"
                           accessibility:AutomationNotificationBehavior.ActivityId="DuplicateFileGroupQuery"
                           Text="{Binding GroupCountText}" TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" automation:AutomationProperties.Name="Duplicate file group paging" Orientation="Horizontal">
                    <Button
                            KeyboardNavigation.TabIndex="430"
                            automation:AutomationProperties.AutomationId="FilePreviousGroupPage"
                            automation:AutomationProperties.Name="Previous duplicate group page"
                            Command="{Binding PreviousPageCommand}"
                            Content="Previous" />
                    <Button Margin="8,0,0,0"
                            KeyboardNavigation.TabIndex="440"
                            automation:AutomationProperties.AutomationId="FileNextGroupPage"
                            automation:AutomationProperties.Name="Next duplicate group page"
                            Command="{Binding NextPageCommand}"
                            Content="Next" />

                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                    automation:AutomationProperties.Name="Loading duplicate groups"
                    automation:AutomationProperties.LiveSetting="Polite"
                    Visibility="{Binding IsLoadingOverlayVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="150" Height="4" IsIndeterminate="True" />
                    <TextBlock Margin="0,9,0,0" Text="Loading duplicate groups…" />
                </StackPanel>
            </Border>
             <Border x:Name="GroupErrorStatus"
                     Padding="16"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     automation:AutomationProperties.AutomationId="FileGroupError"
                     automation:AutomationProperties.LiveSetting="Assertive"
                     automation:AutomationProperties.Name="{Binding GroupErrorAnnouncement}"
                     accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding GroupErrorAnnouncementVersion}"
                     accessibility:AutomationNotificationBehavior.NotificationKind="ActionAborted"
                     accessibility:AutomationNotificationBehavior.NotificationProcessing="ImportantMostRecent"
                     accessibility:AutomationNotificationBehavior.ActivityId="DuplicateFileGroupQuery"
                     BorderBrush="{DynamicResource TextFillColorPrimaryBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock MaxWidth="620" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>
             <StackPanel HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         automation:AutomationProperties.AutomationId="FileUnavailableState"
                         automation:AutomationProperties.LiveSetting="Polite"
                         automation:AutomationProperties.Name="{Binding StateMessage, StringFormat='Results unavailable: {0}'}"
                         Visibility="{Binding IsUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource PageTitle}" Text="Results unavailable" />
                <TextBlock Margin="0,6,0,0" MaxWidth="560" Text="{Binding StateMessage}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
             <StackPanel HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         automation:AutomationProperties.AutomationId="FileEmptyState"
                         automation:AutomationProperties.LiveSetting="Polite"
                         automation:AutomationProperties.Name="{Binding StateMessage, StringFormat='No duplicate files: {0}'}"
                         Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource PageTitle}" Text="No duplicate files" />
                <TextBlock Margin="0,6,0,0" Text="{Binding StateMessage}" />
            </StackPanel>
        </Grid>

        <GridSplitter x:Name="ComparisonSplitter"
                      Grid.Column="1"
                      Width="4"
                      Margin="4,0"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns"
                      ShowsPreview="True"
                      KeyboardNavigation.TabIndex="445"
                      automation:AutomationProperties.AutomationId="FileComparisonSplitter"
                      automation:AutomationProperties.Name="Resize duplicate set list and copy comparison" />

        <Grid x:Name="DetailPane"
              Grid.Column="2"
              automation:AutomationProperties.AutomationId="FileDetailPane"
              automation:AutomationProperties.Name="Selected duplicate set copy comparison">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackToSetsButton"
                            Margin="0,0,8,0"
                            KeyboardNavigation.TabIndex="447"
                            automation:AutomationProperties.AutomationId="FileBackToSets"
                            automation:AutomationProperties.Name="Back to duplicate sets"
                            Click="OnBackToSetsClick"
                            Content="← Back to sets"
                            Visibility="Collapsed" />
                    <TextBlock x:Name="SelectedSetHeading"
                               Grid.Column="1"
                               Margin="0,0,8,0"
                               Focusable="True"
                               VerticalAlignment="Center"
                               automation:AutomationProperties.AutomationId="FileSelectedSetName"
                               automation:AutomationProperties.LiveSetting="Polite"
                               automation:AutomationProperties.Name="{Binding SelectedGroup.RepresentativeName, StringFormat='Selected duplicate set: {0}', TargetNullValue='No duplicate set selected'}"
                               automation:AutomationProperties.HelpText="Exact content was verified at scan time; the representative label does not identify an original"
                               Style="{StaticResource SectionTitle}"
                               Text="{Binding SelectedGroup.RepresentativeName, TargetNullValue=Select a duplicate set}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedGroup.RepresentativeName}" />
                    <StackPanel Grid.Column="2"
                                automation:AutomationProperties.Name="Duplicate set navigation"
                                Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   automation:AutomationProperties.AutomationId="FileMemberCount"
                                   automation:AutomationProperties.LiveSetting="Polite"
                                   automation:AutomationProperties.Name="{Binding SelectedSetStatusAnnouncement}"
                                   accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding SelectedSetStatusAnnouncementVersion}"
                                   accessibility:AutomationNotificationBehavior.NotificationKind="ActionCompleted"
                                   accessibility:AutomationNotificationBehavior.NotificationProcessing="MostRecent"
                                   accessibility:AutomationNotificationBehavior.ActivityId="DuplicateFileMemberQuery"
                                   Text="{Binding MemberCountText}" />
                        <Button x:Name="PreviousSetButton"
                                KeyboardNavigation.TabIndex="450"
                                automation:AutomationProperties.AutomationId="FilePreviousSet"
                                automation:AutomationProperties.Name="Previous duplicate set; access key Alt+P; focus returns to the selected group"
                                Click="OnSetNavigationClick"
                                Content="_Previous set"
                                IsEnabled="{Binding CanMoveToPreviousSet}"
                                ToolTip="Previous duplicate set (Alt+P); returns focus to the selected group" />
                        <Button x:Name="NextSetButton"
                                Margin="8,0,0,0"
                                KeyboardNavigation.TabIndex="460"
                                automation:AutomationProperties.AutomationId="FileNextSet"
                                automation:AutomationProperties.Name="Next duplicate set; access key Alt+N; focus returns to the selected group"
                                Click="OnSetNavigationClick"
                                Content="_Next set"
                                IsEnabled="{Binding CanMoveToNextSet}"
                                ToolTip="Next duplicate set (Alt+N); returns focus to the selected group" />
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="DetailContextSummary">
                    <TextBlock x:Name="SelectedSetExplanation"
                               automation:AutomationProperties.AutomationId="FileSelectedSetExplanation"
                               automation:AutomationProperties.Name="Exact content was verified at scan time; the representative label does not identify an original"
                               Text="Exact content was verified at scan time. The representative label does not identify an original."
                               Visibility="Collapsed" />
                    <TextBlock Margin="0,3,0,0"
                               automation:AutomationProperties.AutomationId="FileSelectedSetLocations"
                               automation:AutomationProperties.LiveSetting="Polite"
                               automation:AutomationProperties.Name="{Binding SelectedGroup.LocationSpan, StringFormat='Selected duplicate set location span: {0}'}"
                               Text="{Binding SelectedGroup.LocationSpan}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding SelectedGroup.LocationSpan}" />
                    <TextBlock Margin="0,3,0,0"
                               automation:AutomationProperties.AutomationId="FileReviewPlanSummary"
                               automation:AutomationProperties.LiveSetting="Polite"
                               automation:AutomationProperties.Name="{Binding ReviewPlanSummaryText}"
                               Text="{Binding ReviewPlanSummaryText}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ReviewPlanSummaryText}" />
                    <TextBlock Margin="0,3,0,0"
                               automation:AutomationProperties.AutomationId="FileSelectedSetReviewSummary"
                               automation:AutomationProperties.LiveSetting="Polite"
                               automation:AutomationProperties.Name="{Binding SelectedReviewSummaryText}"
                               Text="{Binding SelectedReviewSummaryText}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding SelectedReviewSummaryText}" />
                </StackPanel>
            </StackPanel>
            <DataGrid x:Name="MembersGrid" MinHeight="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      Grid.Row="1"
                      automation:AutomationProperties.AutomationId="FileMembersGrid"
                      automation:AutomationProperties.Name="Files in selected duplicate group"
                      AutoGenerateColumns="False"
                      EnableColumnVirtualization="True"
                      EnableRowVirtualization="True"
                      IsReadOnly="True"
                      KeyboardNavigation.TabIndex="470"
                      ItemsSource="{Binding Members}"
                      SelectedItem="{Binding SelectedMember, Mode=TwoWay}"
                      SelectionChanged="OnMemberSelectionChanged"
                      SelectionMode="Single"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
                        <Setter Property="automation:AutomationProperties.Name" Value="{Binding Path, StringFormat='Duplicate copy {0}; select to reveal decisions and path actions'}" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="*" Header="Copies in selected set">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="3,4"
                                            automation:AutomationProperties.Name="{Binding Path, StringFormat='Copy location {0}'}">
                                    <TextBlock FontWeight="SemiBold"
                                               automation:AutomationProperties.Name="{Binding RelativePath, StringFormat='Relative path: {0}'}"
                                               automation:AutomationProperties.HelpText="{Binding Path, StringFormat='Complete path: {0}'}"
                                               Text="{Binding RelativePath}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Path}" />
                                    <TextBlock Margin="0,3,0,0"
                                               automation:AutomationProperties.Name="{Binding SelectedRoot, StringFormat='Selected root: {0}'}"
                                               Text="{Binding SelectedRoot}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SelectedRoot}" />
                                    <WrapPanel Margin="0,3,0,0">
                                        <TextBlock Text="{Binding Size, StringFormat=Size {0}}" />
                                        <TextBlock Margin="8,0,0,0" Text="{Binding Modified, StringFormat=Modified {0}}" />
                                        <TextBlock Margin="8,0,0,0" FontWeight="SemiBold" Text="{Binding Decision, StringFormat=Decision: {0}}" />
                                    </WrapPanel>
                                    <TextBlock Margin="0,3,0,0"
                                               automation:AutomationProperties.Name="{Binding LiveStateAutomationName}"
                                               Text="{Binding LiveState}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding LiveState}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Border x:Name="SelectedCopyPanel"
                    Grid.Row="2"
                    Margin="0,6,0,0"
                    Padding="10"
                    MaxHeight="100"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    DataContext="{Binding SelectedItem, ElementName=MembersGrid}"
                    automation:AutomationProperties.AutomationId="FileSelectedCopyPanel"
                    automation:AutomationProperties.Name="{Binding Path, StringFormat='Selected copy actions for {0}'}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ScrollViewer x:Name="SelectedCopyScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,0,8">
                                <Button x:Name="BackToCopiesButton"
                                        Margin="0,0,0,6"
                                        HorizontalAlignment="Left"
                                        KeyboardNavigation.TabIndex="475"
                                        automation:AutomationProperties.AutomationId="FileBackToCopies"
                                        automation:AutomationProperties.Name="Back to copies in the selected duplicate set"
                                        Click="OnBackToCopiesClick"
                                        Content="← Back to copies"
                                        Visibility="Collapsed" />
                                <TextBlock FontWeight="SemiBold" Text="Full path" />
                                <TextBox Margin="0,4,0,0"
                                         MaxHeight="88"
                                         IsReadOnly="True"
                                         IsReadOnlyCaretVisible="True"
                                         Text="{Binding Path, Mode=OneWay}"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled"
                                         automation:AutomationProperties.AutomationId="FileSelectedCopyPath"
                                         automation:AutomationProperties.Name="{Binding Path, StringFormat='Complete selected copy path: {0}'}" />
                                <WrapPanel Margin="0,8,0,0" automation:AutomationProperties.Name="Review decision for selected copy">
                                    <Button automation:AutomationProperties.Name="{Binding Path, StringFormat='Keep {0}; preserves this physical copy'}"
                                            IsEnabled="{Binding CanRecordCurrentDecision}"
                                            Command="{Binding DataContext.KeepMemberCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Content="Keep" />
                                    <Button Margin="6,0,0,0"
                                            automation:AutomationProperties.Name="{Binding Path, StringFormat='Mark {0} for removal; records intent only and does not delete'}"
                                            IsEnabled="{Binding CanRecordCurrentDecision}"
                                            Command="{Binding DataContext.RemoveMemberCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Content="Mark for removal" />
                                    <Button Margin="6,0,0,0"
                                            automation:AutomationProperties.Name="{Binding Path, StringFormat='Reset decision for {0} to undecided'}"
                                            IsEnabled="{Binding CanClearDecision}"
                                            Command="{Binding DataContext.UndecideMemberCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Content="Reset decision" />
                                </WrapPanel>
                                <WrapPanel Margin="0,6,0,0" automation:AutomationProperties.Name="Path actions for selected copy">
                                    <Button automation:AutomationProperties.Name="{Binding Path, StringFormat='Copy complete path for {0}'}"
                                            Command="{Binding DataContext.CopyPathCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Content="Copy path" />
                                    <Button Margin="6,0,0,0"
                                            automation:AutomationProperties.Name="{Binding Path, StringFormat='Show {0} in Explorer'}"
                                            Command="{Binding DataContext.RevealInExplorerCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Content="Show in Explorer" />
                                </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <ScrollViewer x:Name="DetailCommandRegion"
                          Grid.Row="3"
                          MaxHeight="32"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock automation:AutomationProperties.AutomationId="FileDetailError"
                               automation:AutomationProperties.LiveSetting="Assertive"
                               automation:AutomationProperties.Name="{Binding DetailErrorMessage, StringFormat='Duplicate-file detail error: {0}'}"
                               accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding SelectedSetErrorAnnouncementVersion}"
                               accessibility:AutomationNotificationBehavior.NotificationKind="ActionAborted"
                               accessibility:AutomationNotificationBehavior.NotificationProcessing="ImportantMostRecent"
                               accessibility:AutomationNotificationBehavior.ActivityId="DuplicateFileMemberQuery"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="{Binding DetailErrorMessage}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasDetailError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock automation:AutomationProperties.AutomationId="FileLiveValidationStatus"
                               automation:AutomationProperties.LiveSetting="Polite"
                               automation:AutomationProperties.Name="{Binding LiveValidationStatusMessage}"
                               accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding SelectedSetStatusAnnouncementVersion}"
                               accessibility:AutomationNotificationBehavior.NotificationKind="ActionCompleted"
                               accessibility:AutomationNotificationBehavior.NotificationProcessing="MostRecent"
                               accessibility:AutomationNotificationBehavior.ActivityId="DuplicateFileLiveValidation"
                               Text="{Binding LiveValidationStatusMessage}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasLiveValidationStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock automation:AutomationProperties.AutomationId="FileLiveValidationError"
                               automation:AutomationProperties.LiveSetting="Assertive"
                               automation:AutomationProperties.Name="{Binding LiveValidationErrorMessage}"
                               accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding SelectedSetErrorAnnouncementVersion}"
                               accessibility:AutomationNotificationBehavior.NotificationKind="ActionAborted"
                               accessibility:AutomationNotificationBehavior.NotificationProcessing="ImportantMostRecent"
                               accessibility:AutomationNotificationBehavior.ActivityId="DuplicateFileLiveValidation"
                               Text="{Binding LiveValidationErrorMessage}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasLiveValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
                <WrapPanel automation:AutomationProperties.Name="Duplicate file member paging">
                    <Button x:Name="ValidateFilePageButton"
                            Margin="0,0,8,0"
                            KeyboardNavigation.TabIndex="480"
                            automation:AutomationProperties.AccessKey="Alt+V"
                            automation:AutomationProperties.AutomationId="FileValidateVisiblePage"
                            automation:AutomationProperties.Name="Validate selected duplicate set or visible copy page; access key Alt+V; focus returns to the visible copy comparison"
                            automation:AutomationProperties.HelpText="Validates at most 200 explicitly bound visible copies and never follows a page cursor or reads excluded cloud placeholders."
                            Click="OnValidateFilePageClick"
                            Content="_Validate page"
                            IsEnabled="{Binding CanValidateVisiblePage}" />
                    <Button Margin="0,0,8,0"
                            KeyboardNavigation.TabIndex="490"
                            automation:AutomationProperties.AutomationId="FileCancelValidation"
                            automation:AutomationProperties.Name="Cancel visible-page validation"
                            Command="{Binding CancelLiveValidationCommand}"
                            Content="Cancel validation" />
                    <Button
                            KeyboardNavigation.TabIndex="500"
                            automation:AutomationProperties.AutomationId="FilePreviousMemberPage"
                            automation:AutomationProperties.Name="Previous selected-set member page"
                            Command="{Binding PreviousMemberPageCommand}"
                            Content="Previous copies" />
                    <Button Margin="8,0,0,0"
                            KeyboardNavigation.TabIndex="510"
                            automation:AutomationProperties.AutomationId="FileNextMemberPage"
                            automation:AutomationProperties.Name="Next selected-set member page"
                            Command="{Binding NextMemberPageCommand}"
                            Content="Next copies" />
                </WrapPanel>
            </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    automation:AutomationProperties.Name="Loading selected duplicate set members"
                    automation:AutomationProperties.LiveSetting="Polite"
                    Visibility="{Binding IsDetailLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="130" Height="4" IsIndeterminate="True" />
                    <TextBlock Margin="0,8,0,0" Text="Loading group members…" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        automation:AutomationProperties.Name="No copies to display for the selected duplicate set"
                        automation:AutomationProperties.LiveSetting="Polite"
                        Visibility="{Binding IsDetailEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource SectionTitle}" Text="No copies to display" />
                <TextBlock Margin="0,5,0,0" Text="This group no longer has visible members." />
            </StackPanel>
        </Grid>
    </Grid>
    </Grid>
    </Grid>
</UserControl>
