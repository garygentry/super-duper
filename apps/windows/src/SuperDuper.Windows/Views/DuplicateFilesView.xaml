<UserControl x:Class="SuperDuper.Windows.Views.DuplicateFilesView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:accessibility="clr-namespace:SuperDuper.Windows.Accessibility">
    <!-- The collapsed query header stays compact while the results workspace receives the
         remaining height. Advanced query/rule content scrolls in its own bounded region. -->
    <Grid x:Name="FileWorkspaceRoot" SizeChanged="OnWorkspaceSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="24,8,24,4" KeyboardNavigation.TabNavigation="Continue">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <DockPanel MinWidth="180" VerticalAlignment="Bottom">
                <Label DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" Padding="0,0,0,3" Target="{Binding ElementName=FileSearch}" Content="Path _search"/>
                                    <TextBox x:Name="FileSearch"
                             VerticalContentAlignment="Center"
                             KeyboardNavigation.TabIndex="10"
                             automation:AutomationProperties.Name="Path search"
                             automation:AutomationProperties.HelpText="Enter a complete immutable member path when Exact path is checked; otherwise performs a case-insensitive literal substring search with a 512-character maximum"
                             automation:AutomationProperties.AutomationId="FileSearch"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="OnFilterEditorKeyDown" HorizontalScrollBarVisibility="Auto" ToolTip="Search duplicate file paths" />

            </DockPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="8,0,0,0">
                                <Button x:Name="FileApplyFilters"
                        automation:AutomationProperties.AutomationId="FileApplyFilters"
                        Margin="8,0,0,0"
                        KeyboardNavigation.TabIndex="20"
                        automation:AutomationProperties.Name="Apply duplicate file filters"
                        Command="{Binding ApplyFiltersCommand}"
                        Content="_Apply" />
                <ToggleButton x:Name="FileFiltersToggle" KeyboardNavigation.TabIndex="25" Content="_Filters" Margin="8,0,0,0"
                    automation:AutomationProperties.AutomationId="FileFiltersToggle"
                    automation:AutomationProperties.Name="Show or hide draft file filters"
                    IsChecked="{Binding IsExpanded, ElementName=FileFiltersExpander, Mode=TwoWay}"/>
                                    <Button Margin="8,0,0,0"
                            KeyboardNavigation.TabIndex="30"
                            automation:AutomationProperties.AutomationId="FileClearFilters"
                            automation:AutomationProperties.Name="Clear all duplicate file filters"
                            Command="{Binding ClearFiltersCommand}"
                            Content="Clear filters" />
            </WrapPanel>
        </Grid>
        <TextBlock Margin="0,4,0,4" TextWrapping="Wrap" Text="{Binding QueryEditorStatus}"
            Visibility="{Binding HasQueryEditorNotice, Converter={StaticResource BooleanToVisibilityConverter}}"
            automation:AutomationProperties.AutomationId="FileQueryEditorStatus"/>
        <UniformGrid Columns="3" automation:AutomationProperties.AutomationId="FileReviewSummary"
            automation:AutomationProperties.Name="Filtered duplicate file results">
            <WrapPanel Margin="0,0,8,0">
                <TextBlock Text="Sets: " VerticalAlignment="Center"/>
                <TextBlock Text="{Binding FilteredSetsText}" FontWeight="SemiBold" VerticalAlignment="Center"
                    automation:AutomationProperties.AutomationId="FileSummaryMatchingSets" automation:AutomationProperties.LiveSetting="Polite"
                    automation:AutomationProperties.Name="{Binding FilteredSetsText, StringFormat='Filtered sets: {0}'}"/></WrapPanel>
            <WrapPanel Margin="0,0,8,0">
                <TextBlock Text="Copies: " VerticalAlignment="Center"/>
                <TextBlock Text="{Binding FilteredCopiesText}" FontWeight="SemiBold" VerticalAlignment="Center"
                    automation:AutomationProperties.AutomationId="FileSummaryMatchingCopies" automation:AutomationProperties.LiveSetting="Polite"
                    automation:AutomationProperties.Name="{Binding FilteredCopiesText, StringFormat='Filtered copies: {0}'}"/></WrapPanel>
            <WrapPanel Margin="0,0,8,0">
                <TextBlock Text="Potential savings: " VerticalAlignment="Center"/>
                <TextBlock Text="{Binding FilteredSavingsText}" FontWeight="SemiBold" VerticalAlignment="Center"
                    automation:AutomationProperties.AutomationId="FileSummaryRecoverable" automation:AutomationProperties.LiveSetting="Polite"
                    automation:AutomationProperties.Name="{Binding FilteredSavingsText, StringFormat='Filtered potential savings: {0}'}" ToolTip="{Binding FilteredSavingsExactText}"/></WrapPanel>
        </UniformGrid>
        <ScrollViewer MaxHeight="40" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding AppliedFilters}" automation:AutomationProperties.Name="Applied file filters">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Button KeyboardNavigation.TabIndex="35" Margin="0,4,6,0" MaxWidth="280" ToolTip="{Binding Text}"
                        automation:AutomationProperties.Name="{Binding AutomationName}"
                        Click="OnRemoveFilterClick" Tag="{Binding}">
                        <DockPanel><TextBlock DockPanel.Dock="Right" Text=" ×"/>
                            <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis"/></DockPanel>
                    </Button>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </StackPanel>
    <Grid Grid.Row="1" Margin="24,8,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="WorkspaceScrollViewer"
                      Grid.Row="0"
                      MaxHeight="250"
                      automation:AutomationProperties.AutomationId="FileWorkspaceScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Expander x:Name="FileFiltersExpander" Margin="0,0,0,0"
                      automation:AutomationProperties.AutomationId="FileFiltersExpander"
                      Header="Filters" IsExpanded="False" PreviewKeyDown="OnFilterEditorKeyDown" Collapsed="OnFiltersCollapsed"
                      Visibility="{Binding IsExpanded, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
            <WrapPanel Margin="0,10,0,0"
                       VerticalAlignment="Center"
                       automation:AutomationProperties.Name="Primary duplicate file filter controls">
                    <CheckBox x:Name="FileExactPathMatch"
                              Margin="0,5,0,0"
                              KeyboardNavigation.TabIndex="40"
                              automation:AutomationProperties.AutomationId="FileExactPathMatch"
                              automation:AutomationProperties.Name="Match the complete canonical member path"
                              automation:AutomationProperties.HelpText="Uses locale-independent Unicode case normalization and the immutable canonical path; clear this option to restore literal substring search"
                              Content="Exact path"
                              IsChecked="{Binding ExactPathMatch}"
                              ToolTip="Match one complete canonical member path" />
                <StackPanel Width="145" Margin="0,0,8,0">
                    <Label Padding="0,0,0,3"
                           Target="{Binding ElementName=FileMinimumSize}"
                           Content="_Minimum size" />
                    <TextBox x:Name="FileMinimumSize"
                             Width="145"
                             VerticalContentAlignment="Center"
                             KeyboardNavigation.TabIndex="50"
                             automation:AutomationProperties.Name="Minimum one-copy file size"
                             automation:AutomationProperties.HelpText="Converts exactly to a non-negative whole number of bytes applied to one-copy file size; GiB (1,073,741,824 bytes). Use a decimal point for fractions"
                             automation:AutomationProperties.AutomationId="FileMinimumSize"
                             Text="{Binding MinimumSizeText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Minimum one-copy file size" />
                    <Label Content="Size _unit" Target="{Binding ElementName=FileSizeUnit}" Padding="0,4,0,3"/>
                    <ComboBox x:Name="FileSizeUnit" KeyboardNavigation.TabIndex="55" ItemsSource="{Binding SizeUnits}" SelectedItem="{Binding MinimumSizeUnit}"
                        automation:AutomationProperties.AutomationId="FileSizeUnit" automation:AutomationProperties.Name="Minimum size unit"
                        automation:AutomationProperties.HelpText="Binary units: KiB = 1,024 bytes; MiB = 1,048,576 bytes; GiB = 1,073,741,824 bytes; TiB = 1,099,511,627,776 bytes"/>
                </StackPanel>
                <CheckBox x:Name="FileOneGigabyteOrLarger"
                          Margin="10,0,2,0"
                          VerticalAlignment="Center"
                          KeyboardNavigation.TabIndex="60"
                          automation:AutomationProperties.AutomationId="FileOneGigabyteOrLarger"
                          automation:AutomationProperties.Name="Show only duplicate sets whose one-copy size is at least 1 GiB, 1,073,741,824 bytes"
                          Content="1 GiB or larger"
                          IsChecked="{Binding OneGigabyteOrLarger}"
                          ToolTip="One-copy size of at least 1 GiB (1,073,741,824 bytes)" />
                <CheckBox x:Name="FileThreeOrMoreCopies"
                          Margin="10,0,2,0"
                          VerticalAlignment="Center"
                          KeyboardNavigation.TabIndex="70"
                          automation:AutomationProperties.AutomationId="FileThreeOrMoreCopies"
                          automation:AutomationProperties.Name="Show only duplicate sets with three or more copies"
                          Content="Three or more copies"
                          IsChecked="{Binding ThreeOrMoreCopies}" />
                <CheckBox x:Name="FileAcrossDrives"
                          Margin="10,0,2,0"
                          VerticalAlignment="Center"
                          KeyboardNavigation.TabIndex="80"
                          automation:AutomationProperties.AutomationId="FileAcrossDrives"
                          automation:AutomationProperties.Name="Show only duplicate sets across multiple drives"
                          Content="Across drives"
                          IsChecked="{Binding AcrossDrives}" />

            </WrapPanel>
            <WrapPanel Margin="0,10,0,0"
                       VerticalAlignment="Center"
                       automation:AutomationProperties.Name="Filename extension filter controls">
                <Label Margin="0,0,8,0"
                       Padding="0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Target="{Binding ElementName=FileExtension}"
                       Content="_Extension" />
                <TextBox x:Name="FileExtension"
                         Width="145"
                         VerticalContentAlignment="Center"
                         KeyboardNavigation.TabIndex="90"
                         automation:AutomationProperties.AutomationId="FileExtension"
                         automation:AutomationProperties.Name="Filename extension without the dot"
                         automation:AutomationProperties.HelpText="Matches any immutable member's final filename extension by default; use All copies must match to require every immutable member. This is not the representative label or a file-type classification"
                         Text="{Binding ExtensionText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Final filename extension without the dot; for example jpg" />
                <CheckBox x:Name="FileWithoutExtension"
                          Margin="10,0,0,0"
                          VerticalAlignment="Center"
                          KeyboardNavigation.TabIndex="100"
                          automation:AutomationProperties.AutomationId="FileWithoutExtension"
                          automation:AutomationProperties.Name="Use no filename extension as the extension filter value"
                          automation:AutomationProperties.HelpText="Overrides the extension box; filenames with no dot, a terminal dot, or only a leading dot are treated as having no extension. Any member matches by default; All copies must match changes this to every member"
                          Content="No extension"
                          IsChecked="{Binding WithoutExtension}"
                          ToolTip="Use no filename extension as the requested value" />
                <CheckBox x:Name="FileAllExtensionsMatch"
                          Margin="10,0,0,0"
                          VerticalAlignment="Center"
                          KeyboardNavigation.TabIndex="110"
                          automation:AutomationProperties.AutomationId="FileAllExtensionsMatch"
                          automation:AutomationProperties.Name="Require every copy in a duplicate set to match the filename extension filter"
                          automation:AutomationProperties.HelpText="Every immutable member must have the requested filename extension, or no extension when No extension is selected; filename extension remains distinct from file type"
                          Content="All copies must match"
                          IsChecked="{Binding AllMembersMustMatchExtension}"
                          ToolTip="Require every immutable member to match the extension value" />
            </WrapPanel>
            <WrapPanel Margin="0,10,0,0"
                       VerticalAlignment="Center"
                       automation:AutomationProperties.Name="Selected-root facet controls">
                <Label Margin="0,0,8,0"
                       Padding="0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Target="{Binding ElementName=FileSelectedRootFacet}"
                       Content="Selected _root" />
                <ComboBox x:Name="FileSelectedRootFacet"
                          Width="360"
                          MaxDropDownHeight="280"
                          VerticalContentAlignment="Center"
                          KeyboardNavigation.TabIndex="120"
                          automation:AutomationProperties.AutomationId="FileSelectedRootFacet"
                          automation:AutomationProperties.Name="Selected root facet; choose All selected roots to remove this filter"
                          DisplayMemberPath="DisplayText"
                          ItemsSource="{Binding SelectedRootFacetOptions}"
                          SelectedItem="{Binding SelectedRootFacet, Mode=TwoWay}">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
                            <Setter Property="automation:AutomationProperties.Name" Value="{Binding DisplayText}" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                <StackPanel Margin="8,0,0,0">
                    <Label Content="Root order" Target="{Binding ElementName=FileRootFacetSort}" Padding="0,0,0,3"/>
                    <ComboBox x:Name="FileRootFacetSort" KeyboardNavigation.TabIndex="129" Width="150" SelectedIndex="{Binding RootFacetSortIndex}"
                        automation:AutomationProperties.AutomationId="FileRootFacetSort" automation:AutomationProperties.Name="Root facet sort order">
                        <ComboBoxItem Content="Most sets first"/><ComboBoxItem Content="Name A–Z"/>
                    </ComboBox>
                </StackPanel>
                <Button Margin="8,0,0,0"
                        Style="{StaticResource ShellIconAction}"
                        KeyboardNavigation.TabIndex="130"
                        automation:AutomationProperties.AutomationId="FilePreviousRootFacets"
                        automation:AutomationProperties.Name="Previous selected-root facet page"
                        Command="{Binding PreviousRootFacetPageCommand}"
                        ToolTip="Previous roots">
                    <Path Data="{StaticResource ShellIconChevronLeft}" Style="{StaticResource ShellActionIcon}" />
                </Button>
                <Button Margin="6,0,0,0"
                        Style="{StaticResource ShellIconAction}"
                        KeyboardNavigation.TabIndex="140"
                        automation:AutomationProperties.AutomationId="FileNextRootFacets"
                        automation:AutomationProperties.Name="Next selected-root facet page"
                        Command="{Binding NextRootFacetPageCommand}"
                        ToolTip="Next roots">
                    <Path Data="{StaticResource ShellIconChevronRight}" Style="{StaticResource ShellActionIcon}" />
                </Button>
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           automation:AutomationProperties.AutomationId="FileRootFacetCount"
                           automation:AutomationProperties.LiveSetting="Polite"
                           automation:AutomationProperties.Name="{Binding RootFacetStatusAnnouncement}"
                           accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding RootFacetStatusAnnouncementVersion}"
                           accessibility:AutomationNotificationBehavior.NotificationKind="ActionCompleted"
                           accessibility:AutomationNotificationBehavior.NotificationProcessing="MostRecent"
                           accessibility:AutomationNotificationBehavior.ActivityId="DuplicateFileSelectedRootFacetQuery"
                           Text="{Binding RootFacetCountText}" />
                <ProgressBar Width="70"
                             Height="4"
                             Margin="10,0,0,0"
                             automation:AutomationProperties.Name="Loading selected-root facets"
                             IsIndeterminate="True"
                             Visibility="{Binding IsRootFacetLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           automation:AutomationProperties.AutomationId="FileRootFacetError"
                           automation:AutomationProperties.LiveSetting="Assertive"
                           automation:AutomationProperties.Name="{Binding RootFacetErrorMessage, StringFormat='Selected-root facet error: {0}'}"
                           accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding RootFacetErrorAnnouncementVersion}"
                           accessibility:AutomationNotificationBehavior.NotificationKind="ActionAborted"
                           accessibility:AutomationNotificationBehavior.NotificationProcessing="ImportantMostRecent"
                           accessibility:AutomationNotificationBehavior.ActivityId="DuplicateFileSelectedRootFacetQuery"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{Binding RootFacetErrorMessage}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasRootFacetError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           automation:AutomationProperties.AutomationId="FileSelectedRootFilterText"
                           automation:AutomationProperties.LiveSetting="Polite"
                           automation:AutomationProperties.Name="{Binding SelectedRootFilterText, StringFormat='Selected-root filter status: {0}'}"
                           Text="{Binding SelectedRootFilterText}"
                           TextTrimming="CharacterEllipsis" />
            </WrapPanel>
            <WrapPanel Margin="0,8,0,0"
                       VerticalAlignment="Center"
                       automation:AutomationProperties.Name="Drive facet controls">
                <Label Margin="0,0,8,0"
                       Padding="0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Target="{Binding ElementName=FileDriveFacet}"
                       Content="_Drive" />
                <ComboBox x:Name="FileDriveFacet"
                          Width="220"
                          MaxDropDownHeight="280"
                          VerticalContentAlignment="Center"
                          KeyboardNavigation.TabIndex="150"
                          automation:AutomationProperties.AutomationId="FileDriveFacet"
                          automation:AutomationProperties.Name="Drive facet; choose All drives to remove this filter"
                          DisplayMemberPath="DisplayText"
                          ItemsSource="{Binding DriveFacetOptions}"
                          SelectedItem="{Binding SelectedDriveFacet, Mode=TwoWay}">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
                            <Setter Property="automation:AutomationProperties.Name" Value="{Binding DisplayText}" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                <StackPanel Margin="8,0,0,0">
                    <Label Content="Drive order" Target="{Binding ElementName=FileDriveFacetSort}" Padding="0,0,0,3"/>
                    <ComboBox x:Name="FileDriveFacetSort" KeyboardNavigation.TabIndex="159" Width="150" SelectedIndex="{Binding DriveFacetSortIndex}"
                        automation:AutomationProperties.AutomationId="FileDriveFacetSort" automation:AutomationProperties.Name="Drive facet sort order">
                        <ComboBoxItem Content="Most sets first"/><ComboBoxItem Content="Name A–Z"/>
                    </ComboBox>
                </StackPanel>
                <Button Margin="8,0,0,0"
                        Style="{StaticResource ShellIconAction}"
                        KeyboardNavigation.TabIndex="160"
                        automation:AutomationProperties.AutomationId="FilePreviousDriveFacets"
                        automation:AutomationProperties.Name="Previous drive facet page"
                        Command="{Binding PreviousDriveFacetPageCommand}"
                        ToolTip="Previous drives">
                    <Path Data="{StaticResource ShellIconChevronLeft}" Style="{StaticResource ShellActionIcon}" />
                </Button>
                <Button Margin="6,0,0,0"
                        Style="{StaticResource ShellIconAction}"
                        KeyboardNavigation.TabIndex="170"
                        automation:AutomationProperties.AutomationId="FileNextDriveFacets"
                        automation:AutomationProperties.Name="Next drive facet page"
                        Command="{Binding NextDriveFacetPageCommand}"
                        ToolTip="Next drives">
                    <Path Data="{StaticResource ShellIconChevronRight}" Style="{StaticResource ShellActionIcon}" />
                </Button>
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           automation:AutomationProperties.AutomationId="FileDriveFacetCount"
                           automation:AutomationProperties.LiveSetting="Polite"
                           automation:AutomationProperties.Name="{Binding DriveFacetStatusAnnouncement}"
                           accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding DriveFacetStatusAnnouncementVersion}"
                           accessibility:AutomationNotificationBehavior.NotificationKind="ActionCompleted"
                           accessibility:AutomationNotificationBehavior.NotificationProcessing="MostRecent"
                           accessibility:AutomationNotificationBehavior.ActivityId="DuplicateFileDriveFacetQuery"
                           Text="{Binding DriveFacetCountText}" />
                <ProgressBar Width="70"
                             Height="4"
                             Margin="10,0,0,0"
                             automation:AutomationProperties.Name="Loading drive facets"
                             IsIndeterminate="True"
                             Visibility="{Binding IsDriveFacetLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           automation:AutomationProperties.AutomationId="FileDriveFacetError"
                           automation:AutomationProperties.LiveSetting="Assertive"
                           automation:AutomationProperties.Name="{Binding DriveFacetErrorMessage, StringFormat='Drive facet error: {0}'}"
                           accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding DriveFacetErrorAnnouncementVersion}"
                           accessibility:AutomationNotificationBehavior.NotificationKind="ActionAborted"
                           accessibility:AutomationNotificationBehavior.NotificationProcessing="ImportantMostRecent"
                           accessibility:AutomationNotificationBehavior.ActivityId="DuplicateFileDriveFacetQuery"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{Binding DriveFacetErrorMessage}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasDriveFacetError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           automation:AutomationProperties.AutomationId="FileSelectedDriveFilterText"
                           automation:AutomationProperties.LiveSetting="Polite"
                           automation:AutomationProperties.Name="{Binding SelectedDriveFilterText, StringFormat='Drive filter status: {0}'}"
                           Text="{Binding SelectedDriveFilterText}"
                           TextTrimming="CharacterEllipsis" />
            </WrapPanel>
            <Expander x:Name="FileTotalsExpander" Header="Location coverage and largest opportunity" IsExpanded="False"
                      automation:AutomationProperties.AutomationId="FileTotalsExpander">
                <StackPanel>
                <Border Margin="6,0,0,0" Padding="12,9" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="Largest opportunity" />
                        <TextBlock automation:AutomationProperties.AutomationId="FileSummaryLargestOpportunity"
                                   automation:AutomationProperties.LiveSetting="Polite"
                                   automation:AutomationProperties.Name="{Binding LargestOpportunityText, StringFormat='Largest recoverable opportunity: {0}'}"
                                   Style="{StaticResource SectionTitle}"
                                   Text="{Binding LargestOpportunityText}" />
                    </StackPanel>
                </Border>

            <Border Margin="0,8,0,0"
                    Padding="12,8"
                    automation:AutomationProperties.AutomationId="FileLocationSummary"
                    automation:AutomationProperties.Name="Duplicate file location coverage"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,0,8,0" FontWeight="SemiBold" Text="Location coverage" />
                    <TextBlock Grid.Column="1"
                               automation:AutomationProperties.AutomationId="FileLocationSummaryText"
                               automation:AutomationProperties.LiveSetting="Polite"
                               automation:AutomationProperties.Name="{Binding LocationCoverageText, StringFormat='Location coverage: {0}'}"
                               Text="{Binding LocationCoverageText}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>
                </StackPanel>
            </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Expander>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1">
            <Border Margin="0,0,0,10"
                    Padding="12,9"
                    BorderBrush="{DynamicResource TextFillColorPrimaryBrush}"
                    BorderThickness="2"
                    CornerRadius="6"
                    Visibility="{Binding HasDirtyRoots, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0" Orientation="Horizontal">
                        <Button x:Name="ReconcileDirtyRootButton"
                                KeyboardNavigation.TabIndex="400"
                                automation:AutomationProperties.AccessKey="Alt+X"
                                automation:AutomationProperties.AutomationId="FileReconcileDirtyRoot"
                                automation:AutomationProperties.Name="Reconcile next bounded dirty-root batch; access key Alt+X; focus returns to the visible copy comparison"
                                automation:AutomationProperties.HelpText="Checks at most 200 server-owned duplicate copies for one durable dirty root. It does not bind full results, follow watcher events, or change immutable scan history."
                                Click="OnReconcileDirtyRootClick"
                                Content="Reconcile ne_xt batch"
                                IsEnabled="{Binding CanReconcileDirtyRoot}" />
                        <Button Margin="8,0,0,0"
                                KeyboardNavigation.TabIndex="410"
                                automation:AutomationProperties.AutomationId="FileCancelDirtyRootReconciliation"
                                automation:AutomationProperties.Name="Cancel bounded dirty-root reconciliation"
                                Command="{Binding CancelDirtyRootReconciliationCommand}"
                                Content="Cancel reconciliation" />
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center"
                               automation:AutomationProperties.AutomationId="FileDirtyRootWarning"
                               automation:AutomationProperties.LiveSetting="Assertive"
                               automation:AutomationProperties.Name="{Binding DirtyRootWarningMessage}"
                               FontWeight="SemiBold"
                               Text="{Binding DirtyRootWarningMessage}"
                               TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <TextBlock Margin="0,0,0,8"
                       automation:AutomationProperties.AutomationId="FileDirtyRootStatus"
                       automation:AutomationProperties.LiveSetting="Polite"
                       automation:AutomationProperties.Name="{Binding DirtyRootStatusMessage}"
                       accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding DirtyRootStatusAnnouncementVersion}"
                       accessibility:AutomationNotificationBehavior.NotificationKind="ActionCompleted"
                       accessibility:AutomationNotificationBehavior.NotificationProcessing="MostRecent"
                       accessibility:AutomationNotificationBehavior.ActivityId="DuplicateFileDirtyRootReconciliation"
                       Text="{Binding DirtyRootStatusMessage}"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasDirtyRootStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Margin="0,0,0,8"
                       automation:AutomationProperties.AutomationId="FileDirtyRootError"
                       automation:AutomationProperties.LiveSetting="Assertive"
                       automation:AutomationProperties.Name="{Binding DirtyRootErrorMessage}"
                       accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding DirtyRootErrorAnnouncementVersion}"
                       accessibility:AutomationNotificationBehavior.NotificationKind="ActionAborted"
                       accessibility:AutomationNotificationBehavior.NotificationProcessing="ImportantMostRecent"
                       accessibility:AutomationNotificationBehavior.ActivityId="DuplicateFileDirtyRootReconciliation"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Text="{Binding DirtyRootErrorMessage}"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasDirtyRootError, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Margin="0,0,0,8"
                       automation:AutomationProperties.AutomationId="FileLiveHintStatus"
                       automation:AutomationProperties.LiveSetting="Polite"
                       automation:AutomationProperties.Name="{Binding LiveHintStatusMessage}"
                       accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding LiveHintAnnouncementVersion}"
                       accessibility:AutomationNotificationBehavior.NotificationKind="ActionCompleted"
                       accessibility:AutomationNotificationBehavior.NotificationProcessing="MostRecent"
                       accessibility:AutomationNotificationBehavior.ActivityId="DuplicateFileLiveHints"
                       Text="{Binding LiveHintStatusMessage}"
                       TextWrapping="Wrap"
