<UserControl x:Class="SuperDuper.Windows.Views.DuplicateFoldersView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:accessibility="clr-namespace:SuperDuper.Windows.Accessibility">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <StackPanel>
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="Exact duplicate folders" />
                <TextBlock Margin="0,4,0,0"
                           Opacity="0.68"
                           Text="Root names may differ. Nested matches covered by a larger exact root are suppressed."
                           TextWrapping="Wrap" />
            </StackPanel>
            <WrapPanel Margin="0,10,0,0"
                       VerticalAlignment="Center"
                       automation:AutomationProperties.Name="Exact duplicate folder filter controls">
                <TextBox x:Name="FolderSearch" Width="170" Margin="0,0,8,0" VerticalContentAlignment="Center"
                         automation:AutomationProperties.AutomationId="FolderSearch"
                         automation:AutomationProperties.Name="Folder path search"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search duplicate folder paths" />
                <TextBox x:Name="FolderMinimumSize" Width="145" Margin="0,0,8,0" VerticalContentAlignment="Center"
                         automation:AutomationProperties.AutomationId="FolderMinimumSize"
                         automation:AutomationProperties.Name="Minimum folder size in bytes"
                         Text="{Binding MinimumSizeText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Minimum folder size in bytes" />
                <Button x:Name="FolderApplyFilters" Padding="13,7"
                        automation:AutomationProperties.AutomationId="FolderApplyFilters"
                        Command="{Binding ApplyFiltersCommand}" Content="Apply filters" />
            </WrapPanel>
            <TextBlock Margin="0,8,0,0"
                       Opacity="0.78"
                       automation:AutomationProperties.AutomationId="FolderCombinedReviewSummary"
                       automation:AutomationProperties.LiveSetting="Polite"
                       Text="{Binding ReviewPlanSummaryText}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DataGrid x:Name="GroupsGrid" AutoGenerateColumns="False" CanUserSortColumns="True"
                      automation:AutomationProperties.AutomationId="FolderGroupsGrid"
                      automation:AutomationProperties.Name="Exact duplicate folder groups"
                      EnableColumnVirtualization="True" EnableRowVirtualization="True" IsReadOnly="True"
                      ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                      SelectionMode="Single" Sorting="OnGroupsSorting"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="*" MinWidth="300" Header="Representative folder" SortMemberPath="RepresentativePath" Binding="{Binding RepresentativePath}" />
                    <DataGridTextColumn Width="125" Header="Copies" SortMemberPath="CopyCount" Binding="{Binding CopyCount}" />
                    <DataGridTextColumn Width="155" Header="Descendant files" SortMemberPath="FileCount" Binding="{Binding DescendantFileCount}" />
                    <DataGridTextColumn Width="140" Header="Total bytes" SortMemberPath="TotalBytes" SortDirection="Descending" Binding="{Binding TotalBytes}" />
                </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="1" Margin="0,9,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Opacity="0.68"
                           automation:AutomationProperties.AutomationId="FolderGroupCount"
                           automation:AutomationProperties.LiveSetting="Polite"
                           automation:AutomationProperties.Name="{Binding GroupStatusAnnouncement}"
                           accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding GroupStatusAnnouncementVersion}"
                           accessibility:AutomationNotificationBehavior.NotificationKind="ActionCompleted"
                           accessibility:AutomationNotificationBehavior.NotificationProcessing="MostRecent"
                           accessibility:AutomationNotificationBehavior.ActivityId="DuplicateFolderGroupQuery"
                           Text="{Binding GroupCountText}" />
                <StackPanel Grid.Column="1" automation:AutomationProperties.Name="Duplicate folder group paging" Orientation="Horizontal">
                    <Button Padding="10,4" Command="{Binding PreviousPageCommand}" Content="Previous" />
                    <Button Margin="8,0,0,0" Padding="10,4" Command="{Binding NextPageCommand}" Content="Next" />
                    <Button Margin="8,0,0,0" Padding="10,4" Command="{Binding ClearFiltersCommand}" Content="Clear filters" />
                </StackPanel>
            </Grid>
            <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" Opacity="0.94"
                    Visibility="{Binding IsLoadingOverlayVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="150" Height="4" IsIndeterminate="True" />
                    <TextBlock Margin="0,9,0,0" Opacity="0.7" Text="Loading duplicate folder groups…" />
                </StackPanel>
            </Border>
            <Border Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#C84B31" BorderThickness="1" CornerRadius="7"
                    automation:AutomationProperties.AutomationId="FolderGroupError"
                    automation:AutomationProperties.LiveSetting="Assertive"
                    automation:AutomationProperties.Name="{Binding GroupErrorAnnouncement}"
                    accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding GroupErrorAnnouncementVersion}"
                    accessibility:AutomationNotificationBehavior.NotificationKind="ActionAborted"
                    accessibility:AutomationNotificationBehavior.NotificationProcessing="ImportantMostRecent"
                    accessibility:AutomationNotificationBehavior.ActivityId="DuplicateFolderGroupQuery"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock MaxWidth="620" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="Results unavailable" />
                <TextBlock Margin="0,6,0,0" MaxWidth="560" Opacity="0.68" Text="{Binding StateMessage}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="No exact duplicate folders" />
                <TextBlock Margin="0,6,0,0" Opacity="0.68" Text="{Binding StateMessage}" />
            </StackPanel>
        </Grid>

        <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" ResizeDirection="Rows" />

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="Folder-copy locations" />
                    <TextBlock Margin="0,3,0,0"
                               Opacity="0.82"
                               automation:AutomationProperties.AutomationId="FolderRelationshipSummary"
                               automation:AutomationProperties.Name="Selected exact-folder relationship summary"
                               Text="{Binding SelectedRelationshipSummaryText}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,3,0,0"
                               Opacity="0.72"
                               automation:AutomationProperties.AutomationId="FolderSelectedReviewSummary"
                               automation:AutomationProperties.LiveSetting="Polite"
                               Text="{Binding SelectedReviewSummaryText}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Opacity="0.68"
                           automation:AutomationProperties.AutomationId="FolderMemberCount"
                           automation:AutomationProperties.LiveSetting="Polite"
                           automation:AutomationProperties.Name="{Binding MemberStatusAnnouncement}"
                           accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding MemberStatusAnnouncementVersion}"
                           accessibility:AutomationNotificationBehavior.NotificationKind="ActionCompleted"
                           accessibility:AutomationNotificationBehavior.NotificationProcessing="MostRecent"
                           accessibility:AutomationNotificationBehavior.ActivityId="DuplicateFolderMemberQuery"
                           Text="{Binding MemberPageStatusText}" />
            </Grid>
            <ListBox x:Name="LocationCards" Grid.Row="1"
                     automation:AutomationProperties.AutomationId="FolderLocationCards"
                     automation:AutomationProperties.Name="Side-by-side folder-copy location cards"
                     automation:AutomationProperties.HelpText="Use Left and Right Arrow, Home, and End to compare the bounded current page. Highlighted path segments differ among these visible copies."
                     ItemsSource="{Binding Members}"
                     SelectedItem="{Binding SelectedMember, Mode=TwoWay}"
                     SelectionMode="Single"
                     MouseDoubleClick="OnLocationCardsMouseDoubleClick"
                     PreviewKeyDown="OnLocationCardsPreviewKeyDown"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,10,0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="automation:AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
                        <Setter Property="automation:AutomationProperties.Name" Value="{Binding AutomationName}" />
                        <Setter Property="automation:AutomationProperties.HelpText" Value="Immutable folder-copy location card. The highlighted path segments differ from the other copies on this page." />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="LocationCardBorder"
                                Width="360"
                                Padding="14"
                                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding FolderName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" FontWeight="SemiBold" Text="{Binding Decision}" />
                                </Grid>
                                <TextBlock Margin="0,9,0,0" FontWeight="SemiBold" Text="Location" />
                                <TextBlock Margin="0,2,0,0" Text="{Binding ParentLocation}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,9,0,0" FontWeight="SemiBold" Text="Shared path context" />
                                <TextBlock Margin="0,2,0,0" Opacity="0.72" Text="{Binding SharedPathContext}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,9,0,3" FontWeight="SemiBold" Text="Differs here" />
                                <Border Padding="7,4"
                                        Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                                        CornerRadius="4">
                                    <TextBlock Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"
                                               FontWeight="SemiBold"
                                               Text="{Binding DifferingPathSegments}"
                                               TextWrapping="Wrap" />
                                </Border>
                                <TextBlock Margin="0,9,0,3" FontWeight="SemiBold" Text="Full immutable path" />
                                <TextBox Padding="5,3"
                                         automation:AutomationProperties.Name="{Binding FullPathAutomationName}"
                                         BorderThickness="1"
                                         HorizontalScrollBarVisibility="Auto"
                                         IsReadOnly="True"
                                         IsTabStop="False"
                                         Text="{Binding Path, Mode=OneWay}"
                                         TextWrapping="NoWrap" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Padding="7,2"
                                            automation:AutomationProperties.Name="{Binding KeepAutomationName}"
                                            automation:AutomationProperties.HelpText="Records a review choice only; it does not delete or validate the folder."
                                            Command="{Binding DataContext.KeepFolderCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Content="Keep" />
                                    <Button Margin="6,0,0,0" Padding="7,2"
                                            automation:AutomationProperties.Name="{Binding RemoveAutomationName}"
                                            automation:AutomationProperties.HelpText="Records a review choice only; it does not delete or validate the folder."
                                            Command="{Binding DataContext.RemoveFolderCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Content="Remove" />
                                    <Button Margin="6,0,0,0" Padding="7,2"
                                            automation:AutomationProperties.Name="{Binding UndecideAutomationName}"
                                            automation:AutomationProperties.HelpText="Returns this immutable folder copy to Undecided."
                                            Command="{Binding DataContext.UndecideFolderCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Content="Undecided" />
                                </WrapPanel>
                                <WrapPanel Margin="0,7,0,0">
                                    <Button Padding="7,2"
                                            automation:AutomationProperties.Name="{Binding CopyPathAutomationName}"
                                            Command="{Binding DataContext.CopyPathCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Content="Copy path" />
                                    <Button Margin="6,0,0,0" Padding="7,2"
                                            automation:AutomationProperties.AutomationId="{Binding RevealAutomationId}"
                                            automation:AutomationProperties.Name="{Binding RevealAutomationName}"
                                            automation:AutomationProperties.HelpText="Shows only this immutable-page folder copy. Press Alt+E from its selected location card for the same action."
                                            Click="OnRevealInExplorerClick"
                                            Content="Show in Explorer" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                <Setter TargetName="LocationCardBorder" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                <Setter TargetName="LocationCardBorder" Property="BorderThickness" Value="3" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                           Text="{Binding DetailErrorMessage}"
                           TextTrimming="CharacterEllipsis"
                           automation:AutomationProperties.AutomationId="FolderDetailError"
                           automation:AutomationProperties.LiveSetting="Assertive"
                           automation:AutomationProperties.Name="{Binding DetailErrorMessage, StringFormat='Exact-folder detail error: {0}'}"
                           accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding MemberErrorAnnouncementVersion}"
                           accessibility:AutomationNotificationBehavior.NotificationKind="ActionAborted"
                           accessibility:AutomationNotificationBehavior.NotificationProcessing="ImportantMostRecent"
                           accessibility:AutomationNotificationBehavior.ActivityId="DuplicateFolderMemberQuery"
                           Visibility="{Binding HasDetailError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                               Text="{Binding ExplorerStatusMessage}"
                               TextTrimming="CharacterEllipsis"
                               automation:AutomationProperties.AutomationId="FolderExplorerStatus"
                               automation:AutomationProperties.LiveSetting="Polite"
                               automation:AutomationProperties.Name="{Binding ExplorerStatusMessage}"
                               accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding ExplorerStatusAnnouncementVersion}"
                               accessibility:AutomationNotificationBehavior.NotificationKind="ActionCompleted"
                               accessibility:AutomationNotificationBehavior.NotificationProcessing="MostRecent"
                               accessibility:AutomationNotificationBehavior.ActivityId="DuplicateFolderExplorerCommand"
                               Visibility="{Binding HasExplorerStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                               Text="{Binding ExplorerErrorMessage}"
                               TextTrimming="CharacterEllipsis"
                               automation:AutomationProperties.AutomationId="FolderExplorerError"
                               automation:AutomationProperties.LiveSetting="Assertive"
                               automation:AutomationProperties.Name="{Binding ExplorerErrorMessage}"
                               accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding ExplorerErrorAnnouncementVersion}"
                               accessibility:AutomationNotificationBehavior.NotificationKind="ActionAborted"
                               accessibility:AutomationNotificationBehavior.NotificationProcessing="ImportantMostRecent"
                               accessibility:AutomationNotificationBehavior.ActivityId="DuplicateFolderExplorerCommand"
                               Visibility="{Binding HasExplorerError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" automation:AutomationProperties.Name="Duplicate folder member paging" Orientation="Horizontal">
                    <Button x:Name="PreviousFolderCardsButton" Padding="10,4"
                            automation:AutomationProperties.AutomationId="PreviousFolderCardsButton"
                            automation:AutomationProperties.Name="Previous folder-copy location page"
                            IsEnabled="{Binding CanMoveMembersPrevious}"
                            Click="OnFolderCardPageClick"
                            Content="Previous folders" />
                    <Button x:Name="NextFolderCardsButton" Margin="8,0,0,0" Padding="10,4"
                            automation:AutomationProperties.AutomationId="NextFolderCardsButton"
                            automation:AutomationProperties.Name="Next folder-copy location page"
                            IsEnabled="{Binding CanMoveMembersNext}"
                            Click="OnFolderCardPageClick"
                            Content="Next folders" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" Opacity="0.94"
                    Visibility="{Binding IsDetailLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="130" Height="4" IsIndeterminate="True" />
                    <TextBlock Margin="0,8,0,0" Opacity="0.68" Text="Loading duplicate roots…" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsDetailEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock FontSize="17" FontWeight="SemiBold" Text="No duplicate roots to display" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
