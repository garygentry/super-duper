<UserControl x:Class="SuperDuper.Windows.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:accessibility="clr-namespace:SuperDuper.Windows.Accessibility"
             automation:AutomationProperties.Name="Performance telemetry">
    <UserControl.Resources>
        <Style x:Key="PerformanceCard" TargetType="Border" BasedOn="{StaticResource SharedCard}" />
        <Style x:Key="SecondaryPerformanceText" TargetType="TextBlock" BasedOn="{StaticResource ShellBody}" />
    </UserControl.Resources>

    <ScrollViewer Margin="{StaticResource PageContentInset}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Focusable="False" automation:AutomationProperties.AutomationId="PerformanceScrollViewer">
        <StackPanel KeyboardNavigation.TabNavigation="Continue">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right" Margin="12,0,0,0">
                    <Button Command="{Binding RefreshCommand}" Content="_Refresh"
                            Style="{StaticResource ShellSecondaryAction}"
                            automation:AutomationProperties.AccessKey="Alt+R"
                            automation:AutomationProperties.AutomationId="RefreshPerformance"
                            automation:AutomationProperties.Name="Refresh bounded performance telemetry" />
                    <Button Margin="8,0,0,0" Command="{Binding ReturnCommand}" Content="{Binding ReturnLabel}"
                            Style="{StaticResource ShellSecondaryAction}"
                            automation:AutomationProperties.AutomationId="ReturnFromPerformance"
                            automation:AutomationProperties.Name="{Binding ReturnAutomationName}" />
                </WrapPanel>
                <StackPanel>
                    <TextBlock x:Name="PerformanceHeading" Style="{StaticResource PageTitle}"
                               Focusable="True" KeyboardNavigation.IsTabStop="False"
                               automation:AutomationProperties.AutomationId="PerformanceHeading"
                               Text="{Binding ContextHeading}" />
                    <TextBlock Margin="0,4,12,0" FontWeight="SemiBold" TextWrapping="Wrap"
                               automation:AutomationProperties.AutomationId="PerformanceRunIdentity"
                               Text="{Binding ContextIdentity}" />
                </StackPanel>
            </DockPanel>
            <Expander x:Name="PerformanceSnapshotDetails" Margin="0,8,0,0"
                      Header="About these measurements"
                      automation:AutomationProperties.AutomationId="PerformanceSnapshotDetails"
                      automation:AutomationProperties.Name="Performance snapshot details">
                <TextBlock Margin="0,8,0,0" Style="{StaticResource SecondaryPerformanceText}"
                           TextWrapping="Wrap"
                           automation:AutomationProperties.AutomationId="PerformanceSnapshotBoundary"
                           Text="{Binding SnapshotBoundary}" />
            </Expander>

            <TextBlock Margin="0,12,0,0" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                       automation:AutomationProperties.AutomationId="PerformanceStatus"
                       automation:AutomationProperties.Name="{Binding StatusMessage}"
                       accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding AnnouncementVersion}"
                       accessibility:AutomationNotificationBehavior.NotificationKind="ActionCompleted"
                       accessibility:AutomationNotificationBehavior.NotificationProcessing="MostRecent"
                       accessibility:AutomationNotificationBehavior.ActivityId="PerformanceRefresh" />
            <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"
                       automation:AutomationProperties.AutomationId="PerformanceError"
                       AutomationProperties.LiveSetting="Assertive" />

            <UniformGrid Columns="3" Margin="0,12,0,0">
                <Border Style="{StaticResource PerformanceCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SecondaryPerformanceText}" Text="Run health" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource SectionTitle}" Text="{Binding RunStatus}" />
                        <TextBlock Style="{StaticResource SecondaryPerformanceText}" Text="{Binding RunDuration, StringFormat='Duration {0}'}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PerformanceCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SecondaryPerformanceText}" Text="Full-read throughput" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource SectionTitle}" Text="{Binding FullReadThroughput}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PerformanceCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SecondaryPerformanceText}" Text="Warnings" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource SectionTitle}" Text="{Binding WarningSummary}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Margin="0,18,0,7" Style="{StaticResource SectionTitle}" Text="Phase durations" />
            <DataGrid MaxHeight="220" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding Phases}"
                      EnableColumnVirtualization="True" EnableRowVirtualization="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      automation:AutomationProperties.AutomationId="PerformancePhaseGrid"
                      automation:AutomationProperties.Name="Bounded phase duration summary, up to six rows">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="*" Header="Phase" Binding="{Binding Phase}" />
                    <DataGridTextColumn Width="140" Header="State" Binding="{Binding State}" />
                    <DataGridTextColumn Width="160" Header="Active duration" Binding="{Binding Duration}" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Margin="0,12,0,0" Style="{StaticResource PerformanceCard}"
                    automation:AutomationProperties.AutomationId="PerformanceHealthCard">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Cache and read summary" />
                    <TextBlock Margin="0,5,0,0" Text="{Binding CacheSummary}" TextWrapping="Wrap"
                               automation:AutomationProperties.AutomationId="PerformanceCacheSummary" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding ReadSummary}" TextWrapping="Wrap"
                               automation:AutomationProperties.AutomationId="PerformanceReadSummary" />
                    <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Candidate funnel" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding CandidateFunnel}" TextWrapping="Wrap"
                               automation:AutomationProperties.AutomationId="PerformanceCandidateFunnel" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding UnavailableSummary, StringFormat='Unavailable counters: {0}'}" TextWrapping="Wrap"
                               automation:AutomationProperties.AutomationId="PerformanceUnavailableCounters" />
                </StackPanel>
            </Border>

            <TextBlock Margin="0,18,0,3" Style="{StaticResource SectionTitle}" Text="Host and drive summaries" />
            <TextBlock Margin="0,0,0,7" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                       Text="Select a drive to inspect its recorded readings. Unavailable values remain unavailable." />
            <WrapPanel>
                <Border MinWidth="260" Style="{StaticResource PerformanceCard}">
                    <StackPanel><TextBlock FontWeight="SemiBold" Text="System CPU" /><TextBlock Margin="0,4,0,0" Text="{Binding CpuSummary}" TextWrapping="Wrap" /></StackPanel>
                </Border>
                <Border MinWidth="260" Style="{StaticResource PerformanceCard}">
                    <StackPanel><TextBlock FontWeight="SemiBold" Text="Process memory" /><TextBlock Margin="0,4,0,0" Text="{Binding MemorySummary}" TextWrapping="Wrap" /></StackPanel>
                </Border>
            </WrapPanel>
            <ListBox MaxHeight="220" Margin="0,8,0,0"
                     ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     automation:AutomationProperties.AutomationId="PerformanceDeviceList"
                     automation:AutomationProperties.Name="Bounded drive selector, up to 64 rows">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,5">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Device}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,2,0,0" Text="{Binding Volume}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding Details}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding Availability}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Margin="0,8,0,0" Style="{StaticResource PerformanceCard}"
                    Visibility="{Binding HasSelectedDevice, Converter={StaticResource BooleanToVisibilityConverter}}"
                    automation:AutomationProperties.AutomationId="SelectedPerformanceDeviceDetail"
                    automation:AutomationProperties.Name="{Binding SelectedDeviceHeading}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding SelectedDeviceHeading}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding SelectedDevice.Details}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,3,0,0" TextWrapping="Wrap">
                        <Run Text="Capacity: " /><Run Text="{Binding SelectedDevice.Capacity, Mode=OneWay}" />
                        <Run Text=" · Free at scan start: " /><Run Text="{Binding SelectedDevice.FreeAtStart, Mode=OneWay}" />
                    </TextBlock>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Current" /><TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Peak" />
                        <TextBlock Grid.Row="1" Text="Read throughput" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDevice.CurrentRead}" TextWrapping="Wrap" /><TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SelectedDevice.PeakRead}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Text="Read operations" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDevice.CurrentIops}" TextWrapping="Wrap" /><TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SelectedDevice.PeakIops}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3" Text="Average latency" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedDevice.CurrentLatency}" TextWrapping="Wrap" /><TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding SelectedDevice.PeakLatency}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="4" Text="Active time" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedDevice.CurrentActive}" TextWrapping="Wrap" /><TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding SelectedDevice.PeakActive}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="5" Text="Queue depth" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedDevice.CurrentQueue}" TextWrapping="Wrap" /><TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding SelectedDevice.PeakQueue}" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Margin="0,18,0,3" Style="{StaticResource SectionTitle}" Text="Retained run comparison" />
            <TextBlock Margin="0,0,0,7" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                       Text="Choose an earlier run to compare its recorded summary. Context differences are shown with the result." />
            <DataGrid MaxHeight="240" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding History}"
                      SelectedItem="{Binding SelectedComparisonRun, Mode=TwoWay}"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      EnableColumnVirtualization="True" EnableRowVirtualization="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      automation:AutomationProperties.AutomationId="PerformanceHistoryGrid"
                      automation:AutomationProperties.Name="Newest 25 retained performance runs">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="110" Header="Run" Binding="{Binding Run}" />
                    <DataGridTextColumn Width="120" Header="Status" Binding="{Binding Status}" />
                    <DataGridTextColumn Width="160" Header="Started" Binding="{Binding Started}" />
                    <DataGridTextColumn Width="*" Header="Software build" Binding="{Binding Build}" />
                </DataGrid.Columns>
            </DataGrid>
            <Button Margin="0,8,0,0" HorizontalAlignment="Left" Command="{Binding CompareCommand}" Content="_Compare selected run"
                    automation:AutomationProperties.AccessKey="Alt+C"
                    automation:AutomationProperties.AutomationId="ComparePerformanceRun"
                    automation:AutomationProperties.Name="Compare selected bounded telemetry run" />
            <TextBlock Margin="0,8,0,0" Text="{Binding ComparisonMessage}" TextWrapping="Wrap"
                       automation:AutomationProperties.AutomationId="PerformanceComparisonContext" />
            <Grid Margin="0,8,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Current" /><TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Selected prior" />
                <TextBlock Grid.Row="1" Text="Duration" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RunDuration}" TextWrapping="Wrap" /><TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ComparisonDuration}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Text="Full-read throughput" TextWrapping="Wrap" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FullReadThroughput}" TextWrapping="Wrap" /><TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding ComparisonThroughput}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="3" Text="Warnings" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WarningSummary}" TextWrapping="Wrap" /><TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding ComparisonWarnings}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="4" Text="Peak device read" TextWrapping="Wrap" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CurrentPeakRead}" TextWrapping="Wrap" /><TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding ComparisonPeakRead}" TextWrapping="Wrap" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
