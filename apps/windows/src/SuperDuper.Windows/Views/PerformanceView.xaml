<UserControl x:Class="SuperDuper.Windows.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:accessibility="clr-namespace:SuperDuper.Windows.Accessibility"
             automation:AutomationProperties.Name="Performance telemetry">
    <UserControl.Resources>
        <Style x:Key="PerformanceCard" TargetType="Border">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style x:Key="SecondaryPerformanceText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Margin="28" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Focusable="False" automation:AutomationProperties.AutomationId="PerformanceScrollViewer">
        <StackPanel KeyboardNavigation.TabNavigation="Continue">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="PerformanceHeading" FontSize="22" FontWeight="SemiBold"
                               Focusable="True" KeyboardNavigation.IsTabStop="False"
                               automation:AutomationProperties.AutomationId="PerformanceHeading"
                               Text="Performance" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource SecondaryPerformanceText}"
                               Text="Worker-owned, bounded current and retained telemetry. Unavailable counters are never shown as zero." />
                </StackPanel>
                <Button Grid.Column="1" Padding="14,7" Command="{Binding RefreshCommand}" Content="_Refresh"
                        automation:AutomationProperties.AccessKey="Alt+R"
                        automation:AutomationProperties.AutomationId="RefreshPerformance"
                        automation:AutomationProperties.Name="Refresh bounded performance telemetry" />
            </Grid>

            <TextBlock Margin="0,12,0,0" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                       automation:AutomationProperties.AutomationId="PerformanceStatus"
                       automation:AutomationProperties.Name="{Binding StatusMessage}"
                       accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding AnnouncementVersion}"
                       accessibility:AutomationNotificationBehavior.NotificationKind="ActionCompleted"
                       accessibility:AutomationNotificationBehavior.NotificationProcessing="MostRecent"
                       accessibility:AutomationNotificationBehavior.ActivityId="PerformanceRefresh" />
            <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                       Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"
                       automation:AutomationProperties.AutomationId="PerformanceError"
                       AutomationProperties.LiveSetting="Assertive" />

            <UniformGrid Margin="0,18,0,0" Columns="4">
                <Border Style="{StaticResource PerformanceCard}"><StackPanel><TextBlock Style="{StaticResource SecondaryPerformanceText}" Text="Run health" /><TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding RunStatus}" /><TextBlock Style="{StaticResource SecondaryPerformanceText}" Text="{Binding RunDuration, StringFormat='Duration {0}'}" /></StackPanel></Border>
                <Border Style="{StaticResource PerformanceCard}"><StackPanel><TextBlock Style="{StaticResource SecondaryPerformanceText}" Text="Full-read throughput" /><TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding FullReadThroughput}" TextWrapping="Wrap" /></StackPanel></Border>
                <Border Style="{StaticResource PerformanceCard}"><StackPanel><TextBlock Style="{StaticResource SecondaryPerformanceText}" Text="CPU" /><TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding CpuSummary}" TextWrapping="Wrap" /></StackPanel></Border>
                <Border Style="{StaticResource PerformanceCard}"><StackPanel><TextBlock Style="{StaticResource SecondaryPerformanceText}" Text="Process memory" /><TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding MemorySummary}" TextWrapping="Wrap" /></StackPanel></Border>
            </UniformGrid>

            <Border Margin="0,8,0,0" Style="{StaticResource PerformanceCard}"
                    automation:AutomationProperties.AutomationId="PerformanceHealthCard">
                <StackPanel>
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="Candidate and cache health" />
                    <TextBlock Margin="0,5,0,0" Text="{Binding CandidateFunnel}" TextWrapping="Wrap" automation:AutomationProperties.AutomationId="PerformanceCandidateFunnel" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding CacheSummary, StringFormat='Cache: {0}'}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding WarningSummary, StringFormat='Warnings: {0}'}" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding UnavailableSummary, StringFormat='Unavailable counters: {0}'}" TextWrapping="Wrap" automation:AutomationProperties.AutomationId="PerformanceUnavailableCounters" />
                </StackPanel>
            </Border>

            <TextBlock Margin="0,18,0,7" FontSize="17" FontWeight="SemiBold" Text="Phase durations" />
            <DataGrid MaxHeight="220" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding Phases}"
                      EnableColumnVirtualization="True" EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      automation:AutomationProperties.AutomationId="PerformancePhaseGrid"
                      automation:AutomationProperties.Name="Bounded phase duration summary">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="*" Header="Phase" Binding="{Binding Phase}" />
                    <DataGridTextColumn Width="160" Header="State" Binding="{Binding State}" />
                    <DataGridTextColumn Width="180" Header="Active duration" Binding="{Binding Duration}" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Margin="0,18,0,3" FontSize="17" FontWeight="SemiBold" Text="Drive information and device load" />
            <TextBlock Margin="0,0,0,7" Style="{StaticResource SecondaryPerformanceText}" Text="Current and peak values are persisted summaries; each unavailable provider value remains labeled unavailable." />
            <DataGrid MaxHeight="300" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding Devices}"
                      EnableColumnVirtualization="True" EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      automation:AutomationProperties.AutomationId="PerformanceDeviceGrid"
                      automation:AutomationProperties.Name="Bounded physical drive performance summary">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="180" Header="Device" Binding="{Binding Device}" />
                    <DataGridTextColumn Width="150" Header="Volume" Binding="{Binding Volume}" />
                    <DataGridTextColumn Width="190" Header="Drive details" Binding="{Binding Details}" />
                    <DataGridTextColumn Width="110" Header="Capacity" Binding="{Binding Capacity}" />
                    <DataGridTextColumn Width="110" Header="Free at start" Binding="{Binding FreeAtStart}" />
                    <DataGridTextColumn Width="120" Header="Read current" Binding="{Binding CurrentRead}" />
                    <DataGridTextColumn Width="120" Header="Read peak" Binding="{Binding PeakRead}" />
                    <DataGridTextColumn Width="100" Header="IOPS current" Binding="{Binding CurrentIops}" />
                    <DataGridTextColumn Width="100" Header="IOPS peak" Binding="{Binding PeakIops}" />
                    <DataGridTextColumn Width="105" Header="Latency current" Binding="{Binding CurrentLatency}" />
                    <DataGridTextColumn Width="105" Header="Latency peak" Binding="{Binding PeakLatency}" />
                    <DataGridTextColumn Width="100" Header="Active current" Binding="{Binding CurrentActive}" />
                    <DataGridTextColumn Width="100" Header="Active peak" Binding="{Binding PeakActive}" />
                    <DataGridTextColumn Width="100" Header="Queue current" Binding="{Binding CurrentQueue}" />
                    <DataGridTextColumn Width="100" Header="Queue peak" Binding="{Binding PeakQueue}" />
                    <DataGridTextColumn Width="220" Header="Availability" Binding="{Binding Availability}" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Margin="0,18,0,3" FontSize="17" FontWeight="SemiBold" Text="Retained run comparison" />
            <TextBlock Margin="0,0,0,7" Style="{StaticResource SecondaryPerformanceText}" Text="Only the newest 25 telemetry runs are loaded. Comparison labels device, input, or build differences instead of implying equivalence." />
            <DataGrid MaxHeight="240" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding History}"
                      SelectedItem="{Binding SelectedComparisonRun, Mode=TwoWay}"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      EnableColumnVirtualization="True" EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      automation:AutomationProperties.AutomationId="PerformanceHistoryGrid"
                      automation:AutomationProperties.Name="Newest 25 retained performance runs">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="110" Header="Run" Binding="{Binding Run}" />
                    <DataGridTextColumn Width="120" Header="Status" Binding="{Binding Status}" />
                    <DataGridTextColumn Width="160" Header="Started" Binding="{Binding Started}" />
                    <DataGridTextColumn Width="*" Header="Software build" Binding="{Binding Build}" />
                </DataGrid.Columns>
            </DataGrid>
            <Button Margin="0,8,0,0" HorizontalAlignment="Left" Padding="14,7" Command="{Binding CompareCommand}" Content="_Compare selected run"
                    automation:AutomationProperties.AccessKey="Alt+C"
                    automation:AutomationProperties.AutomationId="ComparePerformanceRun"
                    automation:AutomationProperties.Name="Compare selected bounded telemetry run" />
            <TextBlock Margin="0,8,0,0" Text="{Binding ComparisonMessage}" TextWrapping="Wrap"
                       automation:AutomationProperties.AutomationId="PerformanceComparisonContext" />
            <Grid Margin="0,8,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Current" /><TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Selected prior" />
                <TextBlock Grid.Row="1" Text="Duration" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RunDuration}" /><TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ComparisonDuration}" />
                <TextBlock Grid.Row="2" Text="Full-read throughput" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FullReadThroughput}" /><TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding ComparisonThroughput}" />
                <TextBlock Grid.Row="3" Text="Warnings" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WarningSummary}" /><TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding ComparisonWarnings}" />
                <TextBlock Grid.Row="4" Text="Peak device read" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CurrentPeakRead}" /><TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding ComparisonPeakRead}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
