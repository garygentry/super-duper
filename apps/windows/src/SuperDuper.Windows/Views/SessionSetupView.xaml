<UserControl x:Class="SuperDuper.Windows.Views.SessionSetupView"
             x:Name="Root"
             AutomationProperties.Name="Saved scan setup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalContentAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PageContentInset}" MaxWidth="880" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource PageTitle}" Text="Choose locations" />
            <TextBlock Margin="0,5,0,16"
                       Text="Add the folders or drives to compare, then start the scan."
                       TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource SectionTitle}" Text="Folders and drives" />
            <WrapPanel Margin="0,7,0,7">
                <Button Margin="0,0,8,8" Command="{Binding BrowseRootCommand}" Content="Add folder or drive" />
                <Button Margin="0,0,8,8" Command="{Binding AddRootCommand}" Content="Enter path" />
            </WrapPanel>

            <ItemsControl AutomationProperties.Name="Scan root editors" ItemsSource="{Binding Roots}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox AutomationProperties.Name="Scan root path"
                                     IsEnabled="{Binding DataContext.CanEdit, ElementName=Root}"
                                     Text="{Binding Path, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource PlainPathConverter}}" />
                            <Button Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource ShellIconAction}"
                                    Command="{Binding DataContext.RemoveRootCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding Path, Converter={StaticResource PlainPathConverter}, StringFormat=Remove location: {0}}"
                                    AutomationProperties.Name="{Binding Path, Converter={StaticResource PlainPathConverter}, StringFormat=Remove location: {0}}">
                                <Path Data="{StaticResource ShellIconDismiss}" Style="{StaticResource ShellActionIcon}" />
                            </Button>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                       Text="{Binding Status}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasStatusNotice}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Margin="0,4,0,12" Style="{StaticResource CaptionText}"
                       Text="Locations are checked again when scanning starts; overlapping folders are combined." />

            <TextBlock FontWeight="SemiBold" Text="Saved scan name" />
            <TextBox Margin="0,7,0,8"
                     AutomationProperties.AutomationId="SessionName"
                     AutomationProperties.Name="Saved scan name"
                     MinWidth="180"
                     IsEnabled="{Binding CanEdit}"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            <WrapPanel Margin="0,0,0,16">
                <Button MinWidth="96" Style="{StaticResource ShellSecondaryAction}"
                        Command="{Binding SaveCommand}" Content="Save changes" />
                <ProgressBar Margin="14,0,0,0"
                             Width="90" Height="4" VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </WrapPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Scan settings" />
            <TextBlock Margin="0,5,0,3" Text="Cloud sync folders and ignored files are skipped." TextWrapping="Wrap" />
            <TextBlock Margin="0,0,0,7" Text="{Binding RepeatCachePolicyDisplayName, StringFormat='Repeat scans: {0}'}" TextWrapping="Wrap" />
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           AutomationProperties.AutomationId="CloudDetectionStatus"
                           AutomationProperties.Name="{Binding CloudDetectionSummary, FallbackValue=Cloud location detection status}"
                           Text="{Binding CloudDetectionSummary}"
                           TextWrapping="Wrap" />
                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        Style="{StaticResource ShellSecondaryAction}"
                        AutomationProperties.AutomationId="RefreshCloudLocations"
                        AutomationProperties.Name="Refresh registered cloud locations"
                        Command="{Binding RefreshCloudLocationsCommand}"
                        Content="Refresh" />
            </Grid>
            <TextBlock Margin="0,0,0,8"
                       AutomationProperties.AutomationId="CloudDetectionError"
                       AutomationProperties.Name="{Binding CloudDetectionMessage}"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Text="{Binding CloudDetectionMessage}"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasCloudDetectionMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Expander Header="Scan policy details" Margin="0,0,0,8"
                      AutomationProperties.AutomationId="SetupPolicyDetails"
                      AutomationProperties.Name="Scan policy details">
            <Border Padding="12"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8" Text="{Binding ExclusionsSummary}" TextWrapping="Wrap" />
                    <TextBlock AutomationProperties.Name="Cloud scan policy"
                               AutomationProperties.AutomationId="CloudPolicyName"
                               FontWeight="SemiBold"
                               Text="{Binding CloudPolicyDisplayName}" />
                    <TextBlock Margin="0,4,0,0"
                               AutomationProperties.AutomationId="CloudPolicyDescription"
                               AutomationProperties.Name="Registered cloud folders are skipped before their files are inspected or read. Detection must succeed before Start."
                               Text="Registered cloud folders are skipped before their files are inspected or read. Detection must succeed before Start."
                               TextWrapping="Wrap" />
                    <ItemsControl Margin="0,8,0,0"
                                  AutomationProperties.AutomationId="DetectedCloudLocations"
                                  AutomationProperties.Name="Detected excluded cloud locations"
                                  ItemsSource="{Binding DetectedCloudLocations}"
                                  Visibility="{Binding HasDetectedCloudLocations, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6"
                                        Padding="9"
                                        AutomationProperties.Name="{Binding AccessibilityName}"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="5">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding ProviderName}" />
                                        <TextBlock Margin="0,2,0,0" Text="{Binding Path, Converter={StaticResource PlainPathConverter}}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionText}" Text="{Binding Behavior}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,12,0,4" FontWeight="SemiBold"
                               Text="{Binding RepeatCachePolicyDisplayName}" />
                    <TextBlock Text="{Binding RepeatCachePolicyDescription}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,5,0,0"
                               Text="The persistent cache can survive app restarts. Each run discovers current files again; cache availability and qualifying metadata determine reuse."
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            </Expander>
            <Expander x:Name="SetupAdvanced" AutomationProperties.AutomationId="SetupAdvanced" Header="Advanced: content reads and exclusions" Margin="0,8,0,8">
                <StackPanel Margin="0,10,0,0">
                    <Label Padding="0"
                           FontWeight="SemiBold"
                           Target="{Binding ElementName=RepeatCachePolicySelector}">_Repeat scans</Label>
                    <ComboBox x:Name="RepeatCachePolicySelector"
                              Margin="0,7,0,0"
                              AutomationProperties.AutomationId="RepeatCachePolicy"
                              AutomationProperties.Name="Repeat scan hash policy"
                              AutomationProperties.HelpText="Choose whether unchanged files may reuse verified hashes. Any uncertain verification falls back to reading file content."
                              DisplayMemberPath="DisplayName"
                              IsEnabled="{Binding CanEdit}"
                              ItemsSource="{Binding RepeatCachePolicies}"
                              SelectedValue="{Binding RepeatCachePolicy, Mode=TwoWay}"
                              SelectedValuePath="Value" />
                    <TextBlock Margin="0,5,0,20"
                               AutomationProperties.AutomationId="RepeatCachePolicyDescription"
                               AutomationProperties.Name="{Binding RepeatCachePolicyDescription}"
                               Style="{StaticResource CaptionText}"
                               Text="{Binding RepeatCachePolicyDescription}"
                               TextWrapping="Wrap" />

                    <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="Manual cloud location exclusions" />
                    <TextBlock Margin="0,4,0,7"
                               Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap" Text="Enter one absolute path per line for providers that do not register with Windows Cloud Files." />
                    <TextBox MinHeight="72"
                             AutomationProperties.AutomationId="ManualCloudLocationExclusions"
                             AutomationProperties.Name="Manual cloud location exclusions"
                             AcceptsReturn="True"
                             HorizontalScrollBarVisibility="Auto"
                             IsEnabled="{Binding CanEdit}"
                             Text="{Binding ManualLocationExclusionsText, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" />

                    <TextBlock Margin="0,20,0,0" FontWeight="SemiBold" Text="Ignore patterns" />
                    <TextBlock Margin="0,4,0,7"
                               Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap" Text="Enter one glob pattern per line. For example **/*.tmp. New saved scans start with Windows-safe defaults." />
                    <TextBox MinHeight="130"
                             AutomationProperties.AutomationId="IgnorePatterns"
                             AutomationProperties.Name="Ignore patterns"
                             AcceptsReturn="True"
                             HorizontalScrollBarVisibility="Auto"
                             IsEnabled="{Binding CanEdit}"
                             Text="{Binding IgnorePatternsText, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" />

                </StackPanel>
            </Expander>
            <Border Margin="0,18,0,0"
                    Padding="12"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding HasWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding WarningMessage}" TextWrapping="Wrap" />
            </Border>
            <Border Margin="0,12,0,0"
                    Padding="12"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding HasValidationErrors, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" />
            </Border>
            <Border Margin="0,12,0,0"
                    Padding="12"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding HasOperationError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding OperationError}" TextWrapping="Wrap" />
            </Border>

            <Expander Header="Manage saved scan" Margin="0,12,0,0"
                      AutomationProperties.AutomationId="ManageSavedScan"
                      AutomationProperties.Name="Manage saved scan">
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Deleting this saved scan also removes its earlier scan history."
                               TextWrapping="Wrap" />
                    <Button Margin="0,8,0,0" HorizontalAlignment="Left"
                            MinWidth="96" Command="{Binding DeleteCommand}"
                            Content="Delete saved scan and history" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
