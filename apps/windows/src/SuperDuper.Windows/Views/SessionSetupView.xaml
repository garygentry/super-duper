<UserControl x:Class="SuperDuper.Windows.Views.SessionSetupView"
             x:Name="Root"
             AutomationProperties.Name="Session setup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalContentAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28" MaxWidth="880" HorizontalAlignment="Stretch">
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Session setup" />
            <TextBlock Margin="0,5,0,22"
                       Opacity="0.68"
                       Text="Choose what this reusable session scans and what it ignores."
                       TextWrapping="Wrap" />

            <TextBlock FontWeight="SemiBold" Text="Name" />
            <TextBox Margin="0,7,0,20"
                     AutomationProperties.AutomationId="SessionName"
                     AutomationProperties.Name="Session name"
                     MinWidth="420"
                     IsEnabled="{Binding CanEdit}"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Scan roots" />
                <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding AddRootCommand}" Content="Add path" />
                <Button Grid.Column="2" Margin="8,0,0,0" Command="{Binding BrowseRootCommand}" Content="Browse…" />
            </Grid>

            <ItemsControl AutomationProperties.Name="Scan root editors" ItemsSource="{Binding Roots}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox AutomationProperties.Name="Scan root path"
                                     IsEnabled="{Binding DataContext.CanEdit, ElementName=Root}"
                                     Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Padding="9,3"
                                    Command="{Binding DataContext.RemoveRootCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    Content="Remove" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Margin="0,2,0,20"
                    HorizontalAlignment="Left"
                    Command="{Binding NormalizeRootsCommand}"
                    Content="Normalize roots" />

            <Label Padding="0"
                   FontWeight="SemiBold"
                   Target="{Binding ElementName=RepeatCachePolicySelector}">_Repeat scans</Label>
            <ComboBox x:Name="RepeatCachePolicySelector"
                      Margin="0,7,0,0"
                      AutomationProperties.AutomationId="RepeatCachePolicy"
                      AutomationProperties.Name="Repeat scan hash policy"
                      AutomationProperties.HelpText="Choose whether unchanged files may reuse verified hashes. Any uncertain verification falls back to reading file content."
                      DisplayMemberPath="DisplayName"
                      IsEnabled="{Binding CanEdit}"
                      ItemsSource="{Binding RepeatCachePolicies}"
                      SelectedValue="{Binding RepeatCachePolicy, Mode=TwoWay}"
                      SelectedValuePath="Value" />
            <TextBlock Margin="0,5,0,20"
                       AutomationProperties.AutomationId="RepeatCachePolicyDescription"
                       AutomationProperties.Name="{Binding RepeatCachePolicyDescription}"
                       FontSize="12"
                       Opacity="0.68"
                       Text="{Binding RepeatCachePolicyDescription}"
                       TextWrapping="Wrap" />

            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Cloud locations" />
                <Button Grid.Column="1"
                        AutomationProperties.AutomationId="RefreshCloudLocations"
                        AutomationProperties.Name="Refresh registered cloud locations"
                        Command="{Binding RefreshCloudLocationsCommand}"
                        Content="Refresh" />
            </Grid>
            <Border Padding="12"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock AutomationProperties.Name="Cloud scan policy"
                               AutomationProperties.AutomationId="CloudPolicyName"
                               FontWeight="SemiBold"
                               Text="{Binding CloudPolicyDisplayName}" />
                    <TextBlock Margin="0,4,0,0"
                               AutomationProperties.AutomationId="CloudPolicyDescription"
                               AutomationProperties.Name="Registered Cloud Files subtrees are pruned before file metadata, canonicalization, identity, or content access."
                               Opacity="0.68"
                               Text="Registered Cloud Files subtrees are pruned before file metadata, canonicalization, identity, or content access."
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0"
                               AutomationProperties.AutomationId="CloudDetectionStatus"
                               AutomationProperties.Name="{Binding CloudDetectionSummary, FallbackValue=Cloud location detection status}"
                               Text="{Binding CloudDetectionSummary}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0"
                               AutomationProperties.AutomationId="CloudDetectionError"
                               AutomationProperties.Name="{Binding CloudDetectionMessage}"
                               Foreground="#C84B31"
                               Text="{Binding CloudDetectionMessage}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasCloudDetectionMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ItemsControl Margin="0,8,0,0"
                                  AutomationProperties.AutomationId="DetectedCloudLocations"
                                  AutomationProperties.Name="Detected excluded cloud locations"
                                  ItemsSource="{Binding DetectedCloudLocations}"
                                  Visibility="{Binding HasDetectedCloudLocations, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6"
                                        Padding="9"
                                        AutomationProperties.Name="{Binding AccessibilityName}"
                                        Background="#120078D4"
                                        CornerRadius="5">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding ProviderName}" />
                                        <TextBlock Margin="0,2,0,0" Text="{Binding Path}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0" FontSize="12" Opacity="0.7" Text="{Binding Behavior}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="Manual cloud location exclusions" />
            <TextBlock Margin="0,4,0,7"
                       FontSize="12"
                       Opacity="0.66"
                       Text="Enter one absolute path per line for providers that do not register with Windows Cloud Files." />
            <TextBox MinHeight="72"
                     AutomationProperties.AutomationId="ManualCloudLocationExclusions"
                     AutomationProperties.Name="Manual cloud location exclusions"
                     AcceptsReturn="True"
                     HorizontalScrollBarVisibility="Auto"
                     IsEnabled="{Binding CanEdit}"
                     Text="{Binding ManualLocationExclusionsText, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" />

            <TextBlock Margin="0,20,0,0" FontWeight="SemiBold" Text="Ignore patterns" />
            <TextBlock Margin="0,4,0,7"
                       FontSize="12"
                       Opacity="0.66"
                       Text="Enter one glob pattern per line. New sessions start with Windows-safe defaults." />
            <TextBox MinHeight="130"
                     AutomationProperties.AutomationId="IgnorePatterns"
                     AutomationProperties.Name="Ignore patterns"
                     AcceptsReturn="True"
                     HorizontalScrollBarVisibility="Auto"
                     IsEnabled="{Binding CanEdit}"
                     Text="{Binding IgnorePatternsText, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" />

            <Border Margin="0,18,0,0"
                    Padding="12"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding HasWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding WarningMessage}" TextWrapping="Wrap" />
            </Border>
            <Border Margin="0,12,0,0"
                    Padding="12"
                    BorderBrush="#C84B31"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding HasValidationErrors, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" />
            </Border>
            <Border Margin="0,12,0,0"
                    Padding="12"
                    BorderBrush="#C84B31"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding HasOperationError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding OperationError}" TextWrapping="Wrap" />
            </Border>

            <StackPanel Margin="0,22,0,0" Orientation="Horizontal">
                <Button MinWidth="96" Padding="12,7" Command="{Binding SaveCommand}" Content="Save" />
                <Button Margin="10,0,0,0"
                        MinWidth="96"
                        Padding="12,7"
                        Command="{Binding DeleteCommand}"
                        Content="Delete" />
                <ProgressBar Margin="14,0,0,0"
                             Width="90"
                             Height="4"
                             VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
