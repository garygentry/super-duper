<UserControl x:Class="SuperDuper.Windows.Views.PreflightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:accessibility="clr-namespace:SuperDuper.Windows.Accessibility"
             AutomationProperties.AutomationId="PreflightWorkspace"
             AutomationProperties.Name="Preflight validation workspace"
             PreviewKeyDown="OnPreviewKeyDown">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="1040">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Preflight validation" />
            <TextBlock Margin="0,6,0,0"
                       Text="Validate reviewed removals against immutable scan snapshots. Preflight never deletes, schedules, or sends files to the Recycle Bin."
                       TextWrapping="Wrap" />

            <Border Margin="0,18,0,0" Padding="16"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Reviewed plan snapshot" />
                    <TextBlock Margin="0,5,0,0" AutomationProperties.AutomationId="PreflightPlanSummary"
                               Text="{Binding PlanSummary}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,7,0,0"
                               Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"
                               Text="{Binding RevisionStatus}" TextWrapping="Wrap" />
                    <Button x:Name="StartPreflightButton" Margin="0,14,0,0" Padding="14,7"
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="StartPreflightButton"
                            AutomationProperties.Name="Run preflight validation; no files will be deleted"
                            Command="{Binding StartCommand}" Content="Run preflight" />
                </StackPanel>
            </Border>

            <Border Margin="0,18,0,0" Padding="16"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1" CornerRadius="6"
                    Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Validation in progress" />
                    <ProgressBar x:Name="PreflightProgressBar" Margin="0,10,0,0" Height="8"
                                 Focusable="True"
                                 AutomationProperties.AutomationId="PreflightProgressBar"
                                 AutomationProperties.Name="{Binding ProgressText}"
                                 Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                                 Value="{Binding ProgressValue, Mode=OneWay}" />
                    <TextBlock Margin="0,8,0,0" Text="{Binding ProgressText}" />
                    <Button Margin="0,12,0,0" Padding="14,7" HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="CancelPreflightButton"
                            AutomationProperties.Name="Cancel preflight validation"
                            Command="{Binding CancelCommand}" Content="Cancel preflight" />
                </StackPanel>
            </Border>

            <StackPanel Margin="0,20,0,0"
                        Visibility="{Binding HasPreflight, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock x:Name="PreflightSummaryHeading" Focusable="True" FontSize="19"
                           FontWeight="SemiBold" AutomationProperties.AutomationId="PreflightSummaryHeading"
                           AutomationProperties.Name="{Binding StatusSummary}" Text="Preflight summary" />
                <TextBlock Margin="0,6,0,0" AutomationProperties.AutomationId="PreflightStatusSummary"
                           Text="{Binding StatusSummary}" TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0" Opacity="0.72"
                           Text="Ready means the item matched only during this validation generation; it is not approval to delete."
                           TextWrapping="Wrap" />
                <ListView Margin="0,14,0,0" MinHeight="180" MaxHeight="420"
                          AutomationProperties.AutomationId="PreflightItemsList"
                          AutomationProperties.Name="Preflight observation details"
                          ItemsSource="{Binding Items}" ScrollViewer.CanContentScroll="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,5" AutomationProperties.Name="{Binding AutomationName}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="{Binding Outcome}" />
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding Target}" />
                                <TextBlock Grid.Column="2" Margin="8,0,0,0" Text="{Binding Path}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Margin="8,0,0,0" Text="{Binding Explanation}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Padding="12,6" AutomationProperties.AutomationId="PreflightPreviousPageButton"
                            Command="{Binding PreviousPageCommand}" Content="Previous page" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,6"
                            AutomationProperties.AutomationId="PreflightNextPageButton"
                            Command="{Binding NextPageCommand}" Content="Next page" />
                    <TextBlock Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center"
                               Text="{Binding PageStatus}" />
                </Grid>
            </StackPanel>

            <TextBlock Margin="0,16,0,0"
                       Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"
                       AutomationProperties.AutomationId="PreflightError"
                       AutomationProperties.Name="{Binding ErrorAnnouncement}"
                       accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding ErrorAnnouncementVersion}"
                       accessibility:AutomationNotificationBehavior.NotificationKind="ActionAborted"
                       accessibility:AutomationNotificationBehavior.NotificationProcessing="ImportantMostRecent"
                       accessibility:AutomationNotificationBehavior.ActivityId="PreflightValidation"
                       Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Height="1" Opacity="0" AutomationProperties.Name="{Binding Announcement}"
                       accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding AnnouncementVersion}"
                       accessibility:AutomationNotificationBehavior.NotificationKind="ActionCompleted"
                       accessibility:AutomationNotificationBehavior.NotificationProcessing="MostRecent"
                       accessibility:AutomationNotificationBehavior.ActivityId="PreflightValidation" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
