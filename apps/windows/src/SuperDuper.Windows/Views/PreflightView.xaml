<UserControl x:Class="SuperDuper.Windows.Views.PreflightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:accessibility="clr-namespace:SuperDuper.Windows.Accessibility"
             xmlns:viewModels="clr-namespace:SuperDuper.Windows.Core.ViewModels;assembly=SuperDuper.Windows.Core"
             AutomationProperties.AutomationId="PreflightWorkspace"
             AutomationProperties.Name="Preflight validation workspace"
             PreviewKeyDown="OnPreviewKeyDown">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="1040">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Preflight validation" />
            <TextBlock Margin="0,6,0,0"
                       Text="Validate reviewed removals against immutable scan snapshots. Preflight never deletes, schedules, or sends files to the Recycle Bin."
                       TextWrapping="Wrap" />

            <Border Margin="0,18,0,0" Padding="16"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Reviewed plan snapshot" />
                    <TextBlock Margin="0,5,0,0" AutomationProperties.AutomationId="PreflightPlanSummary"
                               Text="{Binding PlanSummary}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,7,0,0"
                               Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"
                               Text="{Binding RevisionStatus}" TextWrapping="Wrap" />
                    <Button x:Name="StartPreflightButton" Margin="0,14,0,0" Padding="14,7"
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="StartPreflightButton"
                            AutomationProperties.Name="Run preflight validation; no files will be deleted"
                            Command="{Binding StartCommand}" Content="Run preflight" />
                </StackPanel>
            </Border>

            <Border Margin="0,18,0,0" Padding="16"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1" CornerRadius="6"
                    Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Validation in progress" />
                    <ProgressBar x:Name="PreflightProgressBar" Margin="0,10,0,0" Height="8"
                                 Focusable="True"
                                 AutomationProperties.AutomationId="PreflightProgressBar"
                                 AutomationProperties.Name="{Binding ProgressText}"
                                 Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                                 Value="{Binding ProgressValue, Mode=OneWay}" />
                    <TextBlock Margin="0,8,0,0" Text="{Binding ProgressText}" />
                    <Button Margin="0,12,0,0" Padding="14,7" HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="CancelPreflightButton"
                            AutomationProperties.Name="Cancel preflight validation"
                            Command="{Binding CancelCommand}" Content="Cancel preflight" />
                </StackPanel>
            </Border>

            <StackPanel Margin="0,20,0,0"
                        Visibility="{Binding HasPreflight, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock x:Name="PreflightSummaryHeading" Focusable="True" FontSize="19"
                           FontWeight="SemiBold" AutomationProperties.AutomationId="PreflightSummaryHeading"
                           AutomationProperties.Name="{Binding StatusSummary}" Text="Preflight summary" />
                <TextBlock Margin="0,6,0,0" AutomationProperties.AutomationId="PreflightStatusSummary"
                           Text="{Binding StatusSummary}" TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0" Opacity="0.72"
                           Text="Ready means the item matched only during this validation generation; it is not approval to delete."
                           TextWrapping="Wrap" />
                <ListView Margin="0,14,0,0" MinHeight="180" MaxHeight="420"
                          AutomationProperties.AutomationId="PreflightItemsList"
                          AutomationProperties.Name="Preflight observation details"
                          ItemsSource="{Binding Items}" ScrollViewer.CanContentScroll="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,5" AutomationProperties.Name="{Binding AutomationName}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="{Binding Outcome}" />
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding Target}" />
                                <TextBlock Grid.Column="2" Margin="8,0,0,0" Text="{Binding Path}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Margin="8,0,0,0" Text="{Binding Explanation}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Padding="12,6" AutomationProperties.AutomationId="PreflightPreviousPageButton"
                            Command="{Binding PreviousPageCommand}" Content="Previous page" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,6"
                            AutomationProperties.AutomationId="PreflightNextPageButton"
                            Command="{Binding NextPageCommand}" Content="Next page" />
                    <TextBlock Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center"
                               Text="{Binding PageStatus}" />
                </Grid>
            </StackPanel>

            <Border Margin="0,20,0,0" Padding="16"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1" CornerRadius="6">
                <StackPanel DataContext="{Binding Operation}">
                    <TextBlock FontSize="19" FontWeight="SemiBold" Focusable="True"
                               AutomationProperties.AutomationId="RecycleOperationHeading"
                               AutomationProperties.Name="Recycle Bin operation foundation"
                               Text="Recycle Bin operation foundation" />
                    <TextBlock Margin="0,6,0,0"
                               AutomationProperties.AutomationId="RecycleOperationBoundaryNotice"
                               AutomationProperties.Name="{Binding BoundaryNotice}"
                               Text="{Binding BoundaryNotice}" TextWrapping="Wrap" />
                    <StackPanel Margin="0,10,0,0"
                                Visibility="{Binding HasOperation, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock AutomationProperties.AutomationId="RecycleOperationConfirmationSummary"
                                   AutomationProperties.Name="{Binding ConfirmationSummary}"
                                   Text="{Binding ConfirmationSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0"
                                   AutomationProperties.AutomationId="RecycleOperationProgressSummary"
                                   Text="{Binding ProgressSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0"
                                   AutomationProperties.AutomationId="RecycleOperationCancellationDisclosure"
                                   AutomationProperties.Name="{Binding CancellationDisclosure}"
                                   Text="{Binding CancellationDisclosure}" TextWrapping="Wrap" />
                        <Border Margin="0,8,0,0" Padding="10"
                                BorderBrush="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"
                                BorderThickness="1"
                                AutomationProperties.AutomationId="RecycleOperationRecoveryGuidance"
                                AutomationProperties.Name="{Binding RecoveryGuidance}"
                                AutomationProperties.LiveSetting="Assertive"
                                Visibility="{Binding HasRecoveryGuidance, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock FontWeight="SemiBold" Text="{Binding RecoveryGuidance}" TextWrapping="Wrap" />
                        </Border>
                        <StackPanel Margin="0,8,0,0"
                                    Visibility="{Binding HasRecoveryGuidance, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock FontWeight="SemiBold" Text="Recovery evidence summary" />
                            <TextBlock Margin="0,2,0,4" TextWrapping="Wrap"
                                       Text="Select this summary and press Ctrl+C to copy it for diagnosis. It contains identifiers, immutable signatures, lifecycle times, and outcomes, not file paths." />
                            <TextBox Padding="8" IsReadOnly="True" AcceptsReturn="True"
                                     AutomationProperties.AutomationId="RecycleOperationRecoveryEvidenceSummary"
                                     AutomationProperties.Name="Selectable Recycle Bin recovery evidence summary"
                                     Text="{Binding RecoveryEvidenceSummary, Mode=OneWay}"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"
                                   Text="{Binding RevisionStatus}" TextWrapping="Wrap" />
                        <ListView x:Name="RecycleOperationItemsList" Margin="0,12,0,0" MinHeight="100" MaxHeight="280"
                                  AutomationProperties.AutomationId="RecycleOperationItemsList"
                                  AutomationProperties.Name="Recycle Bin operation result details; recovery-required operations show unknown items only"
                                  ItemsSource="{Binding Items}"
                                  SelectedItem="{Binding RecoveryReview.SelectedUnknownItem, Mode=TwoWay}"
                                  ScrollViewer.CanContentScroll="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,5"
                                          AutomationProperties.Name="{Binding EvidenceDetails}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="3*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Status}" />
                                        <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding Item.Path}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Margin="8,0,0,0" Text="{Binding Size}" />
                                        <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,2,0,0"
                                                       Text="{Binding EvidenceDetails}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Padding="12,6" AutomationProperties.AutomationId="RecycleOperationPreviousPageButton"
                                    Command="{Binding PreviousPageCommand}" Content="Previous operation page" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,6"
                                    AutomationProperties.AutomationId="RecycleOperationNextPageButton"
                                    Command="{Binding NextPageCommand}" Content="Next operation page" />
                            <TextBlock Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding PageStatus}" />
                        </Grid>
                        <Border Margin="0,16,0,0" Padding="14"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1" CornerRadius="6"
                                DataContext="{Binding RecoveryReview}"
                                AutomationProperties.AutomationId="RecoveryReviewWorkspace"
                                AutomationProperties.Name="Recovery review workspace; records operator observations without changing original evidence"
                                Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock x:Name="RecoveryReviewStatusHeading" Focusable="True"
                                           FontSize="18" FontWeight="SemiBold"
                                           AutomationProperties.AutomationId="RecoveryReviewStatusHeading"
                                           AutomationProperties.Name="{Binding ReviewStatus}"
                                           Text="Recovery review" />
                                <TextBlock Margin="0,5,0,0"
                                           AutomationProperties.AutomationId="RecoveryReviewStatus"
                                           AutomationProperties.Name="{Binding ReviewStatus}"
                                           Text="{Binding ReviewStatus}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,5,0,0"
                                           AutomationProperties.AutomationId="RecoveryReviewBoundary"
                                           AutomationProperties.Name="{Binding ReviewBoundary}"
                                           Text="{Binding ReviewBoundary}" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Margin="0,0,8,8" Padding="12,6"
                                            AutomationProperties.AutomationId="RecoveryReviewCopySummaryButton"
                                            AutomationProperties.Name="Copy durable recovery review status"
                                            Command="{Binding CopyReviewSummaryCommand}"
                                            Content="Copy review status" />
                                    <Button Margin="0,0,8,8" Padding="12,6"
                                            AutomationProperties.AutomationId="RecoveryReviewOpenRecycleBinButton"
                                            AutomationProperties.Name="Open Windows Recycle Bin for independent manual inspection"
                                            Command="{Binding OpenRecycleBinCommand}"
                                            Content="Open Recycle Bin" />
                                    <Button Margin="0,0,8,8" Padding="12,6"
                                            AutomationProperties.AutomationId="RecoveryReviewFreshScanButton"
                                            AutomationProperties.Name="Navigate to start a fresh scan; do not retry this operation"
                                            Command="{Binding NavigateToFreshScanCommand}"
                                            Content="Start a fresh scan" />
                                </WrapPanel>

                                <TextBlock Margin="0,10,0,0" FontWeight="SemiBold"
                                           Text="Selected immutable unknown item" />
                                <TextBlock Margin="0,3,0,0"
                                           AutomationProperties.AutomationId="RecoveryReviewSelectedEvidence"
                                           AutomationProperties.Name="{Binding SelectedEvidence}"
                                           Text="{Binding SelectedEvidence}" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Margin="0,0,8,8" Padding="12,6"
                                            AutomationProperties.AutomationId="RecoveryReviewCopyEvidenceButton"
                                            AutomationProperties.Name="Copy durable evidence for the selected unknown item"
                                            Command="{Binding CopyEvidenceCommand}"
                                            Content="Copy evidence" />
                                    <Button Margin="0,0,8,8" Padding="12,6"
                                            AutomationProperties.AutomationId="RecoveryReviewCopyPathButton"
                                            AutomationProperties.Name="Copy stored source path for independent inspection"
                                            Command="{Binding CopyPathCommand}"
                                            Content="Copy stored path" />
                                </WrapPanel>

                                <TextBlock Margin="0,12,0,0" FontWeight="SemiBold"
                                           Text="Record an operator observation" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="Select one unknown item above. Record only a manual observation; this does not resolve, retry, restore, or delete anything."
                                           TextWrapping="Wrap" />
                                <ComboBox x:Name="RecoveryReviewObservationKind" Margin="0,7,0,0"
                                          MaxWidth="420" HorizontalAlignment="Stretch"
                                          AutomationProperties.AutomationId="RecoveryReviewObservationKind"
                                          AutomationProperties.Name="Operator observation kind"
                                          ItemsSource="{Binding Source={x:Static viewModels:RecoveryReviewViewModel.ObservationChoices}}"
                                          SelectedItem="{Binding SelectedObservationChoice, Mode=TwoWay}"
                                          IsEnabled="{Binding CanEdit}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock AutomationProperties.Name="{Binding AutomationName}"
                                                       Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox Margin="0,7,0,0" MinHeight="54" MaxLength="1000"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         AutomationProperties.AutomationId="RecoveryReviewNote"
                                         AutomationProperties.Name="Optional operator note, maximum 1000 characters"
                                         IsEnabled="{Binding CanEdit}"
                                         Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Border Margin="0,8,0,0" Padding="10"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"
                                        BorderThickness="1"
                                        Visibility="{Binding IsCorrection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold"
                                                   AutomationProperties.AutomationId="RecoveryReviewCorrectionSummary"
                                                   AutomationProperties.Name="{Binding CorrectionSummary}"
                                                   Text="{Binding CorrectionSummary}" TextWrapping="Wrap" />
                                        <TextBox Margin="0,7,0,0" MinHeight="54" MaxLength="500"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 AutomationProperties.AutomationId="RecoveryReviewCorrectionReason"
                                                 AutomationProperties.Name="Required correction reason, maximum 500 characters"
                                                 IsEnabled="{Binding CanEdit}"
                                                 Text="{Binding CorrectionReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Margin="0,7,0,0" Padding="12,6" HorizontalAlignment="Left"
                                                AutomationProperties.AutomationId="RecoveryReviewCancelCorrectionButton"
                                                AutomationProperties.Name="Cancel append-only correction"
                                                Command="{Binding CancelCorrectionCommand}"
                                                Content="Cancel correction" />
                                    </StackPanel>
                                </Border>
                                <Button Margin="0,9,0,0" Padding="12,6" HorizontalAlignment="Left"
                                        AutomationProperties.AutomationId="RecoveryReviewRecordButton"
                                        AutomationProperties.Name="Record append-only operator observation; original evidence remains unchanged"
                                        Command="{Binding RecordObservationCommand}"
                                        Content="Record observation" />
                                <Border Margin="0,9,0,0" Padding="10"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"
                                        BorderThickness="1"
                                        AutomationProperties.AutomationId="RecoveryReviewLastRecordedObservation"
                                        AutomationProperties.Name="{Binding LastRecordedSummary}"
                                        Visibility="{Binding HasLastRecordedObservation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding LastRecordedSummary}" TextWrapping="Wrap" />
                                </Border>

                                <TextBlock x:Name="RecoveryReviewHistoryHeading" Margin="0,16,0,0"
                                           Focusable="True" FontWeight="SemiBold"
                                           AutomationProperties.AutomationId="RecoveryReviewHistoryHeading"
                                           AutomationProperties.Name="Recovery review append-only history"
                                           Text="Append-only observation history" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="To append a correction, select a current history record and its matching immutable unknown item above. The prior record and correction reason remain visible."
                                           TextWrapping="Wrap" />
                                <ListView x:Name="RecoveryReviewHistoryList" Margin="0,7,0,0"
                                          MinHeight="100" MaxHeight="260"
                                          Focusable="True" KeyboardNavigation.IsTabStop="True"
                                          AutomationProperties.AutomationId="RecoveryReviewHistoryList"
                                          AutomationProperties.Name="Recovery review observation history with supersession details"
                                          ItemsSource="{Binding Observations}"
                                          SelectedItem="{Binding SelectedHistoryObservation, Mode=TwoWay}"
                                          ScrollViewer.CanContentScroll="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,5" AutomationProperties.Name="{Binding AutomationName}">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayObservation}" />
                                                <TextBlock Text="{Binding CurrentStatus}" />
                                                <TextBlock Text="{Binding Correction}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Margin="0,0,8,8" Padding="12,6"
                                            AutomationProperties.AutomationId="RecoveryReviewPreviousHistoryButton"
                                            AutomationProperties.Name="Previous recovery review history page; focus returns to history"
                                            Command="{Binding PreviousHistoryPageCommand}"
                                            Content="Previous history page" />
                                    <Button Margin="0,0,8,8" Padding="12,6"
                                            AutomationProperties.AutomationId="RecoveryReviewNextHistoryButton"
                                            AutomationProperties.Name="Next recovery review history page; focus returns to history"
                                            Command="{Binding NextHistoryPageCommand}"
                                            Content="Next history page" />
                                    <Button Margin="0,0,8,8" Padding="12,6"
                                            AutomationProperties.AutomationId="RecoveryReviewBeginCorrectionButton"
                                            AutomationProperties.Name="Correct the selected current observation for the selected immutable item; preserve the prior record"
                                            Command="{Binding BeginCorrectionCommand}"
                                            Content="Correct selected observation" />
                                </WrapPanel>
                                <TextBlock AutomationProperties.AutomationId="RecoveryReviewHistoryStatus"
                                           AutomationProperties.Name="{Binding HistoryPageStatus}"
                                           Text="{Binding HistoryPageStatus}" TextWrapping="Wrap" />

                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"
                                           AutomationProperties.AutomationId="RecoveryReviewReadError"
                                           AutomationProperties.Name="{Binding ErrorAnnouncement}"
                                           AutomationProperties.LiveSetting="Assertive"
                                           Text="{Binding ReadErrorMessage}" TextWrapping="Wrap"
                                           Visibility="{Binding HasReadError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Margin="0,7,0,0" Padding="12,6" HorizontalAlignment="Left"
                                        AutomationProperties.AutomationId="RecoveryReviewRetryReadButton"
                                        AutomationProperties.Name="Retry the exact failed recovery review read"
                                        Command="{Binding RetryReadCommand}"
                                        Content="Retry review read"
                                        Visibility="{Binding CanRetryRead, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"
                                           AutomationProperties.AutomationId="RecoveryReviewMutationError"
                                           AutomationProperties.Name="{Binding ErrorAnnouncement}"
                                           AutomationProperties.LiveSetting="Assertive"
                                           Text="{Binding MutationErrorMessage}" TextWrapping="Wrap"
                                           Visibility="{Binding HasMutationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button x:Name="RecoveryReviewRetryMutationButton" Margin="0,7,0,0"
                                        Padding="12,6" HorizontalAlignment="Left"
                                        AutomationProperties.AutomationId="RecoveryReviewRetryMutationButton"
                                        AutomationProperties.Name="Retry the exact failed append-only observation request; do not retry operation work"
                                        Command="{Binding RetryMutationCommand}"
                                        Content="Retry same observation request"
                                        Visibility="{Binding CanRetryMutation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Height="1" Opacity="0"
                                           AutomationProperties.AutomationId="RecoveryReviewAnnouncement"
                                           AutomationProperties.Name="{Binding Announcement}"
                                           accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding AnnouncementVersion}"
                                           accessibility:AutomationNotificationBehavior.NotificationKind="ActionCompleted"
                                           accessibility:AutomationNotificationBehavior.NotificationProcessing="MostRecent"
                                           accessibility:AutomationNotificationBehavior.ActivityId="RecoveryReview" />
                                <TextBlock Height="1" Opacity="0"
                                           AutomationProperties.AutomationId="RecoveryReviewErrorAnnouncement"
                                           AutomationProperties.Name="{Binding ErrorAnnouncement}"
                                           accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding ErrorAnnouncementVersion}"
                                           accessibility:AutomationNotificationBehavior.NotificationKind="ActionAborted"
                                           accessibility:AutomationNotificationBehavior.NotificationProcessing="ImportantMostRecent"
                                           accessibility:AutomationNotificationBehavior.ActivityId="RecoveryReviewError" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"
                               AutomationProperties.AutomationId="RecycleOperationError"
                               AutomationProperties.Name="{Binding ErrorAnnouncement}"
                               AutomationProperties.LiveSetting="Assertive"
                               accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding ErrorAnnouncementVersion}"
                               accessibility:AutomationNotificationBehavior.NotificationKind="ActionAborted"
                               accessibility:AutomationNotificationBehavior.NotificationProcessing="ImportantMostRecent"
                               accessibility:AutomationNotificationBehavior.ActivityId="RecycleOperationError"
                               Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                               Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Margin="0,8,0,0" Padding="12,6" HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="RecycleOperationRetryPageButton"
                            AutomationProperties.Name="Retry loading the same Recycle Bin operation details request; this does not retry the operation"
                            Command="{Binding RetryPageCommand}"
                            Content="Retry loading operation details"
                            Visibility="{Binding CanRetryPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Height="1" Opacity="0"
                               AutomationProperties.AutomationId="RecycleOperationAnnouncement"
                               AutomationProperties.Name="{Binding Announcement}"
                               accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding AnnouncementVersion}"
                               accessibility:AutomationNotificationBehavior.NotificationKind="ActionCompleted"
                               accessibility:AutomationNotificationBehavior.NotificationProcessing="MostRecent"
                               accessibility:AutomationNotificationBehavior.ActivityId="RecycleOperation" />
                </StackPanel>
            </Border>

            <TextBlock Margin="0,16,0,0"
                       Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"
                       AutomationProperties.AutomationId="PreflightError"
                       AutomationProperties.Name="{Binding ErrorAnnouncement}"
                       accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding ErrorAnnouncementVersion}"
                       accessibility:AutomationNotificationBehavior.NotificationKind="ActionAborted"
                       accessibility:AutomationNotificationBehavior.NotificationProcessing="ImportantMostRecent"
                       accessibility:AutomationNotificationBehavior.ActivityId="PreflightValidation"
                       Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Height="1" Opacity="0" AutomationProperties.Name="{Binding Announcement}"
                       accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding AnnouncementVersion}"
                       accessibility:AutomationNotificationBehavior.NotificationKind="ActionCompleted"
                       accessibility:AutomationNotificationBehavior.NotificationProcessing="MostRecent"
                       accessibility:AutomationNotificationBehavior.ActivityId="PreflightValidation" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
