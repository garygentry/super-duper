<UserControl x:Class="SuperDuper.Windows.Views.ScanProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:accessibility="clr-namespace:SuperDuper.Windows.Accessibility"
             automation:AutomationProperties.Name="Scan progress">
    <UserControl.Resources>
        <Style x:Key="ProgressCard" TargetType="Border">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
        </Style>
        <Style x:Key="SecondaryProgressText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28" KeyboardNavigation.TabNavigation="Continue">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False"
                      automation:AutomationProperties.AutomationId="ScanProgressScrollViewer">
            <Grid Visibility="{Binding HasRun, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ScanProgressStatusHeading"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Focusable="True"
                                   KeyboardNavigation.IsTabStop="False"
                                   automation:AutomationProperties.AutomationId="ScanProgressStatus"
                                   automation:AutomationProperties.Name="{Binding Status, StringFormat='Scan status: {0}'}"
                                   Text="{Binding Status}" />
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource SecondaryProgressText}"
                                   automation:AutomationProperties.AutomationId="ScanProgressPhase"
                                   automation:AutomationProperties.Name="{Binding Phase, StringFormat='Scan phase: {0}'}"
                                   Text="{Binding Phase}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Padding="14,7"
                            Command="{Binding CancelCommand}"
                            Content="{Binding CancelButtonText}"
                            IsEnabledChanged="OnCancelButtonIsEnabledChanged"
                            automation:AutomationProperties.AccessKey="Alt+C"
                            automation:AutomationProperties.AutomationId="CancelScanButton"
                            automation:AutomationProperties.Name="{Binding CancelAutomationName}" />
                </Grid>

                <ProgressBar Grid.Row="1"
                             Margin="0,18,0,18"
                             Height="6"
                             IsIndeterminate="{Binding IsIndeterminate}"
                             automation:AutomationProperties.AutomationId="ScanProgressBar"
                             automation:AutomationProperties.Name="Scan activity; detailed counts and rates follow" />

                <UniformGrid Grid.Row="2" Columns="4">
                    <Border Style="{StaticResource ProgressCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SecondaryProgressText}" Text="Run elapsed" />
                            <TextBlock Margin="0,4,0,0" FontSize="20" FontWeight="SemiBold"
                                       automation:AutomationProperties.AutomationId="ScanRunElapsed"
                                       Text="{Binding Elapsed}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ProgressCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SecondaryProgressText}" Text="Phase elapsed" />
                            <TextBlock Margin="0,4,0,0" FontSize="20" FontWeight="SemiBold"
                                       automation:AutomationProperties.AutomationId="ScanPhaseElapsed"
                                       Text="{Binding ProgressPhaseElapsed}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ProgressCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SecondaryProgressText}" Text="Warnings" />
                            <TextBlock Margin="0,4,0,0" FontSize="20" FontWeight="SemiBold"
                                       automation:AutomationProperties.AutomationId="ScanWarningCount"
                                       Text="{Binding WarningCount}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ProgressCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SecondaryProgressText}" Text="Excluded locations" />
                            <TextBlock Margin="0,4,0,0" FontSize="20" FontWeight="SemiBold"
                                       automation:AutomationProperties.AutomationId="ScanExcludedLocationCount"
                                       Text="{Binding ExcludedSubtreeCount}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <StackPanel Grid.Row="3" Margin="0,14,0,0">
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="File and logical-byte funnel" />
                    <TextBlock Margin="0,3,0,10" Style="{StaticResource SecondaryProgressText}"
                               Text="Six successive cumulative outcomes; byte totals are logical file sizes." />
                    <TextBlock Margin="0,0,0,10"
                               automation:AutomationProperties.AutomationId="ScanDetailedProgressUnavailable"
                               automation:AutomationProperties.Name="{Binding DetailedProgressUnavailableMessage}"
                               Text="{Binding DetailedProgressUnavailableMessage}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryProgressText}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDetailedProgress}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Stages}"
                                  automation:AutomationProperties.AutomationId="ScanProgressFunnel"
                                  automation:AutomationProperties.Name="Six-stage scan progress funnel">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border MinWidth="220"
                                        Style="{StaticResource ProgressCard}"
                                        automation:AutomationProperties.AutomationId="{Binding AutomationId}"
                                        automation:AutomationProperties.Name="{Binding AutomationName}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SecondaryProgressText}" Text="{Binding Name}" />
                                        <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold"
                                                   Text="{Binding FilesText, StringFormat='{}{0} files'}" />
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource SecondaryProgressText}"
                                                   Text="{Binding BytesText, StringFormat='{}{0} logical'}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,14,0,0">
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="Physical read throughput" />
                    <TextBlock Margin="0,3,0,10" Style="{StaticResource SecondaryProgressText}"
                               Text="Recent and cumulative rates include their measured windows and physical-I/O units." />
                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource ProgressCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SecondaryProgressText}" Text="Partial reads — recent" />
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                           automation:AutomationProperties.AutomationId="ScanPartialRecentRate"
                                           Text="{Binding PartialRecentRate}" />
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource SecondaryProgressText}" Text="Partial reads — cumulative" />
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                           automation:AutomationProperties.AutomationId="ScanPartialCumulativeRate"
                                           Text="{Binding PartialCumulativeRate}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ProgressCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SecondaryProgressText}" Text="Full reads — recent" />
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                           automation:AutomationProperties.AutomationId="ScanFullRecentRate"
                                           Text="{Binding FullRecentRate}" />
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource SecondaryProgressText}" Text="Full reads — cumulative" />
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                           automation:AutomationProperties.AutomationId="ScanFullCumulativeRate"
                                           Text="{Binding FullCumulativeRate}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <StackPanel Grid.Row="5" Margin="0,14,0,0">
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="Work, cache, and estimate" />
                    <UniformGrid Margin="0,10,0,0" Columns="2">
                        <Border Style="{StaticResource ProgressCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SecondaryProgressText}" Text="Cache effectiveness" />
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                           automation:AutomationProperties.AutomationId="ScanCacheEffectiveness"
                                           Text="{Binding CacheEffectiveness}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ProgressCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SecondaryProgressText}" Text="Active devices" />
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                           automation:AutomationProperties.AutomationId="ScanActiveDevices"
                                           Text="{Binding ActiveDevices}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ProgressCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SecondaryProgressText}" Text="Known hash work" />
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                           automation:AutomationProperties.AutomationId="ScanCandidateContext"
                                           automation:AutomationProperties.Name="{Binding HashPipelineCandidateContext, StringFormat='Hash-pipeline candidate denominator: {0}'}"
                                           Text="{Binding HashPipelineCandidateContext}" />
                                <TextBlock Margin="0,3,0,0" TextWrapping="Wrap"
                                           automation:AutomationProperties.AutomationId="ScanRemainingWork"
                                           Text="{Binding RemainingWork}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ProgressCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SecondaryProgressText}" Text="Estimated time remaining" />
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                           automation:AutomationProperties.AutomationId="ScanEstimatedTimeRemaining"
                                           Text="{Binding EstimatedTimeRemaining}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <StackPanel Grid.Row="6" Margin="0,16,0,0">
                    <TextBlock FontWeight="SemiBold" Text="Current activity" />
                    <TextBlock Margin="0,7,0,0" TextWrapping="Wrap"
                               automation:AutomationProperties.AutomationId="ScanCurrentActivity"
                               automation:AutomationProperties.Name="{Binding Message, StringFormat='Current scan activity: {0}'}"
                               Text="{Binding Message}" />
                    <TextBox Margin="0,8,0,0" IsReadOnly="True" TextWrapping="Wrap"
                             Text="{Binding CurrentPath, Mode=OneWay}"
                             automation:AutomationProperties.AutomationId="ScanCurrentPath"
                             automation:AutomationProperties.Name="Current scan path" />
                    <Border Margin="0,14,0,0" Padding="12" BorderThickness="1" CornerRadius="6"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"
                            automation:AutomationProperties.AutomationId="ScanProgressError"
                            automation:AutomationProperties.LiveSetting="Assertive"
                            automation:AutomationProperties.Name="{Binding DisplayErrorMessage, StringFormat='Scan error: {0}'}">
                        <TextBlock Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                                   Text="{Binding DisplayErrorMessage}" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Height="1" Opacity="0" IsHitTestVisible="False"
                               automation:AutomationProperties.AutomationId="ScanProgressAnnouncement"
                               automation:AutomationProperties.LiveSetting="Polite"
                               automation:AutomationProperties.Name="{Binding ProgressAnnouncement}"
                               accessibility:AutomationNotificationBehavior.AnnouncementVersion="{Binding ProgressAnnouncementVersion}"
                               accessibility:AutomationNotificationBehavior.NotificationKind="ActionCompleted"
                               accessibility:AutomationNotificationBehavior.NotificationProcessing="MostRecent"
                               accessibility:AutomationNotificationBehavior.ActivityId="ScanProgress" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    automation:AutomationProperties.AutomationId="ScanProgressEmptyState"
                    automation:AutomationProperties.Name="No scan selected">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasRun}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold" Text="No scan selected" />
            <TextBlock Margin="0,7,0,0"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       Text="Start a scan or select one from Run history." />
        </StackPanel>
    </Grid>
</UserControl>
