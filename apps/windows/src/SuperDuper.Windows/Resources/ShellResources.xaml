<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Thickness x:Key="ShellContentInset">24,16</Thickness>
    <Thickness x:Key="PageContentInset">24</Thickness>
    <Style x:Key="ShellNavigationItem" TargetType="TabItem">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style x:Key="ShellTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ShellBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ShellAction" TargetType="Button">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource ShellBody}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource ShellBody}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Preserve native control templates, focus visuals and selection colors. Text inherits
         the control foreground so selected rows and disabled controls keep native contrast. -->
    <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource ShellAction}" />
    <Style x:Key="SharedField" TargetType="Control">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource SharedField}" />
    <Style TargetType="ComboBox" BasedOn="{StaticResource SharedField}" />
    <Style TargetType="CheckBox" BasedOn="{StaticResource SharedField}" />
    <Style TargetType="Label">
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinRowHeight" Value="36" />
    </Style>
    <Style x:Key="SharedCard" TargetType="Border">
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
    </Style>
    <Style x:Key="ShellPrimaryAction" TargetType="Button" BasedOn="{StaticResource ShellAction}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="16,8" />
    </Style>
    <Style x:Key="ShellStatusBanner" TargetType="Border">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
</ResourceDictionary>
