<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <!-- Keep in step with [workspace.package] version in the root Cargo.toml. -->
    <Version>0.2.0</Version>
    <Product>Super Duper</Product>
    <Company>Gary Gentry</Company>
    <Authors>Gary Gentry</Authors>
    <Copyright>Copyright (c) 2026 Gary Gentry. MIT License.</Copyright>
    <Description>Review-only duplicate file finder for Windows.</Description>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>
</Project>
